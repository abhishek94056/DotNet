@{
    ViewData["Title"] = "Home"; Layout = "_Layout";
}

<!-- Hero Section -->
<div class="min-vh-100 d-flex align-items-center"
     style="background:linear-gradient(135deg,#1e3a5f 0%,#1a56db 100%);margin:-1.5rem -1.5rem 0;padding:1.5rem;">
    <div class="container text-center text-white py-5">
        <div class="mb-4">
            <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-600 mb-3 d-inline-block">
                <i class="bi bi-stars me-1"></i> Powered by OpenAI GPT-4o
            </span>
            <h1 class="display-4 fw-bold mb-3">AI-Powered Resume Screening</h1>
            <p class="lead text-white-75 mb-5 mx-auto" style="max-width:600px;">
                Automate candidate screening, rank applicants by skill match,
                and generate interview questions — all powered by AI.
            </p>
        </div>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Account" asp-action="Register" asp-route-role="Candidate"
                   class="btn btn-light text-primary fw-bold px-4 py-3" style="border-radius:12px;font-size:1.05rem;">
                <i class="bi bi-person-plus me-2"></i>I'm a Candidate
            </a>
            <a asp-controller="Account" asp-action="Register" asp-route-role="Recruiter"
                   class="btn btn-outline-light fw-bold px-4 py-3" style="border-radius:12px;font-size:1.05rem;">
                <i class="bi bi-briefcase me-2"></i>I'm a Recruiter
            </a>
        </div>

        <!-- Feature Cards -->
        <div class="row g-4 mt-5">
            @foreach (var (icon, title, desc) in new[] {
                ("bi-cpu", "AI Resume Parsing", "Extract skills, experience, and education automatically"),
                ("bi-bar-chart-steps", "Smart Ranking", "Rank candidates by AI match score instantly"),
                ("bi-chat-left-quote", "Interview Questions", "Generate tailored questions with GPT-4o"),
                ("bi-bullseye", "Skill Gap Analysis", "Identify missing skills for any candidate")
            })
            {
                <div class="col-6 col-md-3">
                    <div class="card h-100 text-center p-3" style="background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);border-radius:16px;">
                        <i class="bi @icon text-white fs-1 mb-2"></i>
                        <h6 class="text-white fw-600 mb-1">@title</h6>
                        <small class="text-white-50">@desc</small>
                    </div>
                </div>
            }
        </div>
    </div>
</div>