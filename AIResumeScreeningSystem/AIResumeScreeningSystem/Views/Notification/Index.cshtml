@model AIResumeScreeningSystem.ViewModels.Notification.NotificationListViewModel
@using AIResumeScreeningSystem.ViewModels.Notification
@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-0">
            <i class="bi bi-bell me-2 text-primary"></i>Notifications
        </h4>
        <small class="text-muted">
            @Model.UnreadCount unread · @Model.TotalCount total
        </small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" asp-route-unreadOnly="true"
               class="btn btn-sm @(Model.ShowOnlyUnread ? "btn-primary" : "btn-outline-primary")">
            Unread Only
        </a>
        <a asp-action="Index"
               class="btn btn-sm @(!Model.ShowOnlyUnread ? "btn-primary" : "btn-outline-primary")">
            All
        </a>
        @if (Model.UnreadCount > 0)
        {
            <form asp-action="MarkAllRead" method="post">
                <button type="submit" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-check-all me-1"></i>Mark All Read
                </button>
            </form>
        }
    </div>
</div>

@if (!Model.Notifications.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-bell-slash text-muted" style="font-size:3.5rem;"></i>
            <h5 class="text-muted mt-3">
                @(Model.ShowOnlyUnread ? "No unread notifications" : "No notifications yet")
            </h5>
            <p class="text-muted small mb-0">
                You'll see updates about your applications and jobs here.
            </p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            @foreach (var notification in Model.Notifications)
            {
                <div class="d-flex align-items-start gap-3 px-4 py-4 border-bottom
                    @(!notification.IsRead ? "bg-primary bg-opacity-5" : "")"
                     style="transition:background .2s;">

                    <!-- Icon -->
                    <div class="rounded-circle bg-light d-flex align-items-center
                        justify-content-center flex-shrink-0 mt-1"
                         style="width:44px;height:44px;">
                        <i class="bi @notification.TypeIcon fs-5"></i>
                    </div>

                    <!-- Content -->
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between
                            align-items-start flex-wrap gap-1">
                            <div>
                                <span class="fw-600 @(!notification.IsRead ? "text-primary" : "")">
                                    @notification.Title
                                </span>
                                @if (!notification.IsRead)
                                {
                                    <span class="badge bg-primary ms-2"
                                          style="font-size:9px;">NEW</span>
                                }
                            </div>
                            <small class="text-muted flex-shrink-0">
                                @notification.TimeAgo
                            </small>
                        </div>
                        <p class="text-muted small mb-2">@notification.Message</p>
                        <div class="d-flex gap-2 flex-wrap">
                            @if (!string.IsNullOrEmpty(notification.ActionUrl))
                            {
                                <a href="@notification.ActionUrl"
                                       class="btn btn-sm btn-outline-primary py-0 px-2">
                                    <i class="bi bi-arrow-right me-1"></i>View
                                </a>
                            }
                            @if (!notification.IsRead)
                            {
                                <form asp-action="MarkRead"
                                      asp-route-id="@notification.Id"
                                      method="post">
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-secondary py-0 px-2">
                                        <i class="bi bi-check me-1"></i>Mark Read
                                    </button>
                                </form>
                            }
                        </div>
                    </div>

                </div>
            }
        </div>
    </div>
}