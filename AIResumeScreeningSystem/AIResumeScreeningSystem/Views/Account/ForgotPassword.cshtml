@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password"; Layout = "_Layout";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center"
     style="background:linear-gradient(135deg,#1e3a5f 0%,#1a56db 100%);margin-top:-56px;padding-top:56px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-9 col-md-6 col-lg-5">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white mb-3"
                         style="width:64px;height:64px;box-shadow:0 4px 15px rgba(0,0,0,0.2);">
                        <i class="bi bi-key text-primary" style="font-size:2rem;"></i>
                    </div>
                    <h2 class="text-white fw-bold mb-1">Forgot Password?</h2>
                    <p class="text-white-50">Enter your email and we'll send a reset link</p>
                </div>
                <div class="card shadow-lg" style="border-radius:16px;">
                    <div class="card-body p-4 p-md-5">
                        <form asp-action="ForgotPassword" method="post" novalidate>
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>
                            <div class="mb-4">
                                <label asp-for="Email" class="form-label fw-500 text-secondary small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-secondary"></i></span>
                                    <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="you@example.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 py-2 fw-600" style="border-radius:10px;">
                                <i class="bi bi-send me-2"></i>Send Reset Link
                            </button>
                        </form>
                        <div class="text-center mt-3">
                            <a asp-action="Login" class="text-primary small text-decoration-none">
                                <i class="bi bi-arrow-left me-1"></i>Back to Login
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}