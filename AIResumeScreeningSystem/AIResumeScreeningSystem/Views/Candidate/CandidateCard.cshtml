@model AIResumeScreeningSystem.ViewModels.Candidate.CandidateViewModel

<div class="card shadow-sm h-100">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-3">
            @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
            {
                <img src="@Model.ProfileImagePath" class="rounded-circle"
                     style="width:50px;height:50px;object-fit:cover;" />
            }
            else
            {
                <div class="rounded-circle bg-primary text-white d-flex align-items-center
                    justify-content-center fw-bold"
                     style="width:50px;height:50px;">
                    @Model.InitialsAvatar
                </div>
            }
            <div>
                <div class="fw-600">@Model.FullName</div>
                <small class="text-muted">@Model.Headline</small>
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap mb-2">
            @foreach (var skill in Model.Skills.Take(3))
            {
                <span class="badge bg-primary bg-opacity-10 text-primary" style="font-size:10px;">
                    @skill.SkillName
                </span>
            }
        </div>
        <a asp-controller="Candidate" asp-action="Details" asp-route-id="@Model.Id"
           class="btn btn-sm btn-outline-primary w-100 mt-2">View Profile</a>
    </div>
</div>