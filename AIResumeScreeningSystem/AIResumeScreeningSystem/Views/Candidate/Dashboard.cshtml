@model AIResumeScreeningSystem.ViewModels.Candidate.CandidateDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
    ViewData["ActivePage"] = "CandidateDashboard";
}

<!-- Welcome Header -->
<div class="d-flex flex-wrap justify-content-between align-items-start mb-4 gap-3">
    <div class="d-flex align-items-center gap-3">
        @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
        {
            <img src="@Model.ProfileImagePath" class="rounded-circle"
                 style="width:60px;height:60px;object-fit:cover;" alt="Profile" />
        }
        else
        {
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-4"
                 style="width:60px;height:60px;">
                @Model.InitialsAvatar
            </div>
        }
        <div>
            <h4 class="fw-bold mb-0">Welcome back, @Model.FullName.Split(' ')[0]!</h4>
            <p class="text-muted mb-0 small">@(Model.Headline ?? "Complete your profile to get started")</p>
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="EditProfile" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i>Edit Profile
        </a>
        <a asp-controller="Resume" asp-action="Upload" class="btn btn-primary btn-sm">
            <i class="bi bi-cloud-upload me-1"></i>Upload Resume
        </a>
    </div>
</div>

<!-- Profile Completion Banner -->
@if (Model.ProfileCompletionPercent < 100)
{
    <div class="alert border-0 mb-4 py-3"
         style="background:linear-gradient(135deg,#eff6ff,#dbeafe);border-left:4px solid #1a56db !important;">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h6 class="fw-bold mb-1 text-primary">
                    <i class="bi bi-person-check me-2"></i>Profile @Model.ProfileCompletionPercent% Complete
                </h6>
                <small class="text-muted">Complete your profile to improve job matches</small>
            </div>
            <a asp-action="EditProfile" class="btn btn-primary btn-sm px-3">Complete Now</a>
        </div>
        <div class="progress mt-2" style="height:6px;border-radius:3px;">
            <div class="progress-bar bg-primary"
                 style="width:@Model.ProfileCompletionPercent%"
                 role="progressbar"></div>
        </div>
    </div>
}

<!-- Stats Row -->
<div class="row g-3 mb-4">
    @foreach (var (label, count, color, icon, subtitle) in new[] {
        ("Total Applied", Model.TotalApplications.ToString(), "primary", "bi-send", "All time"),
        ("Pending", Model.PendingApplications.ToString(), "warning", "bi-hourglass-split", "Under review"),
        ("Shortlisted", Model.ShortlistedApplications.ToString(), "success", "bi-star", "Great news!"),
        ("My Skills", Model.TotalSkills.ToString(), "info", "bi-tags", "In profile")
    })
    {
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-1">@label</p>
                            <h3 class="fw-bold mb-0 text-@color">@count</h3>
                            <small class="text-muted">@subtitle</small>
                        </div>
                        <div class="rounded-circle d-flex align-items-center justify-content-center bg-@color bg-opacity-10"
                             style="width:46px;height:46px;">
                            <i class="bi @icon text-@color fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-4">
    <!-- Recent Applications -->
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-600"><i class="bi bi-collection me-2 text-primary"></i>Recent Applications</h6>
                <a asp-controller="Application" asp-action="MyApplications"
                   class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.RecentApplications.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-briefcase text-muted" style="font-size:2.5rem;"></i>
                        <p class="text-muted mt-2 mb-3">No applications yet</p>
                        <a asp-controller="Job" asp-action="Browse"
                           class="btn btn-primary btn-sm px-4">Browse Jobs</a>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var app in Model.RecentApplications)
                        {
                            <div class="list-group-item px-4 py-3 border-0 border-bottom">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <a asp-controller="Job" asp-action="Details"
                                               asp-route-id="@app.JobId"
                                               class="fw-600 text-dark text-decoration-none">
                                            @app.JobTitle
                                        </a>
                                        <div class="text-muted small">@app.Company</div>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge @app.StatusBadgeClass mb-1">@app.Status</span>
                                        @if (app.AIMatchScore.HasValue)
                                        {
                                            <div class="small text-muted">
                                                AI Score: <span class="fw-600 text-primary">@app.AIMatchScore.Value.ToString("F0")%</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="text-muted" style="font-size:11px;">
                                    <i class="bi bi-clock me-1"></i>
                                    @app.AppliedAt.ToString("MMM dd, yyyy")
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column -->
    <div class="col-lg-5">

        <!-- AI Match Chart -->
        @if (Model.ChartLabels.Any())
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header py-3">
                    <h6 class="mb-0 fw-600"><i class="bi bi-bar-chart me-2 text-primary"></i>AI Match Scores</h6>
                </div>
                <div class="card-body">
                    <canvas id="matchChart" height="160"></canvas>
                </div>
            </div>
        }

        <!-- Availability Toggle -->
        <div class="card shadow-sm mb-4">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-600 mb-1">Work Availability</h6>
                    <small class="text-muted">
                        Currently: <span class="fw-600 @(Model.IsAvailable ? "text-success" : "text-secondary")">
                        @(Model.IsAvailable ? "Available" : "Not Available")
                    </span>
                </small>
            </div>
            <form asp-action="ToggleAvailability" method="post">
                <button type="submit"
                        class="btn btn-sm @(Model.IsAvailable ? "btn-outline-secondary" : "btn-outline-success")">
                    <i class="bi @(Model.IsAvailable ? "bi-pause-circle" : "bi-play-circle") me-1"></i>
                    @(Model.IsAvailable ? "Set Unavailable" : "Set Available")
                </button>
            </form>
        </div>
    </div>

    <!-- Quick Links -->
    <div class="card shadow-sm mb-4">
        <div class="card-header py-3">
            <h6 class="mb-0 fw-600"><i class="bi bi-lightning me-2 text-warning"></i>Quick Actions</h6>
        </div>
        <div class="list-group list-group-flush">
            <a asp-action="Profile" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
                <i class="bi bi-person-circle text-primary fs-5"></i>
                <div><div class="fw-500">View My Profile</div><small class="text-muted">See how recruiters see you</small></div>
            </a>
            <a asp-controller="Resume" asp-action="Upload" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
                <i class="bi bi-cloud-upload text-success fs-5"></i>
                <div><div class="fw-500">Upload Resume</div><small class="text-muted">Add PDF or DOCX resume</small></div>
            </a>
            <a asp-action="Skills" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
                <i class="bi bi-tags text-info fs-5"></i>
                <div><div class="fw-500">Manage Skills</div><small class="text-muted">@Model.TotalSkills skill(s) in profile</small></div>
            </a>
            <a asp-controller="Job" asp-action="Browse" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
                <i class="bi bi-search text-warning fs-5"></i>
                <div><div class="fw-500">Browse Jobs</div><small class="text-muted">Find your next role</small></div>
            </a>
        </div>
    </div>

</div>
</div>

<!-- Recommended Jobs -->
@if (Model.RecommendedJobs.Any())
{
    <div class="card shadow-sm mt-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-600"><i class="bi bi-stars me-2 text-warning"></i>Recommended Jobs for You</h6>
            <a asp-controller="Job" asp-action="Browse" class="btn btn-sm btn-outline-primary">Browse All</a>
        </div>
        <div class="card-body p-0">
            <div class="row g-0">
                @foreach (var job in Model.RecommendedJobs)
                {
                    <div class="col-md-6 col-lg-4 p-3 border-end border-bottom">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <a asp-controller="Job" asp-action="Details" asp-route-id="@job.JobId"
                                   class="fw-600 text-dark text-decoration-none d-block">@job.Title</a>
                                <small class="text-muted">@job.Company</small>
                            </div>
                            <span class="badge bg-success bg-opacity-15 text-success">@job.MatchPercent% match</span>
                        </div>
                        <small class="text-muted d-block mb-2">
                            <i class="bi bi-geo-alt me-1"></i>@(job.Location ?? "Remote")
                            <span class="ms-2 text-success fw-500">@job.SalaryRange</span>
                        </small>
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            @foreach (var skill in job.MatchingSkills.Take(3))
                            {
                                <span class="badge bg-primary bg-opacity-10 text-primary" style="font-size:10px;">@skill</span>
                            }
                        </div>
                        <a asp-controller="Application" asp-action="Apply" asp-route-jobId="@job.JobId"
                           class="btn btn-sm btn-primary w-100">Apply Now</a>
                    </div>
                }
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (Model.ChartLabels.Any())
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            const ctx = document.getElementById('matchChart').getContext('2d');
            new Chart(ctx, {
            type: 'bar',
            data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels)),
            datasets: [{
            label: 'AI Match %',
            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartScores)),
            backgroundColor: 'rgba(26, 86, 219, 0.15)',
            borderColor: 'rgba(26, 86, 219, 1)',
            borderWidth: 2,
            borderRadius: 6
            }]
            },
            options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
            y: { beginAtZero: true, max: 100,
            ticks: { callback: v => v + '%' },
            grid: { color: '#f3f4f6' }
            },
            x: { grid: { display: false } }
            }
            }
            });
        </script>
    }
}