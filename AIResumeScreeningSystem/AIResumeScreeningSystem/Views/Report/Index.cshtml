@model AIResumeScreeningSystem.ViewModels.Report.ReportListViewModel
@using AIResumeScreeningSystem.ViewModels.Report
@using AIResumeScreeningSystem.Models
@{
    ViewData["Title"] = "Reports";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">
            <i class="bi bi-bar-chart me-2 text-primary"></i>Reports
        </h4>
        <small class="text-muted">
            @Model.TotalCount report(s) · @Model.ExcelCount Excel · @Model.PdfCount PDF
        </small>
    </div>
    <a asp-action="Generate" class="btn btn-primary">
        <i class="bi bi-plus-lg me-2"></i>Generate New Report
    </a>
</div>

<!-- Quick Generate Cards -->
<div class="row g-3 mb-4">
    @foreach (var (title, desc, icon, color, reportType) in new[] {
        ("Candidate Report",  "All candidate profiles, skills & applications",
         "bi-person-badge",    "primary",   "0"),
        ("Job Report",        "All jobs with application counts and stats",
         "bi-briefcase",       "success",   "1"),
        ("AI Ranking Report", "Candidates ranked by AI match score",
         "bi-bar-chart-steps", "warning",   "2")
    })
    {
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-@color border-opacity-25
                report-quick-card" style="cursor:pointer;"
                 onclick="quickGenerate(@reportType)">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <div class="rounded-circle bg-@color bg-opacity-10 d-flex
                            align-items-center justify-content-center"
                             style="width:48px;height:48px;">
                            <i class="bi @icon text-@color fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0">@title</h6>
                            <small class="text-muted">@desc</small>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-action="Generate"
                               class="btn btn-sm btn-outline-success flex-grow-1">
                            <i class="bi bi-file-earmark-excel me-1"></i>Excel
                        </a>
                        <a asp-action="Generate"
                               class="btn btn-sm btn-outline-danger flex-grow-1">
                            <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Reports Table -->
@if (!Model.Reports.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-file-earmark-bar-graph text-muted"
               style="font-size:3.5rem;"></i>
            <h5 class="text-muted mt-3">No reports generated yet</h5>
            <p class="text-muted small mb-4">
                Generate your first report to export data as Excel or PDF.
            </p>
            <a asp-action="Generate" class="btn btn-primary px-4">
                <i class="bi bi-plus-lg me-2"></i>Generate Report
            </a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-header py-3">
            <h6 class="mb-0 fw-600">
                <i class="bi bi-clock-history me-2 text-primary"></i>Generated Reports
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Report</th>
                            <th>Type</th>
                            <th>Format</th>
                            <th>Generated By</th>
                            <th>Generated At</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in Model.Reports)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi @report.FormatIcon fs-4"></i>
                                        <div>
                                            <div class="fw-500 small">@report.Name</div>
                                            @if (!string.IsNullOrEmpty(report.JobTitle))
                                            {
                                                <small class="text-muted">
                                                    Job: @report.JobTitle
                                                </small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @report.TypeBadgeClass">
                                        @report.ReportTypeDisplay
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(report.Format == ReportFormat.Excel
                                                                                                                          ? "bg-success bg-opacity-10 text-success"
                                                                                                                          : "bg-danger bg-opacity-10 text-danger")">
                                        @report.FormatDisplay
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted">@report.GeneratedByName</small>
                                </td>
                                <td>
                                    <small class="text-muted">
                                        @report.GeneratedAt.ToString("MMM dd, yyyy HH:mm")
                                    </small>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-2">
                                        @if (!string.IsNullOrEmpty(report.FilePath))
                                        {
                                            <a asp-action="Download"
                                                   asp-route-id="@report.Id"
                                                   class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-download me-1"></i>Download
                                            </a>
                                        }
                                        <form asp-action="Delete"
                                              asp-route-id="@report.Id"
                                              method="post"
                                              onsubmit="return confirm('Delete this report?')">
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function quickGenerate(type) {
            window.location.href = '/Report/Generate?reportType=' + type;
        }
    </script>
}