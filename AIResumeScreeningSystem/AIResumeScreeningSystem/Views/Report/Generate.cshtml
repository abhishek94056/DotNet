@model AIResumeScreeningSystem.ViewModels.Report.GenerateReportViewModel
@{
    ViewData["Title"] = "Generate Report";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h4 class="fw-bold mb-0">Generate Report</h4>
        <small class="text-muted">Export data as Excel or PDF</small>
    </div>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-lg-7">
        <form asp-action="Generate" method="post" novalidate>

            <!-- Report Type & Format -->
            <div class="card shadow-sm mb-4">
                <div class="card-header py-3">
                    <h6 class="mb-0 fw-600">
                        <i class="bi bi-sliders me-2 text-primary"></i>
                        Report Configuration
                    </h6>
                </div>
                <div class="card-body">

                    <!-- Report Type Cards -->
                    <div class="mb-4">
                        <label class="form-label fw-600">Report Type</label>
                        <div class="row g-2">
                            @foreach (var opt in Model.ReportTypeOptions)
                            {
                                <div class="col-md-4">
                                    <input type="radio" class="btn-check"
                                           asp-for="ReportType"
                                           value="@opt.Value"
                                           id="rt_@opt.Value" />
                                    <label class="btn btn-outline-primary w-100 py-3
                                        d-flex flex-column align-items-center"
                                           for="rt_@opt.Value">
                                        <i class="bi @(opt.Value == "0" ? "bi-person-badge" :
                                                                                                                                           opt.Value == "1" ? "bi-briefcase" :
                                                                                                                                           "bi-bar-chart-steps") fs-4 mb-1"></i>
                                        <span class="small fw-600">@opt.Text</span>
                                    </label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="ReportType" class="text-danger small"></span>
                    </div>

                    <!-- Format Cards -->
                    <div>
                        <label class="form-label fw-600">Export Format</label>
                        <div class="row g-2">
                            @foreach (var opt in Model.FormatOptions)
                            {
                                var isExcel = opt.Value == "0";
                                <div class="col-6">
                                    <input type="radio" class="btn-check"
                                           asp-for="Format"
                                           value="@opt.Value"
                                           id="fmt_@opt.Value" />
                                    <label class="btn @(isExcel ? "btn-outline-success" : "btn-outline-danger")
                                        w-100 py-3 d-flex align-items-center
                                        justify-content-center gap-2"
                                           for="fmt_@opt.Value">
                                        <i class="bi @(isExcel ? "bi-file-earmark-excel" : "bi-file-earmark-pdf") fs-4"></i>
                                        <div>
                                            <div class="fw-600">@opt.Text</div>
                                            <small class="text-muted">
                                                @(isExcel ? "Editable spreadsheet" : "Print-ready document")
                                            </small>
                                        </div>
                                    </label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Format" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Filters -->
            <div class="card shadow-sm mb-4">
                <div class="card-header py-3">
                    <h6 class="mb-0 fw-600">
                        <i class="bi bi-funnel me-2 text-primary"></i>Filters
                        <small class="text-muted fw-normal">(optional)</small>
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">

                        <!-- Date Range -->
                        <div class="col-md-6">
                            <label asp-for="DateFrom" class="form-label small fw-500">
                            </label>
                            <input asp-for="DateFrom" class="form-control"
                                   type="date" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DateTo" class="form-label small fw-500">
                            </label>
                            <input asp-for="DateTo" class="form-control"
                                   type="date" />
                        </div>

                        <!-- Job Filter -->
                        <div class="col-12">
                            <label asp-for="JobId" class="form-label small fw-500">
                            </label>
                            <select asp-for="JobId" class="form-select">
                                <option value="">All Jobs</option>
                                @foreach (var job in Model.AvailableJobs)
                                {
                                    <option value="@job.Value">@job.Text</option>
                                }
                            </select>
                        </div>

                        <!-- Min Score Filter -->
                        <div class="col-md-6">
                            <label asp-for="MinScoreFilter"
                                   class="form-label small fw-500"></label>
                            <div class="input-group">
                                <input asp-for="MinScoreFilter"
                                       class="form-control"
                                       type="number" min="0" max="100"
                                       placeholder="e.g. 60" />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>

                        <!-- Checkboxes -->
                        <div class="col-md-6 d-flex flex-column justify-content-end">
                            <div class="form-check mb-2">
                                <input asp-for="IncludeAIScores"
                                       class="form-check-input" />
                                <label asp-for="IncludeAIScores"
                                       class="form-check-label small">
                                </label>
                            </div>
                            <div class="form-check">
                                <input asp-for="IncludeSkillAnalysis"
                                       class="form-check-input" />
                                <label asp-for="IncludeSkillAnalysis"
                                       class="form-check-label small">
                                </label>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Submit -->
            <div class="d-flex gap-3">
                <button type="submit"
                        class="btn btn-primary flex-grow-1 py-2 fw-600"
                        id="generateBtn">
                    <i class="bi bi-cpu me-2"></i>Generate Report
                </button>
                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">Cancel</a>
            </div>

        </form>
    </div>

    <!-- Info Sidebar -->
    <div class="col-lg-4">
        <div class="card shadow-sm mb-4"
             style="background:linear-gradient(135deg,#eff6ff,#dbeafe);border:none;">
            <div class="card-body">
                <h6 class="fw-600 text-primary mb-3">
                    <i class="bi bi-info-circle me-2"></i>Report Contents
                </h6>
                <div id="reportInfo">
                    <div class="report-info" data-type="0">
                        <p class="text-muted small mb-2">
                            <strong>Candidate Report</strong> includes:
                        </p>
                        <ul class="text-muted small mb-0 ps-3">
                            <li>Full name, email, phone, location</li>
                            <li>Experience & education level</li>
                            <li>Total skills & applications</li>
                            <li>Shortlisted count</li>
                            <li>Summary statistics sheet</li>
                        </ul>
                    </div>
                    <div class="report-info d-none" data-type="1">
                        <p class="text-muted small mb-2">
                            <strong>Job Report</strong> includes:
                        </p>
                        <ul class="text-muted small mb-0 ps-3">
                            <li>Job title, company, type & status</li>
                            <li>Salary range</li>
                            <li>Total applications & shortlisted</li>
                            <li>Average AI match score</li>
                            <li>Posted & expiry dates</li>
                        </ul>
                    </div>
                    <div class="report-info d-none" data-type="2">
                        <p class="text-muted small mb-2">
                            <strong>AI Ranking Report</strong> includes:
                        </p>
                        <ul class="text-muted small mb-0 ps-3">
                            <li>Candidates ranked by AI score</li>
                            <li>Skill match percentage</li>
                            <li>Missing required skills</li>
                            <li>Application status</li>
                            <li>Colour-coded score bands</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="fw-600 mb-3">
                    <i class="bi bi-question-circle me-2 text-primary"></i>Format Guide
                </h6>
                <div class="d-flex align-items-start gap-2 mb-3">
                    <i class="bi bi-file-earmark-excel text-success fs-4 flex-shrink-0"></i>
                    <div>
                        <div class="fw-500 small">Excel (.xlsx)</div>
                        <small class="text-muted">
                            Editable, filterable, sortable. Best for data analysis.
                        </small>
                    </div>
                </div>
                <div class="d-flex align-items-start gap-2">
                    <i class="bi bi-file-earmark-pdf text-danger fs-4 flex-shrink-0"></i>
                    <div>
                        <div class="fw-500 small">PDF (.pdf)</div>
                        <small class="text-muted">
                            Print-ready, professional layout.
                            Best for sharing & archiving.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Dynamic report info
        document.querySelectorAll('input[name="ReportType"]').forEach(radio => {
            radio.addEventListener('change', () => {
                document.querySelectorAll('.report-info').forEach(el => {
                    el.classList.add('d-none');
                });
                const target = document.querySelector(
                    `.report-info[data-type="${radio.value}"]`);
                if (target) target.classList.remove('d-none');
            });
        });

        // Loading state on submit
        document.querySelector('form')?.addEventListener('submit', () => {
            const btn = document.getElementById('generateBtn');
            btn.disabled = true;
            btn.innerHTML =
                '<span class="spinner-border spinner-border-sm me-2"></span>Generating...';
        });
    </script>
}