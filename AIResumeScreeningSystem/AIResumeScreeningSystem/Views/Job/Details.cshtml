@model AIResumeScreeningSystem.ViewModels.Job.JobViewModel
@{
    ViewData["Title"] = Model.Title;
    bool alreadyApplied = ViewBag.AlreadyApplied ?? false;
}

<div class="d-flex align-items-center mb-4 gap-2">
    @if (User.IsInRole("Candidate"))
    {
        <a asp-action="Browse" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
    }
    else
    {
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
    }
    <div class="flex-grow-1">
        <h4 class="fw-bold mb-0">@Model.Title</h4>
        <small class="text-muted">@Model.Company @(!string.IsNullOrEmpty(Model.Location) ? "· " + Model.Location : "")</small>
    </div>
    @if (User.IsInRole("Recruiter") || User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm px-3">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
    }
</div>

<div class="row g-4">
    <!-- LEFT -->
    <div class="col-lg-8">

        <!-- Header Card -->
        <div class="card shadow-sm mb-4" style="border-left:4px solid #1a56db;">
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge @Model.StatusBadgeClass fs-6 px-3 py-2">@Model.StatusDisplay</span>
                    <span class="badge bg-info bg-opacity-15 text-info fs-6 px-3 py-2">@Model.JobTypeDisplay</span>
                    @if (!string.IsNullOrEmpty(Model.Department))
                    {
                        <span class="badge bg-secondary bg-opacity-15 text-secondary fs-6 px-3 py-2">@Model.Department</span>
                    }
                </div>
                <div class="row g-3">
                    <div class="col-auto">
                        <small class="text-muted d-block">Salary</small>
                        <span class="fw-600 text-success">@Model.SalaryRange</span>
                    </div>
                    <div class="col-auto">
                        <small class="text-muted d-block">Experience</small>
                        <span class="fw-600">@Model.ExperienceRange</span>
                    </div>
                    <div class="col-auto">
                        <small class="text-muted d-block">Location</small>
                        <span class="fw-600"><i class="bi bi-geo-alt me-1 text-muted"></i>@(Model.Location ?? "Remote")</span>
                    </div>
                    <div class="col-auto">
                        <small class="text-muted d-block">Posted</small>
                        <span class="fw-600">@Model.PostedDate.ToString("MMM dd, yyyy")</span>
                    </div>
                    @if (Model.ExpiryDate.HasValue)
                    {
                        <div class="col-auto">
                            <small class="text-muted d-block">Deadline</small>
                            <span class="fw-600 @(Model.IsExpired ? "text-danger" : "text-warning")">
                                @Model.ExpiryDate.Value.ToString("MMM dd, yyyy")
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Description -->
        <div class="card shadow-sm mb-4">
            <div class="card-header py-3">
                <h6 class="mb-0"><i class="bi bi-file-text me-2 text-primary"></i>Job Description</h6>
            </div>
            <div class="card-body" style="white-space:pre-line;">@Model.Description</div>
        </div>

        <!-- Requirements -->
        <div class="card shadow-sm mb-4">
            <div class="card-header py-3">
                <h6 class="mb-0"><i class="bi bi-list-check me-2 text-primary"></i>Requirements</h6>
            </div>
            <div class="card-body" style="white-space:pre-line;">@Model.Requirements</div>
        </div>

    </div>

    <!-- RIGHT -->
    <div class="col-lg-4">

        <!-- Apply Card -->
        @if (User.IsInRole("Candidate"))
        {
            <div class="card shadow-sm mb-4 text-center">
                <div class="card-body py-4">
                    @if (alreadyApplied)
                    {
                        <div class="mb-3">
                            <i class="bi bi-check-circle-fill text-success" style="font-size:2.5rem;"></i>
                        </div>
                        <h6 class="fw-600 text-success mb-1">Already Applied!</h6>
                        <p class="text-muted small">You've submitted your application for this job.</p>
                        <a asp-controller="Application" asp-action="MyApplications" class="btn btn-outline-primary btn-sm">
                            View My Applications
                        </a>
                    }
                    else if (Model.Status == AIResumeScreeningSystem.Models.JobStatus.Active && !Model.IsExpired)
                    {
                        <h6 class="fw-600 mb-2">Interested in this role?</h6>
                        <p class="text-muted small mb-3">Apply now with your latest resume</p>
                        <a asp-controller="Application" asp-action="Apply" asp-route-jobId="@Model.Id"
                               class="btn btn-primary w-100 py-2 fw-600">
                            <i class="bi bi-send me-2"></i>Apply Now
                        </a>
                    }
                    else
                    {
                        <div class="text-muted">
                            <i class="bi bi-x-circle fs-2"></i>
                            <p class="mt-2 mb-0 small">Applications are closed for this job.</p>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Stats (Recruiter/Admin) -->
        @if (User.IsInRole("Recruiter") || User.IsInRole("Admin"))
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header py-3">
                    <h6 class="mb-0"><i class="bi bi-bar-chart me-2 text-primary"></i>Job Stats</h6>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Total Applications</span>
                        <span class="fw-600 text-primary">@Model.TotalApplications</span>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted small">Posted By</span>
                        <span class="fw-600 small">@Model.PostedByName</span>
                    </div>
                </div>
                <div class="card-footer bg-transparent">
                    <a asp-controller="Application" asp-action="Index" asp-route-jobId="@Model.Id"
                           class="btn btn-primary btn-sm w-100">
                        <i class="bi bi-people me-1"></i>View Applications
                    </a>
                </div>
            </div>
        }

        <!-- Required Skills -->
        @if (Model.RequiredSkills.Any())
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header py-3">
                    <h6 class="mb-0"><i class="bi bi-check-circle me-2 text-success"></i>Required Skills</h6>
                </div>
                <div class="card-body d-flex flex-wrap gap-2">
                    @foreach (var skill in Model.RequiredSkills)
                    {
                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2">@skill</span>
                    }
                </div>
            </div>
        }

        <!-- Optional Skills -->
        @if (Model.OptionalSkills.Any())
        {
            <div class="card shadow-sm">
                <div class="card-header py-3">
                    <h6 class="mb-0"><i class="bi bi-plus-circle me-2 text-primary"></i>Nice-to-have Skills</h6>
                </div>
                <div class="card-body d-flex flex-wrap gap-2">
                    @foreach (var skill in Model.OptionalSkills)
                    {
                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2">@skill</span>
                    }
                </div>
            </div>
        }

    </div>
</div>