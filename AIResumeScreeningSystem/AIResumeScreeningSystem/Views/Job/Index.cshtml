@model AIResumeScreeningSystem.ViewModels.Job.JobListViewModel
@{
    ViewData["Title"] = "Manage Jobs";
    ViewData["ActivePage"] = "MyJobs";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1"><i class="bi bi-briefcase me-2 text-primary"></i>Job Postings</h4>
        <p class="text-muted mb-0 small">@Model.TotalCount job(s) found</p>
    </div>
    <a asp-action="Create" class="btn btn-primary px-4" style="border-radius:10px;">
        <i class="bi bi-plus-lg me-2"></i>Post New Job
    </a>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-4">
    @foreach (var (label, count, color, icon) in new[] {
        ("Active", Model.ActiveJobsCount, "success", "bi-check-circle"),
        ("Draft", Model.DraftJobsCount, "secondary", "bi-pencil-square"),
        ("Closed", Model.ClosedJobsCount, "danger", "bi-x-circle"),
        ("Applications", Model.TotalApplicationsCount, "primary", "bi-people")
    })
    {
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="text-muted small mb-1">@label</p>
                            <h3 class="fw-bold mb-0 text-@color">@count</h3>
                        </div>
                        <div class="rounded-circle d-flex align-items-center justify-content-center bg-@color bg-opacity-10"
                             style="width:46px;height:46px;">
                            <i class="bi @icon text-@color fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Search / Filter -->
<div class="card mb-4 shadow-sm">
    <div class="card-body py-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <input asp-for="Search.Keyword" class="form-control form-control-sm"
                       placeholder="🔍 Search title, company, description..." />
            </div>
            <div class="col-6 col-md-2">
                <select asp-for="Search.Status" class="form-select form-select-sm">
                    <option value="">All Status</option>
                    @foreach (var s in Enum.GetValues<AIResumeScreeningSystem.Models.JobStatus>())
                    {
                        <option value="@((int)s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select asp-for="Search.JobType" class="form-select form-select-sm">
                    <option value="">All Types</option>
                    @foreach (var jt in Enum.GetValues<AIResumeScreeningSystem.Models.JobType>())
                    {
                        <option value="@((int)jt)">@jt</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select asp-for="Search.SortBy" class="form-select form-select-sm">
                    <option value="PostedDate">Sort: Date</option>
                    <option value="Title">Sort: Title</option>
                    <option value="Applications">Sort: Applications</option>
                </select>
            </div>
            <div class="col-6 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Jobs Table -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Jobs.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-briefcase text-muted" style="font-size:3.5rem;"></i>
                <h5 class="text-muted mt-3">No jobs found</h5>
                <p class="text-muted small">Try adjusting your filters or post a new job.</p>
                <a asp-action="Create" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-lg me-1"></i>Post a Job
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Job Title</th>
                            <th>Type</th>
                            <th>Location</th>
                            <th>Skills</th>
                            <th class="text-center">Applications</th>
                            <th class="text-center">Status</th>
                            <th>Posted</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model.Jobs)
                        {
                            <tr>
                                <td>
                                    <div class="fw-600 text-dark">@job.Title</div>
                                    <small class="text-muted">@job.Company</small>
                                    @if (!string.IsNullOrEmpty(job.Department))
                                    {
                                        <br />
                                    
                                        <span class="badge bg-light text-secondary" style="font-size:11px;">@job.Department</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info bg-opacity-15 text-info">@job.JobTypeDisplay</span>
                                </td>
                                <td>
                                    <small class="text-muted">
                                        <i class="bi bi-geo-alt me-1"></i>@(job.Location ?? "Remote")
                                    </small>
                                </td>
                                <td>
                                    @foreach (var skill in job.RequiredSkills.Take(3))
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary me-1 mb-1" style="font-size:11px;">@skill</span>
                                    }
                                    @if (job.RequiredSkills.Count > 3)
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary" style="font-size:11px;">+@(job.RequiredSkills.Count - 3)</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-controller="Application" asp-action="Index" asp-route-jobId="@job.Id"
                                           class="text-decoration-none">
                                        <span class="fw-600 text-primary">@job.TotalApplications</span>
                                    </a>
                                </td>
                                <td class="text-center">
                                    <span class="badge @job.StatusBadgeClass">@job.StatusDisplay</span>
                                    @if (job.IsExpired)
                                    {
                                        <br />
                                    
                                        <span class="badge bg-warning text-dark mt-1" style="font-size:10px;">Expired</span>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted">@job.PostedDate.ToString("MMM dd, yyyy")</small>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Details" asp-route-id="@job.Id"
                                               class="btn btn-sm btn-outline-secondary" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@job.Id"
                                               class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@job.Id"
                                              method="post" class="d-inline">
                                            <button type="submit"
                                                    class="btn btn-sm @(job.Status == AIResumeScreeningSystem.Models.JobStatus.Active ? "btn-outline-warning" : "btn-outline-success")"
                                                    title="@(job.Status == AIResumeScreeningSystem.Models.JobStatus.Active ? "Close" : "Activate")">
                                                <i class="bi @(job.Status == AIResumeScreeningSystem.Models.JobStatus.Active ? "bi-pause-circle" : "bi-play-circle")"></i>
                                            </button>
                                        </form>
                                        <a asp-action="Delete" asp-route-id="@job.Id"
                                               class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center px-3 py-3 border-top">
                    <small class="text-muted">
                        Showing @((Model.CurrentPage - 1) * Model.PageSize + 1)–@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount))
                        of @Model.TotalCount
                    </small>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-Search.Page="@(Model.CurrentPage - 1)"
                                   asp-route-Search.Keyword="@Model.Search.Keyword">«</a>
                            </li>
                            @for (var i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-Search.Page="@i"
                                       asp-route-Search.Keyword="@Model.Search.Keyword">@i</a>
                                </li>
                            }
                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-Search.Page="@(Model.CurrentPage + 1)"
                                   asp-route-Search.Keyword="@Model.Search.Keyword">»</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>