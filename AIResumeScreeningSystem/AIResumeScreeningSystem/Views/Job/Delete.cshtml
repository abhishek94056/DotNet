@model AIResumeScreeningSystem.ViewModels.Job.JobViewModel
@{
    ViewData["Title"] = "Delete Job";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm text-center">
            <div class="card-body py-5">
                <i class="bi bi-trash text-danger" style="font-size:3.5rem;"></i>
                <h4 class="fw-bold mt-3 mb-2">Delete Job Posting?</h4>
                <p class="text-muted mb-1">You're about to permanently delete:</p>
                <h5 class="text-dark fw-600">@Model.Title</h5>
                <p class="text-muted small">@Model.Company · @Model.TotalApplications application(s)</p>

                <div class="alert alert-warning text-start mt-3">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>Warning:</strong> This will also delete all associated applications and data. This action cannot be undone.
                </div>

                <div class="d-flex gap-3 justify-content-center mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-x me-1"></i>Cancel
                    </a>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash me-1"></i>Yes, Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>