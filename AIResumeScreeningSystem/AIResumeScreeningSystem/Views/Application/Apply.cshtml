@{
    ViewData["Title"] = "Apply for Job";
    var job = ViewBag.Job as AIResumeScreeningSystem.Models.Job;
    var resumes = ViewBag.Resumes as List<AIResumeScreeningSystem.ViewModels.Resume.ResumeViewModel>
                  ?? new List<AIResumeScreeningSystem.ViewModels.Resume.ResumeViewModel>();
    int? activeResumeId = ViewBag.ActiveResumeId;
    decimal quickScore = ViewBag.QuickMatchScore ?? 0m;
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-controller="Job" asp-action="Details" asp-route-id="@job?.Id"
           class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h4 class="fw-bold mb-0">Apply — @job?.Title</h4>
        <small class="text-muted">@job?.Company</small>
    </div>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-lg-7">

        <!-- AI Pre-Match Card -->
        <div class="card shadow-sm mb-4"
             style="background:linear-gradient(135deg,#eff6ff,#dbeafe);border:none;">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <h6 class="fw-bold mb-1 text-primary">
                            <i class="bi bi-cpu me-2"></i>Your AI Match Score
                        </h6>
                        <p class="text-muted small mb-0">
                            Based on your current skills and profile
                        </p>
                    </div>
                    <div class="text-center">
                        <div class="fw-bold text-primary"
                             style="font-size:2.5rem;line-height:1;">
                            @quickScore.ToString("F0")%
                        </div>
                        <small class="text-muted">
                            @(quickScore >= 75 ? "Strong Match 🎯" :
                              quickScore >= 50 ? "Good Match 👍" :
                              quickScore >= 30 ? "Fair Match 📊" : "Weak Match ⚠️")
                        </small>
                    </div>
                </div>
                <div class="progress mt-3" style="height:8px;border-radius:4px;">
                    <div class="progress-bar bg-primary"
                         style="width:@quickScore%;transition:width 1s;"></div>
                </div>
            </div>
        </div>

        <!-- Application Form -->
        <div class="card shadow-sm">
            <div class="card-header py-3">
                <h6 class="mb-0 fw-600">
                    <i class="bi bi-send me-2 text-primary"></i>Submit Application
                </h6>
            </div>
            <div class="card-body">

                @if (!resumes.Any())
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>No resume uploaded.</strong>
                        You must upload a resume before applying.
                        <a asp-controller="Resume" asp-action="Upload"
                               class="btn btn-warning btn-sm ms-3">
                            <i class="bi bi-cloud-upload me-1"></i>Upload Resume
                        </a>
                    </div>
                }
                else
                {
                    <form asp-action="Apply" method="post">
                        <input type="hidden" name="jobId" value="@job?.Id" />

                        <div class="mb-4">
                            <label class="form-label fw-600">Select Resume</label>
                            <div class="row g-2">
                                @foreach (var resume in resumes)
                                {
                                    <div class="col-12">
                                        <label class="border rounded-3 p-3 d-flex align-items-center
                                            gap-3 cursor-pointer w-100 @(resume.IsActive ? "border-primary bg-primary bg-opacity-5" : "")"
                                               style="cursor:pointer;">
                                            <input type="radio" name="resumeId"
                                                   value="@resume.Id"
                                                   class="form-check-input mt-0 flex-shrink-0"
                                            @(resume.IsActive || resume.Id == activeResumeId ? "checked" : "") />
                                            <i class="bi @resume.FileIconClass fs-4 flex-shrink-0"></i>
                                            <div class="flex-grow-1">
                                                <div class="fw-500 small">@resume.FileName</div>
                                                <div class="d-flex gap-2 mt-1">
                                                    <span class="badge @resume.StatusBadgeClass"
                                                          style="font-size:10px;">
                                                        @resume.StatusDisplay
                                                    </span>
                                                    <small class="text-muted">
                                                        @resume.FileSizeDisplay
                                                    </small>
                                                    @if (resume.ParsedSkillsList.Any())
                                                    {
                                                        <small class="text-success">
                                                            @resume.ParsedSkillsList.Count skills extracted
                                                        </small>
                                                    }
                                                    @if (resume.IsActive)
                                                    {
                                                        <span class="badge bg-primary bg-opacity-10 text-primary"
                                                              style="font-size:10px;">Active</span>
                                                    }
                                                </div>
                                            </div>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="alert border-0 bg-light mb-4">
                            <small class="text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                By submitting, our AI will calculate your exact match score and
                                rank your application against other candidates.
                            </small>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary flex-grow-1 py-2 fw-600">
                                <i class="bi bi-send me-2"></i>Submit Application
                            </button>
                            <a asp-controller="Job" asp-action="Details"
                                   asp-route-id="@job?.Id"
                                   class="btn btn-outline-secondary px-4">
                                Cancel
                            </a>
                        </div>
                    </form>
                }
            </div>
        </div>

    </div>

    <!-- Job Summary Sidebar -->
    <div class="col-lg-4">
        <div class="card shadow-sm sticky-top" style="top:70px;">
            <div class="card-header py-3">
                <h6 class="mb-0 fw-600">
                    <i class="bi bi-briefcase me-2 text-primary"></i>Job Summary
                </h6>
            </div>
            <div class="card-body">
                @if (job != null)
                {
                    <h6 class="fw-bold">@job.Title</h6>
                    <p class="text-muted small mb-3">@job.Company</p>

                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge bg-info bg-opacity-10 text-info">@job.JobType</span>
                        @if (!string.IsNullOrEmpty(job.Location))
                        {
                            <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                <i class="bi bi-geo-alt me-1"></i>@job.Location
                            </span>
                        }
                    </div>

                    @if (job.JobSkills.Any())
                    {
                        <div class="mb-3">
                            <small class="fw-600 text-muted d-block mb-2">Required Skills</small>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var skill in job.JobSkills.Where(js => js.IsRequired).Take(8))
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary"
                                          style="font-size:10px;">
                                        @skill.Skill.Name
                                    </span>
                                }
                            </div>
                        </div>
                    }

                    @if (job.ExpiryDate.HasValue)
                    {
                        <div class="alert alert-warning py-2 mb-0">
                            <small>
                                <i class="bi bi-clock me-1"></i>
                                Deadline: @job.ExpiryDate.Value.ToString("MMM dd, yyyy")
                            </small>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>