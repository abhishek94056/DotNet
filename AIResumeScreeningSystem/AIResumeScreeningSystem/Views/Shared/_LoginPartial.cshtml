@using Microsoft.AspNetCore.Identity
@using AIResumeScreeningSystem.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var role = (await UserManager.GetRolesAsync(user!)).FirstOrDefault() ?? "";
    var dashboardUrl = role switch
    {
        "Admin" => "/Admin/Dashboard",
        "Recruiter" => "/Recruiter/Dashboard",
        "Candidate" => "/Candidate/Dashboard",
        _ => "/"
    };

    <div class="d-flex align-items-center gap-2">
        <a href="@dashboardUrl" class="text-white text-decoration-none d-flex align-items-center gap-2">
            <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center"
                 style="width:34px;height:34px;font-weight:700;font-size:14px;">
                @user!.FirstName[0]@user.LastName[0]
            </div>
            <span class="d-none d-md-inline">@user.FirstName @user.LastName</span>
        </a>
        <span class="badge bg-light text-primary">@role</span>
        <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
            <button type="submit" class="btn btn-sm btn-outline-light ms-1">
                <i class="bi bi-box-arrow-right"></i> Logout
            </button>
        </form>
    </div>
}
else
{
    <div class="d-flex gap-2">
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-sm">Login</a>
        <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-sm text-primary fw-bold">Register</a>
    </div>
}