@{
    ViewData["Title"] = "Error"; Layout = "_Layout";
}

<div class="text-center py-5">
    <i class="bi bi-exclamation-triangle text-warning" style="font-size:5rem;"></i>
    <h1 class="display-4 fw-bold mt-3">Oops!</h1>
    <h4 class="text-secondary mb-3">Something went wrong.</h4>
    <p class="text-muted">Request ID: <code>@ViewData["RequestId"]</code></p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2" style="border-radius:10px;">
        <i class="bi bi-house me-2"></i>Go Home
    </a>
</div>