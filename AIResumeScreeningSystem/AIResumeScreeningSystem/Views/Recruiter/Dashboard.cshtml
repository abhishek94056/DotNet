@model RecruiterDashboardViewModel
@using AIResumeScreeningSystem.ViewModels.Dashboard
@{
    ViewData["Title"] = "Recruiter Dashboard";
    ViewData["ActivePage"] = "RecruiterDashboard";
}

<!-- Welcome Header -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-3">
        <div class="rounded-circle bg-primary text-white d-flex align-items-center
            justify-content-center fw-bold"
             style="width:52px;height:52px;font-size:1.2rem;">
            @Model.InitialsAvatar
        </div>
        <div>
            <h4 class="fw-bold mb-0">Welcome, @Model.RecruiterName.Split(' ')[0]!</h4>
            <small class="text-muted">@DateTime.UtcNow.ToString("dddd, MMMM dd yyyy")</small>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Job" asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Post a Job
        </a>
        <a asp-controller="AI" asp-action="Chatbot" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-robot me-1"></i>AI Assistant
        </a>
    </div>
</div>

<!-- ── KPI Cards ─────────────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    @foreach (var (label, value, icon, color, sub) in new[] {
        ("My Jobs",       Model.TotalJobs.ToString(),        "bi-briefcase",       "primary",   $"{Model.ActiveJobs} active"),
        ("Applications",  Model.TotalApplications.ToString(),"bi-send",            "info",      $"{Model.PendingReview} pending"),
        ("Shortlisted",   Model.Shortlisted.ToString(),      "bi-star",            "warning",   "candidates"),
        ("Approved",      Model.Approved.ToString(),         "bi-check-circle",    "success",   "hired"),
        ("Rejected",      Model.Rejected.ToString(),         "bi-x-circle",        "danger",    "not suitable"),
        ("Avg AI Score",  Model.AverageMatchScore + "%",     "bi-bar-chart-steps", "secondary", "match score")
    })
    {
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body py-3 px-3">
                    <div class="rounded-circle bg-@color bg-opacity-10
                        d-flex align-items-center justify-content-center mb-2"
                         style="width:40px;height:40px;">
                        <i class="bi @icon text-@color"></i>
                    </div>
                    <h3 class="fw-bold mb-0 text-@color">@value</h3>
                    <p class="text-muted small mb-0 fw-500">@label</p>
                    <small class="text-muted" style="font-size:11px;">@sub</small>
                </div>
            </div>
        </div>
    }
</div>

<!-- ── Charts Row 1 ───────────────────────────────────────────────────────── -->
<div class="row g-4 mb-4">

    <!-- Applications Trend (weekly) -->
    <div class="col-lg-8">
        <div class="card shadow-sm h-100">
            <div class="card-header py-3 d-flex justify-content-between">
                <h6 class="mb-0 fw-600">
                    <i class="bi bi-graph-up me-2 text-primary"></i>Applications This Period
                </h6>
                <small class="text-muted">Last 8 weeks</small>
            </div>
            <div class="card-body">
                <canvas id="trendChart" height="100"></canvas>
            </div>
        </div>
    </div>

    <!-- Status Doughnut -->
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header py-3">
                <h6 class="mb-0 fw-600">
                    <i class="bi bi-pie-chart me-2 text-primary"></i>Application Status
                </h6>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="statusChart" height="200" style="max-height:220px;"></canvas>
            </div>
        </div>
    </div>

</div>

<!-- ── Charts Row 2 ───────────────────────────────────────────────────────── -->
<div class="row g-4 mb-4">

    <!-- Score Distribution -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header py-3">
                <h6 class="mb-0 fw-600">
                    <i class="bi bi-bar-chart-steps me-2 text-primary"></i>
                    AI Score Distribution
                </h6>
            </div>
            <div class="card-body">
                <canvas id="scoreChart" height="160"></canvas>
            </div>
        </div>
    </div>

    <!-- Job Performance -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header py-3">
                <h6 class="mb-0 fw-600">
                    <i class="bi bi-briefcase me-2 text-primary"></i>Job Performance
                </h6>
            </div>
            <div class="card-body">
                <canvas id="jobChart" height="160"></canvas>
            </div>
        </div>
    </div>

</div>

<!-- ── Main Content Row ───────────────────────────────────────────────────── -->
<div class="row g-4">

    <!-- Pending Actions (left) -->
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-600">
                    <i class="bi bi-hourglass-split me-2 text-warning"></i>
                    Pending Review
                    @if (Model.PendingReview > 0)
                    {
                        <span class="badge bg-warning text-dark ms-1">@Model.PendingReview</span>
                    }
                </h6>
                <a asp-controller="Application" asp-action="Shortlisted"
                   class="btn btn-sm btn-outline-warning">Shortlisted</a>
            </div>

            @if (!Model.PendingActions.Any())
            {
                <div class="card-body text-center py-5">
                    <i class="bi bi-check-circle text-success" style="font-size:2.5rem;"></i>
                    <p class="text-muted mt-2">All caught up! No pending applications.</p>
                </div>
            }
            else
            {
                <div class="card-body p-0">
                    @foreach (var action in Model.PendingActions)
                    {
                        <div class="d-flex align-items-center gap-3 px-4 py-3 border-bottom">
                            <div class="rounded-circle bg-primary text-white d-flex
                                align-items-center justify-content-center
                                fw-bold flex-shrink-0"
                                 style="width:40px;height:40px;">
                                @action.InitialsAvatar
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <a asp-controller="Application" asp-action="Details"
                                       asp-route-id="@action.ApplicationId"
                                       class="fw-600 text-dark text-decoration-none small d-block">
                                    @action.CandidateName
                                </a>
                                <small class="text-muted text-truncate d-block">
                                    @action.JobTitle · @action.TimeAgo
                                </small>
                            </div>
                            <div class="flex-shrink-0 text-end">
                                <div class="@action.ScoreColorClass fw-bold">
                                    @action.MatchScore.ToString("F0")%
                                </div>
                                <small class="text-muted">match</small>
                            </div>
                            <div class="flex-shrink-0 d-flex gap-1">
                                <form asp-controller="Application" asp-action="UpdateStatus"
                                      method="post">
                                    <input type="hidden" name="applicationId"
                                           value="@action.ApplicationId" />
                                    <input type="hidden" name="status" value="Shortlisted" />
                                    <button type="submit" class="btn btn-sm btn-warning"
                                            title="Shortlist">
                                        <i class="bi bi-star"></i>
                                    </button>
                                </form>
                                <form asp-controller="Application" asp-action="UpdateStatus"
                                      method="post">
                                    <input type="hidden" name="applicationId"
                                           value="@action.ApplicationId" />
                                    <input type="hidden" name="status" value="Rejected" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            title="Reject">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Right Column -->
    <div class="col-lg-5">

        <!-- My Top Jobs -->
        <div class="card shadow-sm mb-4">
            <div class="card-header py-3 d-flex justify-content-between">
                <h6 class="mb-0 fw-600">
                    <i class="bi bi-briefcase me-2 text-primary"></i>My Jobs
                </h6>
                <a asp-controller="Job" asp-action="Index"
                   class="btn btn-sm btn-outline-primary">Manage</a>
            </div>
            <div class="card-body p-0">
                @foreach (var job in Model.MyTopJobs)
                {
                    <div class="d-flex align-items-center gap-2 px-3 py-3 border-bottom">
                        <div class="flex-grow-1 overflow-hidden">
                            <a asp-controller="Application" asp-action="Index"
                                   asp-route-jobId="@job.JobId"
                                   class="fw-500 small text-dark text-decoration-none text-truncate d-block">
                                @job.Title
                            </a>
                            <small class="text-muted">
                                @job.ApplicationCount apps ·
                                <span class="@(job.Status == "Active" ? "text-success" : "text-secondary")">
                                    @job.Status
                                </span>
                            </small>
                        </div>
                        <div class="text-end flex-shrink-0">
                            <span class="badge bg-warning text-dark">
                                @job.ShortlistedCount shortlisted
                            </span>
                        </div>
                    </div>
                }
                @if (!Model.MyTopJobs.Any())
                {
                    <div class="text-center py-4">
                        <p class="text-muted small mb-2">No jobs posted yet</p>
                        <a asp-controller="Job" asp-action="Create"
                           class="btn btn-primary btn-sm">Post First Job</a>
                    </div>
                }
            </div>
        </div>

        <!-- Top Candidates -->
        <div class="card shadow-sm">
            <div class="card-header py-3">
                <h6 class="mb-0 fw-600">
                    <i class="bi bi-person-badge me-2 text-primary"></i>Top Candidates
                </h6>
            </div>
            <div class="card-body p-0">
                @foreach (var c in Model.TopCandidates)
                {
                    <div class="d-flex align-items-center gap-2 px-3 py-3 border-bottom">
                        @if (!string.IsNullOrEmpty(c.ProfileImagePath))
                        {
                            <img src="@c.ProfileImagePath" class="rounded-circle flex-shrink-0"
                                 style="width:36px;height:36px;object-fit:cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-success text-white d-flex
                                align-items-center justify-content-center
                                fw-bold flex-shrink-0"
                                 style="width:36px;height:36px;font-size:12px;">
                                @c.InitialsAvatar
                            </div>
                        }
                        <div class="flex-grow-1 overflow-hidden">
                            <a asp-controller="Candidate" asp-action="Details"
                                   asp-route-id="@c.CandidateId"
                                   class="fw-500 small text-dark text-decoration-none d-block">
                                @c.Name
                            </a>
                            <small class="text-muted text-truncate d-block">
                                @(c.Headline ?? "No headline")
                            </small>
                        </div>
                        <span class="badge @(c.HighestMatchScore >= 75 ? "bg-success" :
                                                                                                       c.HighestMatchScore >= 50 ? "bg-primary" : "bg-warning text-dark")
                            flex-shrink-0">
                            @c.HighestMatchScore.ToString("F0")%
                        </span>
                    </div>
                }
                @if (!Model.TopCandidates.Any())
                {
                    <div class="text-center py-4">
                        <p class="text-muted small mb-0">No scored candidates yet.</p>
                    </div>
                }
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // ── Trend Area Chart ────────────────────────────────────────────────
        new Chart(document.getElementById('trendChart'), {
        type: 'line',
        data: {
        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.ApplicationsTrend.Labels)),
        datasets: [{
        label: 'Applications',
        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            Model.ApplicationsTrend.Values)),
        borderColor: '#1a56db',
        backgroundColor: 'rgba(26,86,219,0.08)',
        borderWidth: 2.5,
        fill: true,
        tension: 0.4,
        pointRadius: 4,
        pointBackgroundColor: '#1a56db'
        }]
        },
        options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
        y: { beginAtZero: true, grid: { color: '#f3f4f6' },
        ticks: { stepSize: 1 } },
        x: { grid: { display: false } }
        }
        }
        });

        // ── Status Doughnut ─────────────────────────────────────────────────
        new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: {
        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.ApplicationsByStatus.Labels)),
        datasets: [{
        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            Model.ApplicationsByStatus.Values)),
        backgroundColor: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            Model.ApplicationsByStatus.BackgroundColors)),
        borderWidth: 2,
        borderColor: '#fff'
        }]
        },
        options: {
        responsive: true,
        cutout: '65%',
        plugins: {
        legend: {
        display: true,
        position: 'bottom',
        labels: { boxWidth: 12, padding: 10, font: { size: 11 } }
        }
        }
        }
        });

        // ── Score Distribution ──────────────────────────────────────────────
        new Chart(document.getElementById('scoreChart'), {
        type: 'bar',
        data: {
        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.ScoreDistribution.Labels)),
        datasets: [{
        label: 'Candidates',
        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            Model.ScoreDistribution.Values)),
        backgroundColor: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            Model.ScoreDistribution.BackgroundColors)),
        borderRadius: 6
        }]
        },
        options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
        y: { beginAtZero: true, grid: { color: '#f3f4f6' },
        ticks: { stepSize: 1 } },
        x: { grid: { display: false } }
        }
        }
        });

        // ── Job Performance ─────────────────────────────────────────────────
        new Chart(document.getElementById('jobChart'), {
        type: 'bar',
        data: {
        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.JobPerformance.Labels)),
        datasets: [{
        label: 'Applications',
        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            Model.JobPerformance.Values)),
        backgroundColor: 'rgba(26,86,219,0.75)',
        borderRadius: 6
        }]
        },
        options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
        y: { beginAtZero: true, grid: { color: '#f3f4f6' },
        ticks: { stepSize: 1 } },
        x: { grid: { display: false } }
        }
        }
        });
    </script>
}