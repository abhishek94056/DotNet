{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=localhost\\SQLEXPRESS2025;Initial Catalog=AIResumeScreeningDB;Integrated Security=True;TrustServerCertificate=True"
  },
  "OpenAI": {
    "ApiKey": "YOUR_API_KEY",
    "Model": "claude-sonnet-4-6", //"gpt-4o"
    "MaxTokens": 2000,
    "Temperature": 0.7
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "EnableSsl": true,
    "SenderEmail": "your-email@gmail.com",
    "SenderName": "AI Resume Screening System",
    "Username": "your-email@gmail.com",
    "Password": "YOUR_APP_PASSWORD_HERE"
  },
  "FileStorage": {
    "ResumesFolder": "wwwroot/uploads/resumes",
    "ProfileImagesFolder": "wwwroot/uploads/profiles",
    "ReportsFolder": "wwwroot/uploads/reports",
    "MaxFileSizeMB": 5,
    "AllowedExtensions": [ ".pdf", ".docx", ".doc" ]
  },
  "Jwt": {
    "Key": "YourSuperSecretKeyThatShouldBeAtLeast32CharactersLong!",
    "Issuer": "AIResumeScreeningSystem",
    "Audience": "AIResumeScreeningSystemUsers",
    "ExpiryInDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}