<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Invoice Generator</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/invoice.css" />
    @RenderSection("Styles", required: false)
    
    <style>
        /* ── Layout shell ── */
        body { display: flex; flex-direction: column; min-height: 100vh; margin: 0; }

        /* ── Top navbar ── */
        .top-navbar { height: 52px; z-index: 1040; }

        /* ── Sidebar ── */
        #sidebar {
    width: 240px;
    height: calc(100vh - 52px);   /* fixed height */
    background: #1a1d23;
    position: fixed;
    top: 52px;
    left: -240px;
    z-index: 1035;
    transition: left .25s ease;

    overflow-y: auto;   /* vertical scrollbar */
    overflow-x: hidden;

    scrollbar-width: thin; /* Firefox */
}
/* Chrome, Edge, Safari */
#sidebar::-webkit-scrollbar {
    width: 6px;
}

#sidebar::-webkit-scrollbar-track {
    background: #1a1d23;
}

#sidebar::-webkit-scrollbar-thumb {
    background: #555;
    border-radius: 10px;
}

#sidebar::-webkit-scrollbar-thumb:hover {
    background: #888;
}
        #sidebar.show { left: 0; }

        /* ── Sidebar overlay (mobile) ── */
        #sidebarOverlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.45);
            z-index: 1034;
        }
        #sidebarOverlay.show { display: block; }

        /* ── Main content shifts right when sidebar open on large screens ── */
        @@media (min-width: 992px) {
            body.sidebar-open #sidebar        { left: 0; }
            body.sidebar-open #mainContent    { margin-left: 240px; }
            body.sidebar-open #sidebarOverlay { display: none !important; }
        }

        #mainContent { transition: margin-left .25s ease; }

        /* ── Sidebar nav links ── */
        #sidebar .nav-link {
            color: #c8ccd4;
            font-size: .875rem;
            padding: .45rem 1rem;
            border-radius: 0;
            display: flex;
            align-items: center;
            gap: .55rem;
            white-space: nowrap;
        }
        #sidebar .nav-link:hover  { background: #2a2d35; color: #fff; }
        #sidebar .nav-link.active { background: #0d6efd; color: #fff; }

        /* ── Section header label ── */
        #sidebar .sidebar-label {
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: #6c757d;
            padding: 1rem 1rem .35rem;
        }

        /* ── Collapsible group arrow ── */
        #sidebar .group-toggle::after {
            content: "\F282";                /* bi-chevron-down */
            font-family: "bootstrap-icons";
            margin-left: auto;
            transition: transform .2s;
            font-size: .75rem;
        }
        #sidebar .group-toggle.collapsed::after { transform: rotate(-90deg); }

        /* ── Sub-menu indent ── */
        #sidebar .sub-menu .nav-link {
            padding-left: 2.4rem;
            font-size: .82rem;
        }

        /* ── User panel in sidebar ── */
        .sidebar-user {
            display: flex;
            align-items: center;
            gap: .65rem;
            padding: 1rem;
            border-bottom: 1px solid #2a2d35;
        }
        .sidebar-user .avatar {
            width: 36px; height: 36px;
            background: #0d6efd;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 1rem; flex-shrink: 0;
        }
        .sidebar-user .username { color: #e2e5ea; font-size: .85rem; font-weight: 500; }
        .sidebar-user .status   { color: #28a745; font-size: .72rem; }
    </style>
</head>
<body>

<!-- ───────── TOP NAVBAR ───────── -->
<nav class="navbar navbar-dark bg-dark px-3 py-1 shadow-sm top-navbar position-fixed w-100">
    <div class="d-flex align-items-center w-100 position-relative">

        <!-- Hamburger (toggles sidebar) -->
        <button id="sidebarToggle" class="btn btn-link text-white p-0 me-3 border-0">
            <i class="bi bi-list fs-4"></i>
        </button>

        <!-- Logo -->
        <a asp-controller="Auth" asp-action="Dashboard">
            <img src="~/images/Logo.png" alt="Logo" height="40" class="me-2" />
        </a>

        <!-- Company name — centered -->
        <div class="position-absolute top-50 start-50 translate-middle">
            <img src="~/images/Company Name.png" alt="Company Name" height="35" />
        </div>

        <!-- Right side -->
        <div class="ms-auto d-flex align-items-center gap-2">
            @if (Context.Session.GetInt32("UserId").HasValue)
            {
                <span class="text-white small d-none d-md-inline">
                    <i class="bi bi-person-circle me-1"></i>
                    @Context.Session.GetString("UserName")
                </span>
                <a asp-controller="Auth" asp-action="Logout"
                   class="btn btn-outline-light btn-sm py-0 px-2">
                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                </a>
            }
        </div>

    </div>
</nav>

<!-- ───────── SIDEBAR OVERLAY (mobile) ───────── -->
<div id="sidebarOverlay"></div>

<!-- ───────── SIDEBAR ───────── -->
