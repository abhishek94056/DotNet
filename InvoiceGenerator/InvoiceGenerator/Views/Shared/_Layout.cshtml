            </a>
            <div class="collapse @(ctrl is "NPDItem" or "PPBoxNPDItem" ? "show" : "")"
                 id="npdGroup">
                <ul class="nav flex-column sub-menu">
                    <li class="nav-item">
                        <a class="nav-link @(ctrl == "NPDItem" ? "active" : "")"
                           href="@Url.Action("NPDItemView", "NPDItem")">
