@using InvoiceGenerator
@using InvoiceGenerator.Models
@using InvoiceGenerator.ViewModels
@using InvoiceGenerator.Services
@using Microsoft.AspNetCore.Mvc.Rendering
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model InvoiceViewModel
@{
    ViewData["Title"] = "Create Invoice";
}
<link rel="stylesheet" href="~/css/invoice.css" />
<!-- Hidden options template (Razor renders once on server, JS clones for new rows) -->
<select id="itemOptionsTemplate" style="display:none">
    <option value="">-- Select --</option>
    @foreach (var i in Model.ItemsList)
    {
        <option>@i.Text</option>
    }
</select>

<div class="container-fluid mt-0">
    <div class="card shadow-sm">

        <!-- ===== HEADER ===== -->
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">🧾 TAX INVOICE</h5>
            @* <strong id="invoiceLabel">@Model.NextInvoiceLabel</strong> *@
        </div>

        <div class="card-body py-1">

            <!-- ===================== ROW 1: Company Info + PO/DC Details ===================== -->
          
            <div class="row g-1 mb-1">

                <!-- LEFT: CodNow Company Info -->
                <div class="col-md-6">
                    <div class="card border-secondary h-100">

                        <div class="card-header fw-bold text-center py-1 small">
                            M/S CodNow Technologies
                        </div>

                        <div class="card-body py-2 px-2">

                           
                            <div class="row mb-1">
                                <label class="col-sm-4 col-form-label fw-bold">Address :</label>
                                <div class="col-sm-8">
                                    <p class="form-control-plaintext">
                                        Plot No.32, Gut No.83, Renuka Nagar, Opp. Vinayak Park,
                                        Deolai Road, Chhatrapati Sambhajinagar - 431001
                                    </p>
                                </div>
                            </div>

                            <div class="row mb-1">
                                <label class="col-sm-4 col-form-label fw-bold">Phone :</label>
                                <div class="col-sm-8">
                                    <p class="form-control-plaintext">+91 9923 8888 91 / +91 7972 3815 80</p>
                                </div>
                            </div>

                            <div class="row mb-1">
                                <label class="col-sm-4 col-form-label fw-bold">State Code :</label>
                                <div class="col-sm-8">
                                    <p class="form-control-plaintext">27 &nbsp;&nbsp; <strong>State :</strong> Maharashtra</p>
                                </div>
                            </div>

                            <div class="row mb-1">
                                <label class="col-sm-4 col-form-label fw-bold">GSTIN :</label>
                                <div class="col-sm-8">
                                    <p class="form-control-plaintext fw-bold">27FAEPS7663Q1ZK</p>
                                </div>
                            </div>

                            <div class="row mb-1">
                                <label class="col-sm-4 col-form-label fw-bold">PAN :</label>
                                <div class="col-sm-8">
                                    <p class="form-control-plaintext">FAEPS7663Q</p>
                                </div>
                            </div>


                        </div>
                    </div>
                </div>

                <!-- RIGHT: Invoice / PO / DC Details -->
                <div class="col-md-6">
                    <div class="card border-secondary h-100">

                        <div class="card-header fw-bold text-center py-1 small">
                            Invoice / PO / DC Details
                        </div>

                        <div class="card-body py-1 px-2">

                            <div class="row mb-1">
                                <label class="col-sm-4 col-form-label py-1 small fw-bold">Invoice No :</label>
                                <div class="col-sm-8 d-flex align-items-center small">
                                    <strong id="invoiceNoDisplay">@Model.NextInvoiceLabel</strong>
                                </div>
                            </div>

                            <div class="row mb-1">
                                <label class="col-sm-4 col-form-label py-1 small fw-bold">Invoice Date :</label>
                                <div class="col-sm-8">
                                    <input type="date" id="invoiceDate" class="form-control form-control-sm" value="@(DateTime.Now.ToString("yyyy-MM-dd"))" />
                                </div>
                            </div>

                            <div class="row mb-1">
                                <label class="col-sm-4 col-form-label py-1 small fw-bold">Date of Supply :</label>
                                <div class="col-sm-8">
                                    <input type="date" id="dateOfSupply" class="form-control form-control-sm" value="@(DateTime.Now.ToString("yyyy-MM-dd"))" />
                                </div>
                            </div>

                            <div class="row mb-1">
                                <label class="col-sm-4 col-form-label py-1 small fw-bold">Purchase Order No  :</label>
                                <div class="col-sm-8">
                                    <input type="text" id="poNo" class="form-control form-control-sm" />
                                </div>
                            </div>

                            <div class="row mb-1">
                                <label class="col-sm-4 col-form-label py-1 small fw-bold">Purchase Order Date :</label>
                                <div class="col-sm-8">
                                    <input type="date" id="poDate" class="form-control form-control-sm" value="@(DateTime.Now.ToString("yyyy-MM-dd"))" />
                                </div>
                            </div>

                            @* <div class="row mb-1">
                                <label class="col-sm-4 col-form-label py-1 small fw-bold">DC No :</label>
                                <div class="col-sm-8">
                                    <input type="text" id="dcNo" class="form-control form-control-sm" />
                                </div>
                            </div>

                            <div class="row mb-1">



                                <label class="col-sm-4 col-form-label py-1 small fw-bold">DC Date :</label>
                                <div class="col-sm-8">
                                    <input type="date" id="dcDate" class="form-control form-control-sm" />
                                </div>
                            </div> *@

                            <div class="row mb-1">
                                <label class="col-sm-4 col-form-label py-1 small fw-bold">Vehicle No :</label>
                                <div class="col-sm-8">
                                    <input type="text" id="vehicleNo" class="form-control form-control-sm" />
                                </div>
                            </div>


                            <div class="row mb-1">
                                <label class="col-sm-4 col-form-label py-1 small fw-bold">ASN No. :</label>
                                <div class="col-sm-8">
                                    <input type="text" id="ASNNo" class="form-control form-control-sm" />
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
            <!-- ===================== ROW 2: Invoice To + Shipping To ===================== -->
           
            <div class="row g-2 mb-2">

                <!-- LEFT: Invoice To -->
                <div class="col-md-6">
                    <div class="card border-secondary h-100">

                        <div class="card-header fw-bold text-center py-1 small">
                            Invoice To
                        </div>

                        <div class="card-body py-2 px-2">

                            <!-- Select Company -->
                            <div class="row mb-1">
                                <label class="col-sm-4 col-form-label py-1 small fw-bold">
                                    Select Company :
                                </label>
                                <div class="col-sm-8">
                                    <select id="invoiceTo" class="form-select form-select-sm"
                                            onchange="loadCompanyDetails('invoiceTo')">
                                        @foreach (var c in Model.Companies)
                                        {
                                            <option>@c.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <!-- Details -->
                            <table class="table table-sm table-borderless mb-0">
                                <tr>
                                    <td colspan="2" class="fw-bold text-center small" id="it_CompanyName"></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold" style="width:35%">Address :</td>
                                    <td id="it_Address"></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">State Code :</td>
                                    <td id="it_StateCode"></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">State :</td>
                                    <td id="it_State"></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">GSTIN :</td>
                                    <td id="it_GSTIN" class="fw-bold"></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Payment Term :</td>
                                    <td id="it_PaymentTerm" class="fw-bold"></td>
                                </tr>
                            </table>

                        </div>
                    </div>
                </div>

                <!-- RIGHT: Shipping To -->
                <div class="col-md-6">
                    <div class="card border-secondary h-100">

                        <div class="card-header fw-bold text-center py-1 small">
                            Shipping To
                        </div>

                        <div class="card-body py-2 px-2">

                            <!-- Select Company -->
                            <div class="row mb-1">
                                <label class="col-sm-4 col-form-label py-1 small fw-bold">
                                    Select Company :
                                </label>
                                <div class="col-sm-8">
                                    <select id="shippingTo" class="form-select form-select-sm"
                                            onchange="loadCompanyDetails('shippingTo')">
                                        @foreach (var c in Model.Companies)
                                        {
                                            <option>@c.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <!-- Details -->
                            <table class="table table-sm table-borderless mb-0">
                                <tr>
                                    <td colspan="2" class="fw-bold text-center small" id="st_CompanyName"></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold" style="width:35%">Address :</td>
                                    <td id="st_Address"></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">State Code :</td>
                                    <td id="st_StateCode"></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">State :</td>
                                    <td id="st_State"></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">GSTIN :</td>
                                    <td id="st_GSTIN" class="fw-bold"></td>
                                </tr>
                            </table>

                        </div>
                    </div>
                </div>

            </div>
            <!-- ===================== ITEMS TABLE ===================== -->
            <div class="card border-secondary mb-2">
                <div class="card-header fw-bold py-1 small">Items</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm mb-0 align-middle"
                               id="itemsTable">
                            <thead class="table-dark small text-center">
                                <tr>
                                    <th style="width:4%">Sr</th>
                                    <th style="width:10%">Item Code</th>
                                    <th style="width:28%">Item Description</th>
                                    <th style="width:10%">HSN</th>
                                    <th style="width:9%">Rate</th>
                                    <th style="width:7%">Qty</th>
                                    <th style="width:6%">GST%</th>
                                    <th style="width:10%">Taxable Amt</th>
                                    <th style="width:9%">GST Amt</th>
                                    <th style="width:10%">Total Amt</th>
                                    <th style="width:4%"></th>
                                </tr>
                            </thead>
                            <tbody id="itemsBody" class="small">
                                <tr>
                                    <td class="text-center align-middle">1</td>
                                    <td class="itemCode text-center align-middle"></td>
                                    <td>
                                        <select class="form-select form-select-sm item-select"
                                                onchange="onItemChange(this)">
                                            <option value="">-- Select --</option>
                                            @foreach (var i in Model.ItemsList)
                                            {
                                                <option>@i.Text</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="hsn text-center align-middle"></td>
                                    <td class="rate text-center align-middle"></td>
                                    @* <td>
                                        <input type="number"
                                               class="form-control form-control-sm qty text-center"
                                               oninput="calcRow(this)" min="0" step="any" />
                                    </td> *@
                                    <td class="text-center align-middle">
                                        <div class="d-flex justify-content-center align-items-center">
                                            <input type="number"
                                                   class="form-control form-control-sm qty text-center"
                                                   oninput="calcRow(this)" min="0" step="any"
                                                   style="width:70px;" />
                                        </div>
                                    </td>
                                    <td class="gst text-center align-middle"></td>
                                    <td class="taxableAmt text-end align-middle pe-2">0.00</td>
                                    <td class="gstAmt text-end align-middle pe-2">0.00</td>
                                    <td class="amount text-end align-middle pe-2 fw-bold">0.00</td>
                                    <td class="text-center align-middle">
                                        <button class="btn btn-sm btn-outline-danger py-0 px-1"
                                                onclick="removeRow(this)">
                                            ×
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot class="table-light small fw-bold">
                                <tr>
                                    <td colspan="7" class="text-end pe-2">Totals :</td>
                                    <td class="text-end pe-2" id="footTaxable">0.00</td>
                                    <td class="text-end pe-2" id="footGst">0.00</td>
                                    <td class="text-end pe-2" id="footTotal">0.00</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                <div class="card-footer py-1 px-2">
                    <button class="btn btn-secondary btn-sm py-0 px-2" onclick="addRow()">
                        + Row
                    </button>
                </div>
            </div>

            <!-- ===================== BANK DETAILS + TOTALS ===================== -->
            <div class="row mb-2">
                <div class="col-md-8">
                    <div class="fw-bold small mb-1">NEFT / RTGS BANK DETAILS:</div>
                    <div class="small">
                        <div><b>BANK :</b> IDBI BANK</div>
                        <div><b>A/C NAME :</b> CODNOW TECHNOLOGIES</div>
                        <div><b>A/C NO :</b> 0076102000048736</div>
                        <div><b>IFSC :</b> IBKL0000076</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <table class="table table-sm table-bordered mb-0 small">
                        <tr>
                            <td class="py-1">Taxable Value</td>
                            <td class="text-end fw-bold py-1" id="taxableValue">0.00</td>
                        </tr>
                        <tr>
                            <td class="py-1">CGST</td>
                            <td class="text-end py-1" id="cgst">0.00</td>
                        </tr>
                        <tr>
                            <td class="py-1">SGST</td>
                            <td class="text-end py-1" id="sgst">0.00</td>
                        </tr>
                        <tr>
                            <td class="py-1">IGST</td>
                            <td class="text-end py-1" id="igst">0.00</td>
                        </tr>
                        <tr class="table-primary fw-bold">
                            <td class="py-1">Total Value</td>
                            <td class="text-end py-1" id="totalValue">0.00</td>
                        </tr>
                    </table>
                </div>
            </div>
            <!-- ===================== DECLARATION ===================== -->
            <div class="mb-2 small">

                <!-- In Words -->
                <div class="mb-1">
                    <span class="fw-bold">In Words :</span>
                    <span id="totalWords"></span>
                </div>

                <!-- Transport Mode -->
                <div class="mb-1 d-flex align-items-center gap-1">
                    <span class="fw-bold">Transport Mode :</span>
                    <select id="transportMode" class="form-select form-select-sm w-auto"
                            onchange="recalcTotal()">
                        @foreach (var m in Model.TransportModes)
                        {
                            <option>@m.Text</option>
                        }
                    </select>
                </div>

                <!-- Transporter -->
                <div class="mb-1">
                    <span class="fw-bold">Transporter :</span>
                    <span>CodNow Technologies</span>
                </div>

                <!-- Remark -->
                <div class="mb-1 d-flex align-items-center gap-1 ">
                    <span class="fw-bold">Remark :</span>
                    <input type="text" id="remark"
                           class="form-control form-control-sm w-auto"
                           style="min-width:200px" />
                </div>

            </div>

            <!-- ===================== ACTION BUTTONS ===================== -->
            <div class="d-flex justify-content-center gap-2 mt-1">
                <button class="btn btn-primary btn-sm px-3" onclick="saveInvoice()">
                    💾 Save
                </button>

                <button class="btn btn-success btn-sm px-3" id="btnPdf"
                        style="display:none" onclick="downloadPdf()">
                    📄 PDF
                </button>
            </div>
        </div><!-- /card-body -->
    </div><!-- /card -->
</div><!-- /container -->
@section Scripts {
    <script src="~/js/Invoice.js" asp-append-version="true"></script>
}