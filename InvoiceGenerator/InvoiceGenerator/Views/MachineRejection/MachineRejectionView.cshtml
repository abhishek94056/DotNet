@{
    ViewData["Title"] = "Machine Rejection Data";
}
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<style>
    :root {
        --header-bg: #1a1a2e;
        --row-odd: #f8f9fa;
        --row-even: #eef2ff;
        --row-hover: #cfe2ff;
    }

    /* HEADER */
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 10px;
    }

        .page-header h6 {
            margin: 0;
            font-weight: 700;
        }

    .header-controls {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
    }

    /* TABLE */
    #rejTable {
        width: 100%;
        min-width: 1700px;
        font-size: 0.70rem;
    }

        #rejTable thead th {
            font-size: 0.67rem;
            padding: 4px 5px;
            white-space: nowrap;
            text-align: center;
            background: var(--header-bg);
            color: #fff;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        #rejTable tbody td {
            padding: 3px 5px;
            vertical-align: middle;
            white-space: nowrap;
        }

        #rejTable tbody tr:nth-child(odd) td {
            background: var(--row-odd);
        }

        #rejTable tbody tr:nth-child(even) td {
            background: var(--row-even);
        }

        #rejTable tbody tr:hover td {
            background: var(--row-hover) !important;
            cursor: pointer;
        }

        #rejTable .btn-sm {
            padding: 1px 4px;
            font-size: 0.65rem;
        }

    /* TABLE WRAP */
    .table-wrap {
        max-height: 450px;
        overflow-y: auto;
        overflow-x: auto;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        -webkit-overflow-scrolling: touch;
    }
    /* ════════════════════════════════════════
           SELECT2
        ════════════════════════════════════════ */


    .select2-wrapper {
        flex: 1 1 auto;
        width: 100%;
    }

    .select2-container {
        width: 100% !important;
    }

    .select2-container--default .select2-selection--single {
        height: 31px !important;
        border: 1px solid #ced4da !important;
        border-radius: 0 .25rem .25rem 0 !important;
        display: flex !important;
        align-items: center !important;
    }

    .select2-selection__rendered {
        line-height: normal !important;
        display: flex !important;
        align-items: center !important;
        height: 100%;
        padding-left: 6px !important;
    }

    .select2-selection__arrow {
        height: 100% !important;
        top: 0 !important;
    }
    /* PAGINATION */
    .pagination-bar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 8px;
        font-size: 0.72rem;
    }

        .pagination-bar button {
            min-width: 28px;
            height: 26px;
            font-size: 0.68rem;
        }

            .pagination-bar button.active-pg {
                background: #dc3545;
                color: #fff;
                border-color: #dc3545;
            }

    /* SUMMARY */
    .rej-summary {
        background: linear-gradient(135deg,#4e1a1a,#a03030);
        color: #fff;
        border-radius: 8px;
        padding: 8px 14px;
        font-size: 0.72rem;
        height: 100%;
    }

        .rej-summary .val {
            font-size: 1rem;
            font-weight: 700;
            color: #ffd0d0;
        }

    /* MODAL */
    .modal .form-label {
        margin-bottom: 3px;
    }

    .modal .input-group-text {
        height: 31px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal .form-control-sm,
    .modal .form-select-sm {
        font-size: 0.75rem;
    }

    /* LOADING */
    #loadingRow td {
        text-align: center;
        padding: 20px;
        color: #888;
    }

    /* MOBILE */
    @@media (max-width:575px) {

        .page-header {
            flex-direction: column;
            align-items: stretch;
        }

        .header-controls {
            flex-direction: column;
            align-items: stretch;
        }

            .header-controls select,
            .header-controls input,
            .header-controls button {
                width: 100% !important;
            }

        #rejTable {
            min-width: 1700px;
        }

        .pagination-bar {
            justify-content: center;
        }

            .pagination-bar #pageNumbers {
                flex-wrap: wrap;
            }

        .modal-dialog {
            margin: .5rem;
        }

        .modal .row > div {
            margin-bottom: 2px;
        }

        .rej-summary {
            padding: 6px 10px;
        }
    }

    /* TABLET */
    @@edia (min-width:576px) and (max-width:991px) {

        #rejTable {
            min-width: 1500px;
        }

        .pagination-bar {
            justify-content: center;
        }
    }
</style>

<!-- ── PAGE HEADER ── -->
<div class="page-header">
    <h6 class="mb-0 fw-bold">
        <i class="bi bi-exclamation-octagon me-2 text-primary"></i>
        Machine Rejection Data Entry
    </h6>
   <div class="header-controls">

        <select id="headerDeptFilter"
                class="form-select form-select-sm"
                style="width:160px">
            <option value="0">-- Department --</option>
        </select>

        <input type="text" id="searchInput"
               class="form-control form-control-sm"
               placeholder="🔍 Search..."
               style="width:155px" oninput="applyFilter()" />

       

        <button class="btn btn-primary btn-sm" id="btnAdd">
            <i class="bi bi-plus-lg me-1"></i>Add Rejection
        </button>
    </div>
</div>


<!-- ── TABLE ── -->
<div class="table-wrap">
    <table class="table table-bordered mb-0" id="rejTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Dept</th>
                <th>Date</th>
                <th>Shift</th>
                <th>Machine</th>
                <th>Item Code</th>
                <th>Description</th>
                <th>Rejection Reason</th>
                <th>Rej Qty</th>
                <th>Shot Wt (g)</th>
                <th>Finish Wt</th>
                <th>Remark</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="tableBody">
            <tr id="loadingRow">
                <td colspan="15">
                    <i class="bi bi-info-circle text-primary me-2"></i>
                    Select a Department.
                </td>
            </tr>
        </tbody>
      
    </table>
</div>

<!-- ── PAGINATION ── -->
<div class="pagination-bar">
    <span id="pageInfo" class="text-muted"></span>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnFirst" onclick="goToPage(1)">«</button>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnPrev"  onclick="goToPage(currentPage-1)">‹</button>
    <span id="pageNumbers" class="d-flex gap-1"></span>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnNext"  onclick="goToPage(currentPage+1)">›</button>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnLast"  onclick="goToPage(totalPages)">»</button>
    <select id="rppSelect" class="form-select form-select-sm"
            style="width:75px" onchange="changeRPP()">
        <option value="10" selected>10</option>
        <option value="20">20</option>
        <option value="50">50</option>
    </select>
    <span class="text-muted">/ page</span>
</div>

<!-- ══════════════════════════════════════════════
     ADD / EDIT MODAL
══════════════════════════════════════════════ -->
<div class="modal fade" id="rejModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered
                modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header bg-dark text-white py-2">
                <h6 class="modal-title mb-0">
                    <i class="bi bi-exclamation-octagon me-2"></i>
                    <span id="modalTitleText">Add Rejection Entry</span>
                </h6>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="rejForm" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="fSrNo"         value="0" />

                    <!-- ── ROW 1 ── -->
                    <div class="row g-2">

                        <div class="col-md-4">
    <label class="form-label fw-semibold small">
        Department <span class="text-primary">*</span>
    </label>

    <div class="input-group input-group-sm">
        <span class="input-group-text">
            <i class="bi bi-building"></i>
        </span>

        <select id="fDepartmentId"
                class="form-select form-select-sm"
                onchange="onDepartmentChange()">
            <option value="0">
                -- Select Department --
            </option>
        </select>
    </div>

    <div class="invalid-feedback d-block"
         id="err-dept"></div>
</div>

                        <!-- Shift -->

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Shift <span class="text-primary">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-clock"></i>
                                </span>
                                <select id="fShiftId"
                                        class="form-select form-select-sm">
                                    <option value="0">
                                        -- Select Shift --
                                    </option>
                                </select>
                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-shift"></div>
                        </div>

                        <!-- Machine -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Machine <span class="text-primary">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-cpu"></i>
                                </span>
                                <select id="fMachineId"
                                        class="form-select form-select-sm">
                                    <option value="0">
                                        -- Select Machine --
                                    </option>
                                </select>
                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-machine"></div>
                        </div>

                        <!-- Date -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Date <span class="text-primary">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-calendar3"></i>
                                </span>
                                <input type="date" id="fDate"
                                       class="form-control form-control-sm" />
                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-date"></div>
                        </div>

                   

                        <!-- Item Code -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Item Code <span class="text-primary">*</span>
                            </label>
                            @* <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-upc-scan"></i>
                                </span>
                                <select id="fItemId"
                                        class="form-select form-select-sm"
                                        onchange="onItemChange()">
                                    <option value="0">
                                        -- Select Item --
                                    </option>
                                </select>
                            </div> *@

                            <div class="input-group input-group-sm">

                                <div class="select2-wrapper">
                                    <select id="fItemId"
                                            class="form-select form-select-sm"
                                            onchange="onItemChange()">
                                        <option value="0">-- Select Item --</option>
                                    </select>
                                </div>

                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-item"></div>
                        </div>

                        <!-- Item Description -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Description
                            </label>
                            <input type="text" id="fItemDesc"
                                   class="form-control form-control-sm bg-light"
                                   readonly
                                   placeholder="Auto-filled" />
                        </div>

                 
                        <!-- Rejection Type -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Rejection Reason
                                <span class="text-primary">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-x-octagon"></i>
                                </span>
                                <select id="fRejectionId"
                                        class="form-select form-select-sm">
                                    <option value="0">
                                        -- Select Type --
                                    </option>
                                </select>
                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-rejection"></div>
                        </div>

                        <!-- Rejection Qty -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Rejection Qty
                                <span class="text-primary">*</span>
                            </label>
                            <input type="number" id="fRejectionQty"
                                   class="form-control form-control-sm"
                                   min="1" step="1" placeholder="0" />
                            <div class="invalid-feedback d-block"
                                 id="err-qty"></div>
                        </div>

                        <!-- Operator -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Operator
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-person-badge"></i>
                                </span>
                                <select id="fOperatorId"
                                        class="form-select form-select-sm">
                                    <option value="0">
                                        -- Select Operator --
                                    </option>
                                </select>
                            </div>
                        </div>

              

                        <!-- Actual Shot Weight -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Actual Shot Weight (g)
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-speedometer2"></i>
                                </span>
                                <input type="number" id="fActualShotWeight"
                                       class="form-control form-control-sm"
                                       min="0" step="0.01"
                                       placeholder="0.00" />
                            </div>
                            <div class="text-muted"
                                 style="font-size:0.62rem">
                                Std:
                                <span id="stdShotWeightLabel">—</span> g
                            </div>
                        </div>

                        <!-- Finish Weight -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Finish Weight (g)
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-box-seam"></i>
                                </span>
                                <input type="number" id="fFinishWeight"
                                       class="form-control form-control-sm"
                                       min="0" step="0.01"
                                       placeholder="0.00" />
                            </div>
                        </div>

                        <!-- Remark -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Remark
                            </label>
                            <input type="text" id="fRemark"
                                   class="form-control form-control-sm"
                                   placeholder="Optional remark" />
                        </div>

                    </div>

                    <!-- Edit lock note -->
                    <div class="mt-2" id="editLockNote"
                         style="display:none">
                        <div class="alert alert-warning py-1 mb-0 small">
                            <i class="bi bi-lock me-1"></i>
                            <strong>Edit mode:</strong>
                            All fields are editable.
                        </div>
                    </div>

                </form>
            </div>

            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary btn-sm"
                        id="btnSave">
                    <i class="bi bi-floppy me-1"></i>Save
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ── DELETE CONFIRM MODAL ── -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white py-2">
                <h6 class="modal-title mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Confirm Delete
                </h6>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center small">
                <p class="mb-1">Delete rejection record</p>
                <strong id="deleteLabel"></strong>?
            </div>
            <div class="modal-footer justify-content-center py-2">
                <button class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-danger btn-sm"
                        id="btnConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- ── TOAST ── -->
<div class="position-fixed top-0 end-0 p-3" style="z-index:9999">
    <div id="toast" class="toast align-items-center text-white border-0"
         role="alert" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body small" id="toastMsg"></div>
            <button type="button"
                    class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
$(function () {

    // ════════════════════════════════════════════
    // STATE
    // ════════════════════════════════════════════
    let allData         = [];
    let filteredData    = [];
    let currentPage     = 1;
    let rowsPerPage     = 10;
    let totalPages      = 1;
    let pendingDeleteId = null;
    let currentDeptId   = 0;
    let itemShotWeightMap = {};   // itemId → Std_Shot_Weight

    const rejModal    = new bootstrap.Modal($('#rejModal')[0]);
    const deleteModal = new bootstrap.Modal($('#deleteModal')[0]);
    const toastEl     = $('#toast')[0];
    const bsToast     = new bootstrap.Toast(toastEl, { delay: 3500 });

    // ════════════════════════════════════════════
    // INIT — load departments, shifts, rejection types
    // ════════════════════════════════════════════
    $.ajax({
        url: '/MachineRejection/GetDepartments',
        method: 'GET', dataType: 'json',
        success: function (depts) {

    let opts =
        '<option value="0">-- Select Department --</option>';

    depts.forEach(d => {
        opts += `
            <option value="${d.DepartmentId}">
                ${d.Department}
            </option>`;
    });

    $('#headerDeptFilter').html(opts);
    $('#fDepartmentId').html(opts); // Add this
}
    });

    $.ajax({
        url: '/MachineRejection/GetShifts',
        method: 'GET', dataType: 'json',
        success: function (shifts) {
            let opts = '<option value="0">-- Select Shift --</option>';
            shifts.forEach(s => {
                opts += `<option value="${s.shiftId}">
                            ${s.shiftName}</option>`;
            });
            $('#fShiftId').html(opts);
        }
    });

    // $.ajax({
    //     url: '/MachineRejection/GetRejectionTypes',
    //     method: 'GET', dataType: 'json',
    //     success: function (types) {
    //         let opts =
    //             '<option value="0">-- Select Type --</option>';
    //         types.forEach(t => {
    //             opts += `<option value="${t.rejectionId}">
    //                         ${t.rejection_Type}</option>`;
    //         });
    //         $('#fRejectionId').html(opts);
    //     }
    // });

       

    // ════════════════════════════════════════════
    // LOAD MODAL DROPDOWNS
    // ════════════════════════════════════════════
    function loadModalDropdowns(deptId) {
        itemShotWeightMap = {};

        // Machines
        $.ajax({
            url: '/MachineRejection/GetMachinesByDept?deptId=' + deptId,
            method: 'GET', dataType: 'json',
            success: function (machines) {
                let opts =
                    '<option value="0">-- Select Machine --</option>';
                machines.forEach(m => {
                    opts += `<option value="${m.machineId}">
                                ${m.machineName}</option>`;
                });
                $('#fMachineId').html(opts);
            }
        });

        // Items
        $.ajax({
            url: '/MachineRejection/GetItemsByDept?deptId=' + deptId,
            method: 'GET', dataType: 'json',
            success: function (items) {
                let opts =
                    '<option value="0">-- Select Item --</option>';
                items.forEach(i => {
                    itemShotWeightMap[i.itemId] = i.std_Shot_Weight;
                    opts += `<option value="${i.itemId}"
                                     data-desc="${i.item_Description}"
                                     data-sw="${i.std_Shot_Weight}">
                                ${i.item_Code}</option>`;
                });
                $('#fItemId').html(opts);
                setTimeout(() => {
    applyItemSelect2();
}, 100);
            }
        });

        // Operators
        $.ajax({
            url: '/MachineRejection/GetOperatorsByDept?deptId=' + deptId,
            method: 'GET', dataType: 'json',
            success: function (ops) {
                let opts =
                    '<option value="0">-- Select Operator --</option>';
                ops.forEach(o => {
                    opts += `<option value="${o.operatorId}">
                                ${o.operatorName}</option>`;
                });
                $('#fOperatorId').html(opts);
            }
        });
    }
    // ════════════════════════════════════════════
// DEPARTMENT CHANGE
// ════════════════════════════════════════════
// window.onDepartmentChange = function () {

//     const deptId =
//         parseInt($('#fDepartmentId').val()) || 0;

//     if (!deptId) return;

//     loadModalDropdowns(deptId);
// };
        window.onDepartmentChange = function () {

        const deptId =
        parseInt($('#fDepartmentId').val()) || 0;

        if (!deptId) return;

        loadModalDropdowns(deptId);

        // Load Rejection Types
        $.ajax({
        url: '/MachineRejection/GetRejectionTypes?deptId=' + deptId,
        method: 'GET',
        dataType: 'json',
        success: function (types) {

        let opts =
        '<option value="0">-- Select Type --</option>';

        types.forEach(t => {
        opts += `<option value="${t.rejectionId}">
        ${t.rejection_Type}
        </option>`;
        });

        $('#fRejectionId').html(opts);
        }
        });
        };
    // ════════════════════════════════════════════
    // ITEM CHANGE → description + std shot weight
    // ════════════════════════════════════════════
    window.onItemChange = function () {
        const sel    = $('#fItemId')[0];
        const opt    = sel.options[sel.selectedIndex];
        const desc   = opt.getAttribute('data-desc') || '';
        const sw     = opt.getAttribute('data-sw')   || '0';

        $('#fItemDesc').val(desc);
        $('#stdShotWeightLabel').text(
            parseFloat(sw) > 0 ? parseFloat(sw).toFixed(2) : '—');

        // Pre-fill actual shot weight with std value
        if (parseFloat(sw) > 0)
            $('#fActualShotWeight').val(parseFloat(sw).toFixed(2));
    };

    // ════════════════════════════════════════════
    // LOAD DATA
    // ════════════════════════════════════════════
    function loadData() {
        $('#loadingRow').show()
            .find('td').html(
                '<div class="spinner-border spinner-border-sm ' +
                'text-primary me-2"></div>Loading...');
        $('#tableBody tr:not(#loadingRow)').remove();

        $.ajax({
            url: '/MachineRejection/GetAll?deptId=' + currentDeptId,
            method: 'GET', dataType: 'json',
            success: function (data) {
                allData = data;
                applyFilter();
                $('#loadingRow').hide();
            },
            error: function () {
                $('#loadingRow td').html(
                    '<i class="bi bi-exclamation-triangle ' +
                    'text-primary me-1"></i>Failed to load data.');
            }
        });
    }

    // ════════════════════════════════════════════
    // RENDER TABLE
    // ════════════════════════════════════════════
    function renderTable() {
        totalPages = Math.max(1,
            Math.ceil(filteredData.length / rowsPerPage));
        if (currentPage > totalPages) currentPage = totalPages;

        const start = (currentPage - 1) * rowsPerPage;
        const end   = Math.min(start + rowsPerPage, filteredData.length);
        const slice = filteredData.slice(start, end);

        $('#tableBody tr:not(#loadingRow)').remove();

        if (slice.length === 0) {

            $('#tableBody').append(
                `<tr><td colspan="13"
                    class="text-center text-muted py-3">
                    No records found.
                 </td></tr>`);
        } else {
            slice.forEach((r, i) =>
                $('#tableBody').append(buildRow(r, start+i+1)));
        }



        updatePagination(start, end);
    }

    function buildRow(r, sr) {
        const fmt  = v => v || '—';
        const fmtN = (v, d=2) =>
            v > 0 ? parseFloat(v).toFixed(d) : '—';

        return `
        <tr id="row-${r.SrNo}">
            <td class="text-center">${sr}</td>
            <td>
                <span class="badge bg-dark" style="font-size:0.60rem">
                    ${fmt(r.DepartmentName)}
                </span>
            </td>
            <td class="text-center">${fmt(r.Add_Date)}</td>
            <td>${fmt(r.ShiftName)}</td>
            <td>${fmt(r.MachineName)}</td>
            <td class="fw-bold text-primary">${fmt(r.Item_Code)}</td>
            <td title="${fmt(r.Item_Description)}">
                ${fmt(r.Item_Description)}
            </td>
            <td>${fmt(r.Rejection_Reason)}</td>
            <td class="text-center fw-bold text-primary fs-6">
                ${r.Rejection_Qty ?? '—'}
            </td>
            <td class="text-end pe-2">
                ${fmtN(r.Actual_Shot_Weight)}
            </td>
            <td class="text-end pe-2">
                ${fmtN(r.Finish_Weight)}
            </td>
            <td title="${fmt(r.Remark)}">${fmt(r.Remark)}</td>
            <td class="text-center">
                <button class="btn btn-outline-primary btn-sm btn-edit"
                        data-id="${r.SrNo}" title="Edit">
                    <i class="bi bi-pencil-square"></i>
                </button>
                <button class="btn btn-outline-danger btn-sm btn-del"
                        data-id="${r.SrNo}"
                        data-label="${fmt(r.Item_Code)} / ${fmt(r.Rejection_Reason)}"
                        title="Delete">
                    <i class="bi bi-trash3"></i>
                </button>
            </td>
        </tr>`;
    }

    // ════════════════════════════════════════════
    // FILTER
    // ════════════════════════════════════════════
    window.applyFilter = function () {
        const q = $('#searchInput').val().toLowerCase().trim();
        filteredData = allData.filter(r =>
            !q ||
            (r.item_Code        || '').toLowerCase().includes(q) ||
            (r.item_Description || '').toLowerCase().includes(q) ||
            (r.machineName      || '').toLowerCase().includes(q) ||
            (r.shiftName        || '').toLowerCase().includes(q) ||
            (r.rejection_Type   || '').toLowerCase().includes(q) ||
            (r.operatorName     || '').toLowerCase().includes(q)
        );
        currentPage = 1;
        renderTable();
    };

    // ════════════════════════════════════════════
    // PAGINATION
    // ════════════════════════════════════════════
    function updatePagination(start, end) {
        $('#pageInfo').text(
            filteredData.length === 0
                ? 'No records'
                : `${start+1}–${end} of ${filteredData.length}`);

        $('#btnFirst,#btnPrev').prop('disabled', currentPage === 1);
        $('#btnNext,#btnLast').prop('disabled',  currentPage === totalPages);

        const container = $('#pageNumbers').empty();
        const maxV = 5;
        let sp = Math.max(1, currentPage - Math.floor(maxV/2));
        let ep = Math.min(totalPages, sp + maxV - 1);
        if (ep - sp < maxV - 1) sp = Math.max(1, ep - maxV + 1);

        for (let p = sp; p <= ep; p++) {
            $('<button>').text(p)
                .addClass('btn btn-outline-secondary btn-sm'
                    + (p === currentPage ? ' active-pg' : ''))
                .on('click', () => goToPage(p))
                .appendTo(container);
        }
    }

    window.goToPage = function (p) {
        if (p < 1 || p > totalPages) return;
        currentPage = p; renderTable();
    };
    window.changeRPP = function () {
        rowsPerPage = parseInt($('#rppSelect').val());
        currentPage = 1; renderTable();
    };

    // ════════════════════════════════════════════
    // ADD MODAL
    // ════════════════════════════════════════════
