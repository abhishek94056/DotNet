});

        setTimeout(function () {

        $('#fMachineId').val(r.MachineId);

        $('#fItemId')
        .val(r.ItemId)
        .trigger('change');

        $('#fOperatorId').val(r.OperatorId);

        }, 500);
        $('#fShiftId').val(r.ShiftId);
        $('#fMachineId').val(r.MachineId);
        $('#fItemId').val(r.ItemId);
        $('#fItemDesc').val(r.Item_Description);
        $('#fRejectionId').val(r.RejectionId);
        $('#fRejectionQty').val(r.Rejection_Qty);
        $('#fOperatorId').val(r.OperatorId);
        $('#fActualShotWeight').val(r.Actual_Shot_Weight);
        $('#fFinishWeight').val(r.Finish_Weight);
        $('#fRemark').val(r.Remark);
        $('#fDate').val(
            r.Add_Date
                ? r.Add_Date.split('-').reverse().join('-') : '');

        // Show std shot weight hint
        const sw = itemShotWeightMap[r.ItemId] || 0;
        $('#stdShotWeightLabel').text(sw > 0 ? sw.toFixed(2) : '—');

        rejModal.show();
    });

    // ════════════════════════════════════════════
    // SAVE
    // ════════════════════════════════════════════
    $('#btnSave').on('click', function () {
        clearErrors();

        const shiftId    = parseInt($('#fShiftId').val())      || 0;
        const machId     = parseInt($('#fMachineId').val())     || 0;
        const itemId     = parseInt($('#fItemId').val())        || 0;
        const rejId      = parseInt($('#fRejectionId').val())   || 0;
        const rejQty     = parseInt($('#fRejectionQty').val())  || 0;
        const date       = $('#fDate').val();

        let valid = true;
        if (!shiftId) {
            showError('fShiftId','err-shift','Shift required.');
            valid = false;
        }
        if (!machId) {
            showError('fMachineId','err-machine','Machine required.');
            valid = false;
        }
        if (!itemId) {
            showError('fItemId','err-item','Item required.');
            valid = false;
        }
        if (!rejId) {
            showError('fRejectionId','err-rejection',
                'Rejection Reason required.');
            valid = false;
        }
        if (rejQty <= 0) {
            showError('fRejectionQty','err-qty',
                'Rejection Qty must be > 0.');
            valid = false;
        }
        if (!date) {
            showError('fDate','err-date','Date required.');
            valid = false;
        }
        if (!valid) return;

        const token =
            $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url:      '/MachineRejection/Save',
            method:   'POST',
            dataType: 'json',
            data: {
                SrNo:               $('#fSrNo').val(),
                ShiftId:            shiftId,
                MachineId:          machId,
                ItemId:             itemId,
                OperatorId:         parseInt($('#fOperatorId').val()) || 0,
                RejectionId:        rejId,
                Rejection_Qty:      rejQty,
                Date:               date,
                DepartmentId:       $('#fDepartmentId').val(),
                Actual_Shot_Weight: $('#fActualShotWeight').val() || 0,
                Finish_Weight:      $('#fFinishWeight').val()     || 0,
                Remark:             $('#fRemark').val(),
                __RequestVerificationToken: token
            },
            success: function (d) {
                if (!d.success) {
                    showToast(d.message || 'Save failed.', 'danger');
                    return;
                }
                rejModal.hide();
                showToast(d.message, 'success');
                loadData();
            },
            error: function () {
                showToast('Network error.', 'danger');
            }
        });
    });

    // ════════════════════════════════════════════
    // DELETE
    // ════════════════════════════════════════════
    $(document).on('click', '.btn-del', function () {
        pendingDeleteId = parseInt($(this).data('id'));
        $('#deleteLabel').text($(this).data('label'));
        deleteModal.show();
    });

    $('#btnConfirmDelete').on('click', function () {
        const token =
            $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url:      '/MachineRejection/Delete',
            method:   'POST',
            dataType: 'json',
            data: { srNo: pendingDeleteId,
                    __RequestVerificationToken: token },
            success: function (d) {
                deleteModal.hide();
                if (d.success) {
                    allData      = allData.filter(
                        r => r.SrNo !== pendingDeleteId);
                    filteredData = filteredData.filter(
                        r => r.SrNo !== pendingDeleteId);
                    renderTable();
                    showToast('Rejection record deleted.', 'success');
                } else {
                    showToast('Delete failed.', 'danger');
                }
            },
            error: function () {
                showToast('Network error.', 'danger');
            }
        });
    });
    // ════════════════════════════════════════════
// DEPARTMENT CHANGE
// ════════════════════════════════════════════
$('#headerDeptFilter').on('change', function () {

    currentDeptId = parseInt($(this).val()) || 0;

    if (!currentDeptId) {

        $('#tableBody').html(`
            <tr id="loadingRow">
                <td colspan="13" class="text-center text-muted py-3">
                    Select a Department.
                </td>
            </tr>
        `);

        return;
    }


    // ONLY LOAD GRID DATA
    loadData();
});
    // ════════════════════════════════════════════
    // HELPERS
    // ════════════════════════════════════════════
    function clearForm() {
        $('#fSrNo').val('0');
        $('#fDepartmentId,#fShiftId,#fMachineId,#fItemId,#fRejectionId,#fOperatorId')
    .val('0');
        $('#fItemDesc,#fRemark').val('');
        $('#fRejectionQty,#fActualShotWeight,#fFinishWeight').val('');
        $('#fDate').val('');
        $('#stdShotWeightLabel').text('—');
        clearErrors();
    }

    function clearErrors() {
        $('.invalid-feedback.d-block').text('');
        $('#rejForm .form-control, #rejForm .form-select')
            .removeClass('is-invalid');
    }

    function showError(fieldId, errId, msg) {
        $('#' + fieldId).addClass('is-invalid');
        $('#' + errId).text(msg);
    }

    function showToast(msg, type) {
        toastEl.className =
            `toast align-items-center text-white border-0 bg-${type}`;
        $('#toastMsg').text(msg);
        bsToast.show();
    }
