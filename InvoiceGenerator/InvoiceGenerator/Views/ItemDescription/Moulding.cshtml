</div>

<div class="col-md-3">
    <label class="form-label fw-semibold small">No of Cavity</label>
    <div class="input-group input-group-sm">
        <span class="input-group-text"><i class="bi bi-grid"></i></span>
        <input type="number" id="fCavity" class="form-control" placeholder="No"/>
    </div>
</div>

<div class="col-md-3">
    <label class="form-label fw-semibold small">Std Shot Weight<span class="text-danger">*</span></label>
