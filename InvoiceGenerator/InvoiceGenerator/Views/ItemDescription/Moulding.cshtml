@{
    ViewData["Title"] = "Moulding Master";
}
@Html.AntiForgeryToken()
<style>
    :root {
        --header-bg: #1a1a2e;
        --row-odd: #f8f9fa;
        --row-even: #eef2ff;
        --row-hover: #cfe2ff;
        --accent: #0d6efd;
        --sec-hdr-bg: #343a40;
    }

    /* =========================================
       PAGE HEADER
    ========================================= */

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 10px;
        flex-wrap: wrap;
    }

        .page-header h6 {
            margin: 0;
            font-weight: 700;
            white-space: nowrap;
        }

    .header-controls {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 6px;
        flex-wrap: wrap;
        flex: 1;
    }

        .header-controls .form-select,
        .header-controls .form-control,
        .header-controls .btn {
            width: auto;
        }

    /* =========================================
       TABLE
    ========================================= */

    #itemTable {
        font-size: 0.70rem;
    }

        #itemTable thead th {
            font-size: 0.67rem;
            padding: 4px 5px;
            white-space: nowrap;
            text-align: center;
            background: var(--header-bg);
            color: #fff;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        #itemTable tbody td {
            padding: 3px 5px;
            vertical-align: middle;
            white-space: nowrap;
        }

        #itemTable tbody tr:nth-child(odd) td {
            background-color: var(--row-odd);
        }

        #itemTable tbody tr:nth-child(even) td {
            background-color: var(--row-even);
        }

        #itemTable tbody tr:hover td {
            background-color: var(--row-hover) !important;
            cursor: pointer;
            transition: background-color .15s;
        }

        #itemTable .btn-sm {
            padding: 1px 4px;
            font-size: .65rem;
        }

    /* =========================================
       TABLE WRAPPER
    ========================================= */

    .table-wrap {
        max-height: 480px;
        overflow: auto;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        width: 100%;
        -webkit-overflow-scrolling: touch;
    }

    #itemTable {
        min-width: 1700px;
        width: max-content;
    }

    /* =========================================
       PAGINATION
    ========================================= */

    .pagination-bar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 8px;
        font-size: .73rem;
    }

        .pagination-bar button {
            min-width: 28px;
            height: 26px;
            font-size: .68rem;
            padding: 0 5px;
            border-radius: 4px;
        }

            .pagination-bar button.active-page {
                background: var(--accent);
                color: #fff;
                border-color: var(--accent);
            }

    /* =========================================
       FORM SECTION
    ========================================= */

    .form-section-title {
        font-size: .72rem;
        font-weight: 700;
        color: #fff;
        background: var(--sec-hdr-bg);
        padding: 4px 10px;
        border-radius: 4px;
        margin-bottom: 8px;
    }

    /* =========================================
       MODAL
    ========================================= */

    .modal-xl {
        max-width: 95%;
    }

    .modal-body {
        overflow-x: hidden;
    }

    #itemForm .row {
        margin-left: 0;
        margin-right: 0;
    }

    /* =========================================
       MOBILE
    ========================================= */

    @@media (max-width:575px) {

        .page-header {
            flex-direction: column;
            align-items: stretch;
        }

        .header-controls {
            flex-direction: column;
            align-items: stretch;
            width: 100%;
        }

            .header-controls .form-select,
            .header-controls .form-control,
            .header-controls .btn {
                width: 100% !important;
            }

        .pagination-bar {
            justify-content: center;
        }

        #pageNumbers {
            flex-wrap: wrap;
        }

        .modal-dialog {
            margin: .5rem;
        }

        .modal-xl {
            max-width: 100%;
        }

        #itemForm .col-md-3 {
            width: 100%;
        }
    }

    /* =========================================
       TABLET
    ========================================= */

    @@media (min-width:576px) and (max-width:991px) {

        #itemForm .col-md-3 {
            width: 50%;
        }
    }
</style>

<!-- ── PAGE HEADER ── -->
<div class="page-header">
    <h6 class="mb-0 fw-bold">
        <i class="bi bi-bounding-box me-2 text-primary"></i>
        Moulding Master
    </h6>
    <div class="header-controls">

        <select id="deptFilter" class="form-select form-select-sm"
                style="width:150px" onchange="applyFilter()">
            <option value="">All Departments</option>
        </select>

        <input type="text" id="searchInput"
               class="form-control form-control-sm"
               placeholder="🔍 Search code / desc..."
               style="width:180px"
               oninput="applyFilter()" />

        <button class="btn btn-primary btn-sm" id="btnAddItem">
            <i class="bi bi-plus-lg me-1"></i>Add Item
        </button>
    </div>
</div>

<!-- ── TABLE ── -->
<div class="table-wrap">
    <table class="table table-bordered mb-0" id="itemTable">
       <thead>
<tr>
    <th>#</th>
    <th>Department</th>
    <th>Machine</th>
    <th>Item Code</th>
    <th>Description</th>
    <th>Cycle Time</th>
    <th>No of Cavity</th>
    <th>Std. Shot Weight</th>
    <th>Remark</th>
    <th>Finish Weight</th>
    <th>Remark</th>
    <th>MRP Rate RM</th>
    <th>Remark</th>
    <th>MRP Rate Sale</th>
    <th>Remark</th>
    <th>RM Type</th>
    <th>Opening Stock</th>
    <th>MIN Qty.</th>
    <th>MAX Qty.</th>
    <th>Packing Type</th>
    <th>Packing Qty.</th>
    <th>Sale Transport</th>
    <th>Action</th>
</tr>
</thead>
<tbody id="tableBody">
            <tr id="loadingRow">
                <td colspan="23">
                    <div class="spinner-border spinner-border-sm text-primary me-2"></div>
                    Loading data...
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- ── PAGINATION ── -->
<div class="pagination-bar">
    <span id="pageInfo" class="text-muted"></span>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnFirst" onclick="goToPage(1)">«</button>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnPrev"  onclick="goToPage(currentPage-1)">‹</button>
    <span id="pageNumbers" class="d-flex gap-1 flex-wrap"></span>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnNext"  onclick="goToPage(currentPage+1)">›</button>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnLast"  onclick="goToPage(totalPages)">»</button>
    <select id="rppSelect" class="form-select form-select-sm"
            style="width:75px" onchange="changeRPP()">
        <option value="10" selected>10</option>
        <option value="20">20</option>
        <option value="50">50</option>
    </select>
    <span class="text-muted">/ page</span>
</div>

<!-- ══════════════════════════════════════════════
     ADD / EDIT MODAL  (tabbed sections)
══════════════════════════════════════════════ -->
<div class="modal fade" id="itemModal" tabindex="-1">
<div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
<div class="modal-content">

<!-- HEADER -->
<div class="modal-header bg-dark text-white py-2">
    <h6 class="modal-title mb-0">
        <i class="bi bi-box-seam me-2"></i>
        <span id="modalTitleText">Add Item</span>
    </h6>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
</div>

<!-- BODY -->
<div class="modal-body">
<form id="itemForm">

<input type="hidden" id="fItemId" value="0"/>

<div class="row g-2">


<!-- Department -->
<div class="col-md-3">
    <label class="form-label fw-semibold small">Department <span class="text-danger">*</span></label>
    <div class="input-group input-group-sm">
        <span class="input-group-text"><i class="bi bi-building"></i></span>
