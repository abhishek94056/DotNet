@using InvoiceGenerator.Helper
@{
    ViewData["Title"] = "Customer PO Schedule";
}
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<style>
    /* ════════════════════════════════════════
       CSS VARIABLES
    ════════════════════════════════════════ */
    :root {
        --header-bg: #1a1a2e;
        --row-odd: #f8f9fa;
        --row-even: #eef2ff;
        --row-hover: #cfe2ff;
        --font-xs: 0.72rem;
        --font-xxs: 0.69rem;
        --font-tiny: 0.67rem;
    }

    /* ════════════════════════════════════════
       PAGE HEADER
    ════════════════════════════════════════ */
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 10px;
    }

        .page-header h6 {
            margin: 0;
            font-weight: 700;
            white-space: nowrap;
            word-break: break-word;
        }

    .header-controls {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
    }

        .header-controls select,
        .header-controls input[type="text"] {
            font-size: 0.78rem;
        }

    /* ════════════════════════════════════════
       TABLE
    ════════════════════════════════════════ */
    .data-table {
        width: 100%;
        min-width: 1100px;
        font-size: var(--font-xs);
    }

        .data-table thead th {
            font-size: 0.68rem;
            padding: 4px 6px;
            white-space: nowrap;
            text-align: center;
            background: var(--header-bg);
            color: #fff;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        .data-table tbody td {
            padding: 3px 6px;
            vertical-align: middle;
            white-space: nowrap;
        }

        .data-table tbody tr:nth-child(odd) td {
            background-color: var(--row-odd);
        }

        .data-table tbody tr:nth-child(even) td {
            background-color: var(--row-even);
        }

        .data-table tbody tr:hover td {
            background-color: var(--row-hover) !important;
            cursor: pointer;
            transition: background-color 0.15s;
        }

        .data-table .btn-sm {
            padding: 1px 5px;
            font-size: var(--font-tiny);
        }
    /* ════════════════════════════════════════
       SELECT2
    ════════════════════════════════════════ */
    .select2-wrapper {
        flex: 1 1 auto;
        width: 100%;
    }

    .select2-container {
        width: 100% !important;
    }

    .select2-container--default .select2-selection--single {
        height: 31px !important;
        border: 1px solid #ced4da !important;
        border-radius: 0 .25rem .25rem 0 !important;
        display: flex !important;
        align-items: center !important;
    }

    .select2-selection__rendered {
        line-height: normal !important;
        display: flex !important;
        align-items: center !important;
        height: 100%;
        padding-left: 6px !important;
    }

    .select2-selection__arrow {
        height: 100% !important;
        top: 0 !important;
    }
    /* ════════════════════════════════════════
       TABLE WRAPPER
    ════════════════════════════════════════ */
    .table-wrap {
        max-height: 460px;
        overflow-y: auto;
        overflow-x: auto;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        -webkit-overflow-scrolling: touch;
    }

    /* ════════════════════════════════════════
       PAGINATION
    ════════════════════════════════════════ */
    .pagination-bar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 8px;
        font-size: 0.73rem;
    }

        .pagination-bar button {
            min-width: 28px;
            height: 26px;
            font-size: 0.68rem;
            padding: 0 5px;
            border-radius: 4px;
        }

            .pagination-bar button.active-pg {
                background: #0d6efd;
                color: #fff;
                border-color: #0d6efd;
            }

    /* ════════════════════════════════════════
       SUMMARY STRIP
    ════════════════════════════════════════ */
    .po-summary {
        background: linear-gradient(135deg,#1a3a4e,#2d6a8e);
        color: #fff;
        border-radius: 6px;
        padding: 6px 14px;
        font-size: 0.71rem;
        margin-bottom: 8px;
    }

        .po-summary .val {
            font-size: 1rem;
            font-weight: 700;
            color: #7ec8e3;
        }

    /* ════════════════════════════════════════
       STATUS BADGES
    ════════════════════════════════════════ */
    .badge-overdue {
        background: #dc3545;
        color: #fff;
    }

    .badge-due-soon {
        background: #ffc107;
        color: #000;
    }

    .badge-ok {
        background: #198754;
        color: #fff;
    }

    /* ════════════════════════════════════════
       LOADING
    ════════════════════════════════════════ */
    #loadingRow td {
        text-align: center;
        padding: 20px;
        color: #888;
    }

    /* ════════════════════════════════════════
       MODAL
    ════════════════════════════════════════ */
    .modal .form-label {
        margin-bottom: 3px;
    }

    .modal .input-group-text {
        height: 31px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal .form-control-sm,
    .modal .form-select-sm {
        font-size: 0.75rem;
    }

    /* ════════════════════════════════════════
       MOBILE RESPONSIVE
    ════════════════════════════════════════ */
    @@media (max-width:575px) {

        .page-header {
            flex-direction: column;
            align-items: stretch;
            overflow: hidden;
        }

            .page-header h6 {
                font-size: 0.90rem;
            }

        .header-controls {
            flex-direction: column;
            align-items: stretch;
        }

            .header-controls select,
            .header-controls input,
            .header-controls button {
                width: 100% !important;
            }

        .table-wrap {
            display: block;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .data-table {
            min-width: 1100px;
        }

        .pagination-bar {
            justify-content: center;
        }

            .pagination-bar #pageNumbers {
                flex-wrap: wrap;
            }

            .pagination-bar button {
                min-width: 30px;
            }

        #rppSelect {
            width: 75px !important;
        }

        .modal-dialog {
            margin: 0.5rem;
        }

        .modal .row > div {
            margin-bottom: 2px;
        }
    }

    /* ════════════════════════════════════════
       TABLET RESPONSIVE
    ════════════════════════════════════════ */
    @@media (min-width:576px) and (max-width:991px) {

        .page-header {
            align-items: flex-start;
        }

        .header-controls {
            justify-content: flex-end;
        }

        .data-table {
            min-width: 1000px;
        }

        .pagination-bar {
            justify-content: center;
        }
    }
</style>

<!-- ── PAGE HEADER ── -->
<div class="page-header">
    <h6 class="mb-0 fw-bold">
        <i class="bi bi-clipboard-check me-2 text-primary"></i>
        Customer PO Schedule
    </h6>
   <div class="header-controls">

        <select id="deptFilter" class="form-select form-select-sm"
                style="width:155px" onchange="onDeptChange()">
            <option value="">-- Department --</option>
        </select>

        <input type="text" id="searchInput"
               class="form-control form-control-sm"
               placeholder="🔍 Search..."
               style="width:160px" oninput="applyFilter()" />

        <button class="btn btn-primary btn-sm" id="btnAdd">
            <i class="bi bi-plus-lg me-1"></i>Add PO
        </button>
    </div>
</div>


<!-- ═══ TAB: PO SCHEDULE ═══ -->
<div id="panelSchedule">
    <div class="table-wrap">
        <table class="table table-bordered mb-0 data-table"
               id="scheduleTable">
            <thead>
    <tr>
        <th>#</th>
        <th>Department</th>
        <th>Customer</th>
        <th>PO Number</th>
        <th>Item Code</th>
        <th>Description</th>
        <th>Qty</th>
        <th>PO Date</th>
        <th>Delivery Date</th>
        <th>Plan Date</th>
        <th>Actions</th>
    </tr>
</thead>
            <tbody id="scheduleBody">
                <tr id="loadingRow">
                    <td colspan="11">
                        <i class="bi bi-info-circle text-primary me-2"></i>
                        Select a Department to load PO Schedule.
                    </td>
                </tr>
            </tbody>
            
        </table>
    </div>
    <div class="pagination-bar" id="schedPagination">
        <span id="pageInfo" class="text-muted"></span>
        <button class="btn btn-outline-secondary btn-sm"
                id="btnFirst" onclick="goToPage(1)">«</button>
        <button class="btn btn-outline-secondary btn-sm"
                id="btnPrev"  onclick="goToPage(currentPage-1)">‹</button>
        <span id="pageNumbers" class="d-flex gap-1"></span>
        <button class="btn btn-outline-secondary btn-sm"
                id="btnNext"  onclick="goToPage(currentPage+1)">›</button>
        <button class="btn btn-outline-secondary btn-sm"
                id="btnLast"  onclick="goToPage(totalPages)">»</button>
        <select id="rppSelect" class="form-select form-select-sm"
                style="width:75px" onchange="changeRPP()">
            <option value="10" selected>10</option>
            <option value="20">20</option>
            <option value="50">50</option>
        </select>
        <span class="text-muted">/ page</span>
    </div>
</div>



<!-- ══════════════════════════════════════════════
     ADD / EDIT MODAL
══════════════════════════════════════════════ -->
