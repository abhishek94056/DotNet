</div>

<!-- ── DELETE CONFIRM MODAL ── -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white py-2">
                <h6 class="modal-title mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Confirm Delete
                </h6>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center small">
                <p class="mb-1">Delete PO record</p>
                <strong id="deleteLabel"></strong>?
            </div>
            <div class="modal-footer justify-content-center py-2">
                <button class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-danger btn-sm"
                        id="btnConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- ── TOAST ── -->
<div class="position-fixed top-0 end-0 p-3" style="z-index:9999">
    <div id="toast" class="toast align-items-center text-white border-0"
         role="alert" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body small" id="toastMsg"></div>
            <button type="button"
                    class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
$(function () {

    // ════════════════════════════════════════════
    // STATE
    // ════════════════════════════════════════════
    let allData         = [];
    let filteredData    = [];
    let currentPage     = 1;
    let rowsPerPage     = 10;
    let totalPages      = 1;
    let pendingDeleteId = null;
    let currentDeptId   = 0;

    const poModal     = new bootstrap.Modal($('#poModal')[0]);
    const deleteModal = new bootstrap.Modal($('#deleteModal')[0]);
    const toastEl     = $('#toast')[0];
    const bsToast     = new bootstrap.Toast(toastEl, { delay: 3000 });

    // ════════════════════════════════════════════
    // LOAD DEPARTMENTS + CUSTOMERS on init
    // ════════════════════════════════════════════
    $.ajax({
    url: '/CustomerPOSchedule/GetDepartments',
    method: 'GET',
    dataType: 'json',
    success: function (depts) {

        let headerOpts =
            '<option value="">-- Department --</option>';

        let formOpts =
            '<option value="0">--Department--</option>';

        depts.forEach(d => {

            headerOpts += `
                <option value="${d.DepartmentId}">
                    ${d.Department}
                </option>`;

            formOpts += `
                <option value="${d.DepartmentId}">
                    ${d.Department}
                </option>`;
        });

        $('#deptFilter').html(headerOpts);
        $('#fDepartmentId').html(formOpts);
    }
});

    $.ajax({
        url: '/CustomerPOSchedule/GetCustomers',
        method: 'GET', dataType: 'json',
        success: function (custs) {
            let opts = '<option value="0">--Customer--</option>';
            custs.forEach(c => {
                opts += `<option value="${c.customerId}">
                            ${c.customer}</option>`;
            });
            $('#fCustomerId').html(opts);

        setTimeout(() => {
        applyCustomerSelect2();
        }, 100);
        }
    });

    // ════════════════════════════════════════════
    // DEPT CHANGE
    // ════════════════════════════════════════════
    window.onDeptChange = function () {
        currentDeptId = parseInt($('#deptFilter').val()) || 0;

        if (!currentDeptId) {
            allData = [];
            filteredData = [];
            renderSchedule();
            return;
        }


        // Load items for modal
        loadItems(currentDeptId);
        loadData();
    };
    window.onFormDepartmentChange = function () {

    const deptId =
        parseInt($('#fDepartmentId').val()) || 0;

    $('#fItemId').html(
        '<option value="0">-- Select Item --</option>'
    );

    if (!deptId) return;

    loadItems(deptId);
};
    // ── Load items for modal ──
    function loadItems(deptId) {
        $.ajax({
            url: '/CustomerPOSchedule/GetItemsByDept?deptId=' + deptId,
            method: 'GET', dataType: 'json',
            success: function (items) {
                let opts = '<option value="0">-- Select Item --</option>';
                items.forEach(i => {
                    opts += `
<option value="${i.itemId}"
        data-description="${i.item_Description}">
    ${i.item_Code}
</option>`;
                });
                $('#fItemId').html(opts);

        setTimeout(() => {
        applyItemSelect2();
        }, 100);
            }
        });
    }

    // ── Item change → fetch sale rate ──
    window.onItemChange = function () {

    const selected =
        $('#fItemId option:selected');

    const itemId =
        parseInt(selected.val()) || 0;

    const description =
        selected.data('description') || '';

    $('#fSizeDescription').val(description);

    if (!itemId) {
        $('#fPORate').val('');
        calcPOValue();
        return;
    }

    $.ajax({
        url: '/CustomerPOSchedule/GetItemRate?itemId=' + itemId,
        method: 'GET',
        dataType: 'json',
        success: function (d) {

            $('#fPORate').val(
                d.rate > 0
                    ? d.rate.toFixed(2)
                    : ''
            );

            calcPOValue();
        }
    });
};

    // ── Customer change (placeholder for future logic) ──
    window.onCustomerChange = function () { };

    // ── Live PO value ──
    window.calcPOValue = function () {
        const qty  = parseInt($('#fQuantity').val())   || 0;
        const rate = parseFloat($('#fPORate').val())   || 0;
        const val  = qty * rate;
        $('#fPOValue').text('₹ ' + val.toLocaleString('en-IN',
            { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
    };

    // ════════════════════════════════════════════
    // LOAD DATA (both tabs)
    // ════════════════════════════════════════════
    function loadData() {
        loadSchedule();
    }

    function loadSchedule() {
        $('#loadingRow').show()
            .find('td').html(
                '<div class="spinner-border spinner-border-sm ' +
                'text-primary me-2"></div>Loading...');
        $('#scheduleBody tr:not(#loadingRow)').remove();
      

        $.ajax({
            url: '/CustomerPOSchedule/GetAll?deptId=' + currentDeptId,
            method: 'GET', dataType: 'json',
            success: function (data) {
                allData = data;
                applyFilter();
                $('#loadingRow').hide();
            },
            error: function () {
                $('#loadingRow td').html(
                    '<i class="bi bi-exclamation-triangle ' +
                    'text-danger me-1"></i>Failed to load data.');
            }
        });
    }

    

    
    // ════════════════════════════════════════════
    // RENDER SCHEDULE TABLE
    // ════════════════════════════════════════════
    function renderSchedule() {
        totalPages = Math.max(1,
            Math.ceil(filteredData.length / rowsPerPage));
        if (currentPage > totalPages) currentPage = totalPages;

        const start = (currentPage - 1) * rowsPerPage;
        const end   = Math.min(start + rowsPerPage, filteredData.length);
        const slice = filteredData.slice(start, end);

        $('#scheduleBody tr:not(#loadingRow)').remove();

        if (slice.length === 0) {
            $('#scheduleBody').append(
                `<tr><td colspan="11"
                    class="text-center text-muted py-3">
                    No records found.
                 </td></tr>`);
        } else {
            slice.forEach((r, i) =>
                $('#scheduleBody').append(buildScheduleRow(r, start+i+1)));
           
        }

        updatePagination(start, end);
    }

    function buildScheduleRow(r, sr) {
        const fmt  = v => v || '—';
        const fmtM = v => v > 0
            ? '₹' + (v).toLocaleString('en-IN',
                { minimumFractionDigits: 2 }) : '—';

       

        const poValue = (r.quantity || 0) * (r.pO_Item_Rate || 0);

        return `
<tr id="row-${r.SrNo}">
    <td class="text-center">${sr}</td>

    <td>
        <span class="badge bg-dark" style="font-size:0.60rem">
        ${fmt(r.DepartmentName)}
        </span>
    </td>

    <td class="fw-bold text-primary">
        ${fmt(r.Customer)}
    </td>

    <td>${fmt(r.PO_Number)}</td>

    <td class="fw-bold text-warning">
        ${fmt(r.Item_Code)}
    </td>

    <td title="${fmt(r.Item_Description)}">
        ${fmt(r.Item_Description)}
    </td>

    <td class="text-center fw-bold">
        ${r.Quantity ?? '—'}
    </td>

    <td class="text-center">
        ${fmt(r.PO_Date)}
    </td>

    <td class="text-center">
        ${fmt(r.Delivery_Date)}
    </td>

    <td class="text-center text-info">
        ${fmt(r.Plan_Date)}
    </td>

    <td class="text-center">
        <button class="btn btn-outline-primary btn-sm btn-edit"
                data-id="${r.SrNo}" title="Edit">
            <i class="bi bi-pencil-square"></i>
        </button>

        <button class="btn btn-outline-danger btn-sm btn-del"
                data-id="${r.SrNo}"
                data-label="${fmt(r.PO_Number)} / ${fmt(r.Item_Code)}"
                title="Delete">
            <i class="bi bi-trash3"></i>
        </button>
    </td>
</tr>`;
    }

    // ════════════════════════════════════════════
    // FILTER
    // ════════════════════════════════════════════
    window.applyFilter = function () {
        const q = $('#searchInput').val().toLowerCase().trim();
        filteredData = allData.filter(r =>
            !q ||
            (r.DepartmentName   || '').toLowerCase().includes(q) ||
            (r.Customer         || '').toLowerCase().includes(q) ||
            (r.PO_Number        || '').toLowerCase().includes(q) ||
            (r.Item_Code        || '').toLowerCase().includes(q) ||
            (r.Item_Description || '').toLowerCase().includes(q)  ||
            (r.Quantity         || '').toString().toLowerCase().includes(q) ||
            (r.PO_Date          || '').toLowerCase().includes(q) ||
            (r.Delivery_Date    || '').toLowerCase().includes(q) ||
            (r.Plan_Date        || '').toLowerCase().includes(q)
        );
        currentPage = 1;
        renderSchedule();
    };

    // ════════════════════════════════════════════
    // PAGINATION
    // ════════════════════════════════════════════
    function updatePagination(start, end) {
        $('#pageInfo').text(
            filteredData.length === 0
                ? 'No records'
                : `${start+1}–${end} of ${filteredData.length}`);

        $('#btnFirst,#btnPrev').prop('disabled', currentPage === 1);
        $('#btnNext,#btnLast').prop('disabled',  currentPage === totalPages);

        const container = $('#pageNumbers').empty();
        const maxV = 5;
        let sp = Math.max(1, currentPage - Math.floor(maxV/2));
        let ep = Math.min(totalPages, sp + maxV - 1);
        if (ep - sp < maxV - 1) sp = Math.max(1, ep - maxV + 1);

        for (let p = sp; p <= ep; p++) {
            $('<button>').text(p)
                .addClass('btn btn-outline-secondary btn-sm'
                    + (p === currentPage ? ' active-pg' : ''))
                .on('click', () => goToPage(p))
                .appendTo(container);
        }
    }

    window.goToPage = function (p) {
        if (p < 1 || p > totalPages) return;
        currentPage = p; renderSchedule();
    };
    window.changeRPP = function () {
        rowsPerPage = parseInt($('#rppSelect').val());
        currentPage = 1; renderSchedule();
    };

    // ════════════════════════════════════════════
    // ADD MODAL
    // ════════════════════════════════════════════
    $('#btnAdd').on('click', function () {
        clearForm(false);   // false = add mode
        $('#modalTitleText').text('Add PO Schedule');
        
        $('#fPODate').val(new Date().toISOString().split('T')[0]);
        poModal.show();
    });

    // ════════════════════════════════════════════
    // EDIT — from allData (no extra AJAX)
    // ════════════════════════════════════════════
        $(document).on('click', '.btn-edit', function () {

        const id = parseInt($(this).data('id'));
        const r  = allData.find(x => x.SrNo === id);

        if (!r) return;

        clearForm(true);

        $('#modalTitleText').text('Edit PO Schedule');

        $('#fSrNo').val(r.SrNo);

        $('#fDepartmentId').val(r.DepartmentId);

        loadItems(r.DepartmentId);

        setTimeout(function () {

        $('#fCustomerId')
        .val(r.CustomerId)
        .prop('disabled', true);

        $('#fItemId')
        .val(r.ItemId)
        .prop('disabled', true);

        }, 300);

        $('#fPONumber').val(r.PO_Number);

        $('#fQuantity').val(r.Quantity);

        $('#fSizeDescription').val(r.Item_Description);

        $('#fPODate').val(
        r.PO_Date
        ? r.PO_Date.substring(0, 10)
        : ''
        );

        $('#fDeliveryDate').val(
        r.Delivery_Date
        ? r.Delivery_Date.substring(0, 10)
        : ''
        );

        poModal.show();
        });
    // ════════════════════════════════════════════
    // SAVE
    // ════════════════════════════════════════════
    $('#btnSave').on('click', function () {
        clearErrors();
        const departmentId = parseInt($('#fDepartmentId').val()) || 0;
        const customerId = parseInt($('#fCustomerId').val()) || 0;
        const itemId     = parseInt($('#fItemId').val())     || 0;
        const poNumber   = $('#fPONumber').val().trim();
        const quantity   = parseInt($('#fQuantity').val())   || 0;
        const poDate     = $('#fPODate').val();
        const delDate    = $('#fDeliveryDate').val();

        let valid = true;
        if (!departmentId) {
        showError('fDepartmentId','err-dept','Department required.');
        valid = false;
        }

        if (!customerId) {
            showError('fCustomerId','err-customer','Customer required.');
            valid = false;
        }
        if (!poNumber) {
            showError('fPONumber','err-po','PO Number required.');
            valid = false;
        }
        if (!itemId) {
            showError('fItemId','err-item','Item required.');
            valid = false;
        }
        if (quantity <= 0) {
            showError('fQuantity','err-qty','Quantity must be > 0.');
            valid = false;
        }
        if (!poDate) {
            showError('fPODate','err-podate','PO Date required.');
            valid = false;
        }
        if (!delDate) {
            showError('fDeliveryDate','err-delivery',
                'Delivery Date required.');
            valid = false;
        }
        if (!valid) return;

        const token =
            $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url:      '/CustomerPOSchedule/Save',
            method:   'POST',
            dataType: 'json',
            data: {
                SrNo:         $('#fSrNo').val(),
                CustomerId:   customerId,
                PO_Number:    poNumber,
                ItemId:       itemId,
                Quantity:     quantity,
                PO_Item_Rate: $('#fPORate').val() || 0,
                PO_Date:      poDate,
                Delivery_Date: delDate,
                DepartmentId: departmentId,
                __RequestVerificationToken: token
            },
            success: function (d) {
                if (!d.success) {
                    showToast(d.message || 'Save failed.', 'danger');
                    return;
                }
                poModal.hide();
                showToast(d.message, 'success');
                loadData();
            },
            error: function () {
                showToast('Network error.', 'danger');
            }
        });
    });

    // ════════════════════════════════════════════
    // DELETE
    // ════════════════════════════════════════════
    $(document).on('click', '.btn-del', function () {
        pendingDeleteId = parseInt($(this).data('id'));
        $('#deleteLabel').text($(this).data('label'));
        deleteModal.show();
    });

    $('#btnConfirmDelete').on('click', function () {
        const token =
            $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url:      '/CustomerPOSchedule/Delete',
            method:   'POST',
            dataType: 'json',
            data: { srNo: pendingDeleteId,
                    __RequestVerificationToken: token },
            success: function (d) {
                deleteModal.hide();
                if (d.success) {
                    allData      = allData.filter(
                        r => r.SrNo !== pendingDeleteId);
                    filteredData = filteredData.filter(
                        r => r.SrNo !== pendingDeleteId);
                    renderSchedule();
                    showToast('PO Record deleted.', 'success');
                } else {
                    showToast('Delete failed.', 'danger');
                }
            },
            error: function () {
                showToast('Network error.', 'danger');
            }
        });
    });

    // ════════════════════════════════════════════
    // HELPERS
    // ════════════════════════════════════════════
    function clearForm(isEdit) {
        $('#fSrNo').val('0');
        $('#fDepartmentId').val('0');
        $('#fCustomerId').val('0').prop('disabled', false);
        $('#fPONumber').val('');
        $('#fItemId').val('0').prop('disabled', false);
        $('#fQuantity').val('');
        $('#fSizeDescription').val('');
        $('#fPORate').val('');
        $('#fPODate').val('');
        $('#fDeliveryDate').val('');
        $('#fPOValue').text('₹ 0.00');
        clearErrors();
    }

    function clearErrors() {
        $('.invalid-feedback.d-block').text('');
        $('#poForm .form-control, #poForm .form-select')
            .removeClass('is-invalid');
    }

    function showError(fieldId, errId, msg) {
        $('#' + fieldId).addClass('is-invalid');
        $('#' + errId).text(msg);
    }

    function showToast(msg, type) {
        toastEl.className =
            `toast align-items-center text-white border-0 bg-${type}`;
        $('#toastMsg').text(msg);
        bsToast.show();
    }
        function applyCustomerSelect2() {

        if ($('#fCustomerId').hasClass("select2-hidden-accessible")) {
        $('#fCustomerId').select2('destroy');
        }

        $('#fCustomerId').select2({
        placeholder: "Search Customer",
        width: 'resolve',
        dropdownParent: $('#poModal')
        });
        }

        function applyItemSelect2() {

        if ($('#fItemId').hasClass("select2-hidden-accessible")) {
        $('#fItemId').select2('destroy');
        }

        $('#fItemId').select2({
        placeholder: "Search Item",
        width: 'resolve',
        dropdownParent: $('#poModal')
        });
        }
    // ── INIT ──
    // Load on page ready — wait for dept selection before data

});
</script>
