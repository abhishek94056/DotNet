                        </div> *@

                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">
                                Quantity <span class="text-danger">*</span>
                            </label>

                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-hash"></i>
