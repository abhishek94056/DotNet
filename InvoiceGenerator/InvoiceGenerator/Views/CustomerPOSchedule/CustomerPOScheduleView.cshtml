                                    </select>
                                </div>
                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-item"></div>
                        </div>
                        <!-- Item Description -->
<div class="col-md-3">
    <label class="form-label fw-semibold small">
       Item Description
    </label>

    <div class="input-group input-group-sm">
        <span class="input-group-text">
            <i class="bi bi-card-text"></i>
        </span>

        <input type="text"
