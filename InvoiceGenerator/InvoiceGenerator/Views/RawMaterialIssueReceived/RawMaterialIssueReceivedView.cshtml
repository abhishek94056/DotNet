@using InvoiceGenerator.Helper
@{
    ViewData["Title"] = "RM Issue / Received";
}
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<style>
    :root {
        --header-bg: #1a1a2e;
        --row-odd: #f8f9fa;
        --row-even: #eef2ff;
        --row-hover: #cfe2ff;
    }

    /* HEADER */
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 10px;
    }

        .page-header h6 {
            margin: 0;
            font-weight: 700;
        }

    .header-controls {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
    }

    /* TABLE */
    #rmirTable {
        width: 100%;
        min-width: 1100px;
        font-size: 0.71rem;
    }

        #rmirTable thead th {
            font-size: 0.68rem;
            padding: 4px 6px;
            white-space: nowrap;
            text-align: center;
            background: var(--header-bg);
            color: #fff;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        #rmirTable tbody td {
            padding: 3px 6px;
            vertical-align: middle;
            white-space: nowrap;
        }

        #rmirTable tbody tr:nth-child(odd) td {
            background: var(--row-odd);
        }

        #rmirTable tbody tr:nth-child(even) td {
            background: var(--row-even);
        }

        #rmirTable tbody tr:hover td {
            background: var(--row-hover) !important;
        }

        #rmirTable .btn-sm {
            padding: 1px 5px;
            font-size: 0.67rem;
        }

    /* TABLE WRAPPER */
    .table-wrap {
        max-height: 460px;
        overflow-y: auto;
        overflow-x: auto;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        -webkit-overflow-scrolling: touch;
    }

    /* PAGINATION */
    .pagination-bar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 8px;
        font-size: 0.73rem;
    }

        .pagination-bar button {
            min-width: 28px;
            height: 26px;
            font-size: 0.68rem;
        }

            .pagination-bar button.active-pg {
                background: #0d6efd;
                color: #fff;
                border-color: #0d6efd;
            }


            .select2-wrapper {
    flex: 1 1 auto;
    width: 100%;
}

.select2-container {
    width: 100% !important;
}

.select2-container--default .select2-selection--single {
    height: 31px !important;
    border: 1px solid #ced4da !important;
    display: flex !important;
    align-items: center !important;
}

.select2-selection__rendered {
    line-height: normal !important;
    display: flex !important;
    align-items: center !important;
    height: 100%;
}

.select2-selection__arrow {
    height: 100% !important;
    top: 0 !important;
}


    /* STATUS BUTTONS */
    .rm-status-btn {
        border: 2px solid transparent;
        border-radius: 6px;
        padding: 8px 20px;
        font-size: .78rem;
        font-weight: 700;
        width: 100%;
    }

        .rm-status-btn.issue {
            background: #fff3cd;
            border-color: #ffc107;
            color: #856404;
        }

        .rm-status-btn.received {
            background: #d1fae5;
            border-color: #34d399;
            color: #065f46;
        }

        .rm-status-btn.issue.active {
            background: #ffc107;
            color: #000;
        }

        .rm-status-btn.received.active {
            background: #10b981;
            color: #fff;
        }

    /* SUMMARY */
    .rmir-summary {
        border-radius: 8px;
        padding: 8px 14px;
        font-size: .72rem;
    }

        .rmir-summary .val {
            font-size: 1rem;
            font-weight: 700;
        }

    /* MODAL */
    .modal .form-label {
        margin-bottom: 3px;
    }

    .modal .input-group-text {
        height: 31px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal .form-control-sm,
    .modal .form-select-sm {
        font-size: .75rem;
    }

    /* LOADING */
    #loadingRow td {
        text-align: center;
        padding: 20px;
        color: #888;
    }

    /* MOBILE */
    @@media (max-width:575px) {

        .page-header {
            flex-direction: column;
            align-items: stretch;
        }

        .header-controls {
            flex-direction: column;
            align-items: stretch;
        }

            .header-controls select,
            .header-controls input,
            .header-controls button {
                width: 100% !important;
            }

        #rmirTable {
            min-width: 1100px;
        }

        .pagination-bar {
            justify-content: center;
        }

            .pagination-bar #pageNumbers {
                flex-wrap: wrap;
            }

        .modal-dialog {
            margin: .5rem;
        }

        .modal .row > div {
            margin-bottom: 2px;
        }

        .rm-status-btn {
            padding: 8px 10px;
            font-size: .72rem;
        }
    }

    /* TABLET */
    @@media (min-width:576px) and (max-width:991px) {

        #rmirTable {
            min-width: 1050px;
        }

        .pagination-bar {
            justify-content: center;
        }
    }
</style>

<!-- ── PAGE HEADER ── -->
<div class="page-header">
    <h6 class="mb-0 fw-bold">
        <i class="bi bi-arrow-left-right me-2 text-primary"></i>
        Raw Material Issue / Received
    </h6>
    <div class="header-controls">

        <select id="deptFilter" class="form-select form-select-sm"
                style="width:160px" onchange="onDeptChange()">
            <option value="0">-- Department --</option>
        </select>

        <input type="text" id="searchInput"
               class="form-control form-control-sm"
               placeholder="🔍 Search..."
               style="width:155px" oninput="applyFilter()" />

        <button class="btn btn-primary btn-sm" id="btnAdd">
            <i class="bi bi-plus-lg me-1"></i>Add Entry
        </button>
    </div>
</div>


<!-- ── TABLE ── -->
<div class="table-wrap">
    <table class="table table-bordered mb-0" id="rmirTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Department</th>
                <th>Date</th>
                <th>Size Code</th>
                <th>Item Size</th>
                <th>Issue Qty</th>
                <th>Received Qty</th>
                <th>Balance</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="tableBody">
            <tr id="loadingRow">
                <td colspan="10">
                    <i class="bi bi-info-circle text-primary me-2"></i>
                    Select a Department to load records.
                </td>
            </tr>
        </tbody>
      
    </table>
</div>

<!-- ── PAGINATION ── -->
<div class="pagination-bar">
    <span id="pageInfo" class="text-muted"></span>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnFirst" onclick="goToPage(1)">«</button>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnPrev"  onclick="goToPage(currentPage-1)">‹</button>
    <span id="pageNumbers" class="d-flex gap-1"></span>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnNext"  onclick="goToPage(currentPage+1)">›</button>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnLast"  onclick="goToPage(totalPages)">»</button>
    <select id="rppSelect" class="form-select form-select-sm"
            style="width:75px" onchange="changeRPP()">
        <option value="10" selected>10</option>
        <option value="20">20</option>
        <option value="50">50</option>
    </select>
    <span class="text-muted">/ page</span>
</div>

<!-- ══════════════════════════════════════════════
     ADD / EDIT MODAL
══════════════════════════════════════════════ -->
<div class="modal fade" id="rmirModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-dark text-white py-2">
                <h6 class="modal-title mb-0">
                    <i class="bi bi-arrow-left-right me-2"></i>
                    <span id="modalTitleText">Add RM Issue / Received</span>
                </h6>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="rmirForm" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="fSrNo"         value="0" />
                  
                   
                   

                    <div class="row g-2">
                        <!-- Department -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Department <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-diagram-3"></i>
                                </span>
                                <select id="fDepartmentId"
                                        class="form-select form-select-sm">
                                    <option value="0">-- Select Department --</option>
                                </select>
                            </div>
                            <div class="invalid-feedback d-block" id="err-dept"></div>
                        </div>
                        <!-- ── STATUS TOGGLE ── -->
                   
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                RM Status
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-toggle-on"></i>
                                </span>
                                <select id="fRMStatus"
                                        class="form-select form-select-sm">
                                    <option value="0">-- Select RM Status --</option>
                                    <option value="1">RM Issue To Production</option>
                                    <option value="2">RM Received Back</option>
                                </select>
                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-status"></div>
                        </div>
                        <!-- Item Size — cascade from dept -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Item Size
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                              
                                <div class="select2-wrapper">
                                    <select id="fSizeId"
                                            class="form-select form-select-sm">
                                        <option value="0">
                                            -- Select Size --
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-size"></div>
                        </div>

                        @* Item Description *@

                        <div class="col-md-4">
    <label class="form-label fw-semibold small">
        Item Description
    </label>

    <div class="input-group input-group-sm">
        <span class="input-group-text">
            <i class="bi bi-card-text"></i>
        </span>

        <input type="text"
               id="fItemDescription"
               class="form-control form-control-sm bg-light"
               readonly />
    </div>
</div>

                        <!-- Quantity -->
                        <div class="col-md-4">
    <label class="form-label fw-semibold small">
        Quantity <span class="text-danger">*</span>
    </label>

    <div class="input-group input-group-sm">
        <span class="input-group-text">
            <i class="bi bi-box-seam"></i>
        </span>

        <input type="number"
               id="fQuantity"
               class="form-control form-control-sm"
               min="0.01"
               step="0.01"
               placeholder="0.00" />
    </div>

    <div class="invalid-feedback d-block"
         id="err-qty"></div>
</div>

                        <!-- Date -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Date
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-calendar3"></i>
                                </span>
                                <input type="date" id="fDate"
                                       class="form-control form-control-sm" />
                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-date"></div>
                        </div>
                    </div>
                    <!-- Edit lock note -->
                </form>
            </div>

            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary btn-sm"
                        id="btnSave">
                    <i class="bi bi-floppy me-1"></i>Save
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ── DELETE CONFIRM MODAL ── -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white py-2">
                <h6 class="modal-title mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Confirm Delete
                </h6>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center small">
                <p class="mb-1">Delete RM record</p>
                <strong id="deleteLabel"></strong>?
            </div>
            <div class="modal-footer justify-content-center py-2">
                <button class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-danger btn-sm"
                        id="btnConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- ── TOAST ── -->
<div class="position-fixed top-0 end-0 p-3" style="z-index:9999">
    <div id="toast" class="toast align-items-center text-white border-0"
         role="alert" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body small" id="toastMsg"></div>
            <button type="button"
                    class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
$(function () {

    // ════════════════════════════════════════════
    // STATE
    // ════════════════════════════════════════════
    let allData         = [];
    let filteredData    = [];
    let currentPage     = 1;
    let rowsPerPage     = 10;
    let totalPages      = 1;
    let pendingDeleteId = null;
    let currentDeptId   = 0;

    const rmirModal   = new bootstrap.Modal($('#rmirModal')[0]);
    const deleteModal = new bootstrap.Modal($('#deleteModal')[0]);
    const toastEl     = $('#toast')[0];
    const bsToast     = new bootstrap.Toast(toastEl, { delay: 3000 });

    // ════════════════════════════════════════════
    // LOAD DEPARTMENTS
    // ════════════════════════════════════════════
    $.ajax({
        url: '/RawMaterialIssueReceived/GetDepartments',
        method: 'GET', dataType: 'json',
        success: function (depts) {

        let headerOpts =
        '<option value="0">-- All Departments --</option>';

        let formOpts =
        '<option value="0">-- Select Department --</option>';

        depts.forEach(d => {

        headerOpts +=
        `<option value="${d.DepartmentId}">
        ${d.Department}
        </option>`;

        formOpts +=
        `<option value="${d.DepartmentId}">
        ${d.Department}
        </option>`;
        });

        $('#deptFilter').html(headerOpts);
        $('#fDepartmentId').html(formOpts);
        }
    });
        $('#fDepartmentId').change(function () {

        const deptId =
        parseInt($(this).val()) || 0;

        loadSizes(deptId);
        });
    // ════════════════════════════════════════════
    // DEPT CHANGE
    // ════════════════════════════════════════════
    window.onDeptChange = function () {
        currentDeptId = parseInt($('#deptFilter').val()) || 0;

        if (!currentDeptId) {
            allData = filteredData = [];
            renderTable();
            return;
        }

        $('#fDepartmentId').val(currentDeptId);
        loadSizes(currentDeptId);
        loadData();
    };

    // ── Load sizes for modal ──
    function loadSizes(deptId) {
        $.ajax({
            url: '/RawMaterialIssueReceived/GetSizesByDept?deptId=' + deptId,
            method: 'GET', dataType: 'json',
        success: function (sizes) {

        let opts =
        '<option value="0">-- Select Size --</option>';

        sizes.forEach(s => {

        // opts += `
        // <option value="${s.sizeId}">
        // ${s.itemSize_Code} - ${s.item_Size}
        // </option>`;

        opts += `
        <option value="${s.sizeId}"
        data-description="${s.item_Size}">
        ${s.itemSize_Code} - ${s.item_Size}
        </option>`;
        });

        $('#fSizeId').html(opts);

        applySizeSelect2();   // NEW
        }
        });
    }
        $('#fSizeId').on('change', function () {

        const desc =
        $('#fSizeId option:selected')
        .data('description') || '';

        $('#fItemDescription').val(desc);
        });
    // ════════════════════════════════════════════
    // STATUS TOGGLE (Issue / Received)
    // ════════════════════════════════════════════
        // $('#btnAdd').click(function () {

        // clearForm();

        // $('#fDepartmentId').val(currentDeptId);

        // $('#fDate').val(
        // new Date().toISOString().split('T')[0]
        // );

        // $('#fRMStatus').val('0');

        // rmirModal.show();
        // });
    // ════════════════════════════════════════════
    // LOAD DATA
    // ════════════════════════════════════════════
    function loadData() {
        $('#loadingRow').show()
            .find('td').html(
                '<div class="spinner-border spinner-border-sm ' +
                'text-primary me-2"></div>Loading...');
        $('#tableBody tr:not(#loadingRow)').remove();

        $.ajax({
            url: '/RawMaterialIssueReceived/GetAll?deptId=' + currentDeptId,
            method: 'GET', dataType: 'json',
            success: function (data) {
                allData = data;
                applyFilter();
                $('#loadingRow').hide();
            },
            error: function () {
                $('#loadingRow td').html(
                    '<i class="bi bi-exclamation-triangle ' +
                    'text-danger me-1"></i>Failed to load data.');
            }
        });
    }

    // ════════════════════════════════════════════
    // RENDER TABLE
    // ════════════════════════════════════════════
    function renderTable() {
        totalPages = Math.max(1,
            Math.ceil(filteredData.length / rowsPerPage));
        if (currentPage > totalPages) currentPage = totalPages;

        const start = (currentPage - 1) * rowsPerPage;
        const end   = Math.min(start + rowsPerPage, filteredData.length);
        const slice = filteredData.slice(start, end);

        $('#tableBody tr:not(#loadingRow)').remove();

        if (slice.length === 0) {
            $('#tableBody').append(
                `<tr><td colspan="10"
                    class="text-center text-muted py-3">
                    No records found.
                 </td></tr>`);
        } else {
            slice.forEach((r, i) =>
                $('#tableBody').append(buildRow(r, start+i+1)));
        }

        updatePagination(start, end);
    }

    function buildRow(r, sr) {
        const fmt  = v => v || '—';
        const fmtN = v => {
            const n = parseFloat(v) || 0;
            return n > 0 ? n.toFixed(2) : '—';
        };

        const issue   = parseFloat(r.Issue_Quantity)    || 0;
        const recv    = parseFloat(r.Received_Quantity) || 0;
        const balance = recv - issue;

        const issueCell   = issue > 0
            ? `<span class="issue-val">${issue.toFixed(2)}</span>`
            : '<span class="text-muted">—</span>';

        const recvCell    = recv > 0
            ? `<span class="recv-val">${recv.toFixed(2)}</span>`
            : '<span class="text-muted">—</span>';

        const balClass    = balance >= 0 ? 'bal-pos' : 'bal-neg';
        const balSign     = balance >= 0 ? '' : '';
        const balCell     = `<span class="${balClass}">
                                ${balSign}${balance.toFixed(2)}
                              </span>`;

        return `
        <tr id="row-${r.SrNo}">
        <td class="text-center">${sr}</td>
        <td>${fmt(r.Department)}</td>
        <td>${fmt(r.Add_Date)}</td>
        <td>${fmt(r.ItemSize_Code)}</td>
        <td>${fmt(r.Item_Size)}</td>
        <td class="text-end">${issueCell}</td>
        <td class="text-end">${recvCell}</td>
        <td class="text-end">${balCell}</td>
       
      
        <td class="text-center">
        <button class="btn btn-outline-primary btn-sm btn-edit"
        data-id="${r.SrNo}">
        <i class="bi bi-pencil-square"></i>
        </button>

        <button class="btn btn-outline-danger btn-sm btn-del"
        data-id="${r.SrNo}"
        data-label="${fmt(r.ItemSize_Code)}">
        <i class="bi bi-trash3"></i>
        </button>
        </td>
        </tr>`;
    }


    // ════════════════════════════════════════════
    // FILTER
    // ════════════════════════════════════════════
    window.applyFilter = function () {
        const q = $('#searchInput').val().toLowerCase().trim();
        filteredData = allData.filter(r =>
            !q ||
            (r.itemSize_Code || '').toLowerCase().includes(q) ||
            (r.item_Size     || '').toLowerCase().includes(q) ||
            (r.department    || '').toLowerCase().includes(q)
        );
        currentPage = 1;
        renderTable();
    };

        //Edit Event


        $(document).on('click', '.btn-edit', function () {

        const id = parseInt($(this).data('id'));
        const r = allData.find(x => x.SrNo == id);

        if (!r) return;

        clearForm();

        $('#modalTitleText').text('Edit RM Entry');

        $('#fSrNo').val(r.SrNo);

        $('#fDepartmentId').val(r.DepartmentId);

        // Load size dropdown first
        loadSizes(r.DepartmentId);

        setTimeout(function () {
        $('#fSizeId').val(r.SizeId).trigger('change');
        }, 300);
        $('#fItemDescription').val(r.Item_Size);
        $('#fQuantity').val(
        r.Issue_Quantity > 0
        ? r.Issue_Quantity
        : r.Received_Quantity
        );

        $('#fRMStatus').val(
        r.Issue_Quantity > 0 ? 1 : 2
        );

        // Date Fix
        if (r.Add_Date) {
        const d = new Date(r.Add_Date);
        $('#fDate').val(d.toISOString().split('T')[0]);
        }

        rmirModal.show();
        });
    // ════════════════════════════════════════════
    // PAGINATION
    // ════════════════════════════════════════════
    function updatePagination(start, end) {
        $('#pageInfo').text(
            filteredData.length === 0
                ? 'No records'
                : `${start+1}–${end} of ${filteredData.length}`);

        $('#btnFirst,#btnPrev').prop('disabled', currentPage === 1);
        $('#btnNext,#btnLast').prop('disabled',  currentPage === totalPages);

        const container = $('#pageNumbers').empty();
        const maxV = 5;
        let sp = Math.max(1, currentPage - Math.floor(maxV/2));
        let ep = Math.min(totalPages, sp + maxV - 1);
        if (ep - sp < maxV - 1) sp = Math.max(1, ep - maxV + 1);

        for (let p = sp; p <= ep; p++) {
            $('<button>').text(p)
                .addClass('btn btn-outline-secondary btn-sm'
                    + (p === currentPage ? ' active-pg' : ''))
                .on('click', () => goToPage(p))
                .appendTo(container);
        }
    }

    window.goToPage = function (p) {
        if (p < 1 || p > totalPages) return;
        currentPage = p; renderTable();
    };
    window.changeRPP = function () {
        rowsPerPage = parseInt($('#rppSelect').val());
        currentPage = 1; renderTable();
    };

    // ════════════════════════════════════════════
    // ADD MODAL
    // ════════════════════════════════════════════
        $('#btnAdd').on('click', function () {

        clearForm();

        $('#modalTitleText').text(
        'Add RM Issue / Received'
        );

        $('#fDate').val(
        new Date().toISOString().split('T')[0]
        );

        rmirModal.show();
        });

   
    // ════════════════════════════════════════════
    // SAVE
    // ════════════════════════════════════════════
    $('#btnSave').on('click', function () {
        clearErrors();

        const sizeId   = parseInt($('#fSizeId').val())   || 0;
        const departmentId = parseInt($('#fDepartmentId').val()) || 0;
        const qty      = parseFloat($('#fQuantity').val()) || 0;
        const date     = $('#fDate').val();
        const rmStatus = parseInt($('#fRMStatus').val())  || 0;

        let valid = true;
        // if (departmentId === 0) {
        // valid = false;
        // alert('Please select Department');
        // }


        if (departmentId === 0) {
        $('#err-dept').text(
        'Please select Department.'
        );
        valid = false;
        }


        if (rmStatus === 0) {
        $('#err-status').text(
        'Please select RM Status.'
        );
        valid = false;
        }
        if (!sizeId) {
            showError('fSizeId','err-size',
                'Item Size required.'); valid = false;
        }
        if (qty <= 0) {
            showError('fQuantity','err-qty',
                'Quantity must be > 0.'); valid = false;
        }
        if (!date) {
            showError('fDate','err-date',
                'Date required.'); valid = false;
        }
        if (!valid) return;

        const token =
            $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url:      '/RawMaterialIssueReceived/Save',
            method:   'POST',
            dataType: 'json',
            data: {
                SrNo:         $('#fSrNo').val(),
                DepartmentId: $('#fDepartmentId').val(),
                SizeId:       sizeId,
                Quantity:     qty,
                Date:         date,
                RM_Status:    rmStatus,
                __RequestVerificationToken: token
            },
            success: function (d) {
                if (!d.success) {
                    showToast(d.message || 'Save failed.', 'danger');
                    return;
                }
                rmirModal.hide();
                showToast(d.message, 'primary');
                loadData();
            },
            error: function () {
                showToast('Network error.', 'danger');
            }
        });
    });

    // ════════════════════════════════════════════
    // DELETE
    // ════════════════════════════════════════════
    $(document).on('click', '.btn-del', function () {
        pendingDeleteId = parseInt($(this).data('id'));
        $('#deleteLabel').text($(this).data('label'));
        deleteModal.show();
    });

    $('#btnConfirmDelete').on('click', function () {
        const token =
            $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url:      '/RawMaterialIssueReceived/Delete',
            method:   'POST',
            dataType: 'json',
            data: { srNo: pendingDeleteId,
                    __RequestVerificationToken: token },
            success: function (d) {
                deleteModal.hide();
                if (d.success) {
                    allData      = allData.filter(
                        r => r.SrNo !== pendingDeleteId);
                    filteredData = filteredData.filter(
                        r => r.SrNo !== pendingDeleteId);
                    renderTable();
                    showToast('Record deleted.', 'primary');
                } else {
                    showToast('Delete failed.', 'danger');
                }
            },
            error: function () {
                showToast('Network error.', 'danger');
            }
        });
    });

    // ════════════════════════════════════════════
    // HELPERS
    // ════════════════════════════════════════════
        function clearForm() {

        $('#fSrNo').val('0');

        $('#fDepartmentId').val('0');

        $('#fRMStatus').val('0');

        $('#fSizeId').html(
        '<option value="0">-- Select Size --</option>'
        );

        $('#fItemDescription').val('');

        $('#fQuantity').val('');

        $('#fDate').val('');

        clearErrors();

        if ($('#fSizeId').hasClass("select2-hidden-accessible")) {
        $('#fSizeId').val('0').trigger('change');
        }
        }

    function clearErrors() {
        $('.invalid-feedback.d-block').text('');
        $('#rmirForm .form-control, #rmirForm .form-select')
            .removeClass('is-invalid');
    }

    function showError(fieldId, errId, msg) {
        $('#' + fieldId).addClass('is-invalid');
        $('#' + errId).text(msg);
    }

    function showToast(msg, type) {
        toastEl.className =
            `toast align-items-center text-white border-0 bg-${type}`;
        $('#toastMsg').text(msg);
        bsToast.show();
    }
        function applySizeSelect2() {

        $('#fSizeId').select2({
        dropdownParent: $('#rmirModal'),
        width: '100%',
        placeholder: '-- Select Size --',
        allowClear: false
        });

        }
        $('#rmirModal').on('hidden.bs.modal', function () {
        clearForm();
        });
});
</script>
