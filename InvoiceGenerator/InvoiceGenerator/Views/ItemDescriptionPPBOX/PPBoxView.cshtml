    function clearForm() {
        $('#itemForm')[0].reset();
        $('#fItemId').val('0');
        $('#fItemCode').prop('disabled', false);
        clearErrors();
    }

    function clearErrors() {
        $('.invalid-feedback.d-block').text('');
        $('#itemForm .form-control, #itemForm .form-select')
            .removeClass('is-invalid');
    }

    function showError(fieldId, errId, msg) {
        $('#' + fieldId).addClass('is-invalid');
        $('#' + errId).text(msg);
    }

    function showToast(msg, type) {
        toastEl.className =
            `toast align-items-center text-white border-0 bg-${type}`;
        $('#toastMsg').text(msg);
        bsToast.show();
    }

    // ── INIT ──
    loadDropdowns();

});
