$('#btnSaveItem').on('click', function () {

    clearErrors();
    let isValid = true;

    // ============================
    // REQUIRED VALIDATIONS
    // ============================

    if (!$('#fItemCode').val().trim()) {
        showError('fItemCode', 'err-itemCode', 'Item Code is required');
        isValid = false;
    }

    if (!$('#fItemDesc').val().trim()) {
        showError('fItemDesc', 'err-itemDesc', 'Description is required');
        isValid = false;
    }

    if (!$('#fDeptId').val()) {
        showError('fDeptId', 'err-dept', 'Department is required');
        isValid = false;
    }

    if (!$('#fMinStock').val()) {
        showError('fMinStock', 'err-min', 'Min Qty is required');
        isValid = false;
    }

    if (!$('#fMaxStock').val()) {
        showError('fMaxStock', 'err-max', 'Max Qty is required');
        isValid = false;
    }

    if (!$('#fMrpRM').val()) {
        showError('fMrpRM', 'err-mrpRM', 'MRP RM is required');
        isValid = false;
    }

    if (!$('#fMrpSale').val()) {
        showError('fMrpSale', 'err-mrpSale', 'MRP Sale is required');
        isValid = false;
    }

    // ============================
    // RM SIZE VALIDATION
    // ============================

    const size1 = $('#fRMSize1').val();
    const size2 = $('#fRMSize2').val();
    const size3 = $('#fRMSize3').val();
    const size4 = $('#fRMSize4').val();

    if (!size1) {
        showError('fRMSize1', 'err-rm1', 'RM Size 1 is required');
        isValid = false;
    }

    if (size2 && !size1) {
        showError('fRMSize2', 'err-rm2', 'Fill RM Size 1 first');
        isValid = false;
    }

    if (size3 && !size2) {
        showError('fRMSize3', 'err-rm3', 'Fill RM Size 2 first');
        isValid = false;
    }

    if (size4 && !size3) {
        showError('fRMSize4', 'err-rm4', 'Fill RM Size 3 first');
        isValid = false;
    }

    // ============================
    // SHEET QTY VALIDATION
    // ============================

    function validateQty(size, qtyId, errId, msg) {
        const qty = $(qtyId).val();

        if (size && (!qty || qty <= 0)) {
            showError(qtyId.replace('#',''), errId, msg);
            return false;
        }
        return true;
    }

    if (!validateQty(size1, '#fSheetQty1', 'err-qty1', 'Qty required for RM Size 1'))
        isValid = false;

    if (!validateQty(size2, '#fSheetQty2', 'err-qty2', 'Qty required for RM Size 2'))
        isValid = false;

    if (!validateQty(size3, '#fSheetQty3', 'err-qty3', 'Qty required for RM Size 3'))
        isValid = false;

    if (!validateQty(size4, '#fSheetQty4', 'err-qty4', 'Qty required for RM Size 4'))
        isValid = false;

    // ============================
    // STOP IF INVALID
    // ============================

    if (!isValid) return;

    // ============================
    // PAYLOAD
    // ============================

    const token = $('input[name="__RequestVerificationToken"]').val();

    const payload = {
        ItemId: $('#fItemId').val(),

        Item_Code: $('#fItemCode').val().trim(),
        Item_Description: $('#fItemDesc').val().trim(),

        DepartmentId: parseInt($('#fDeptId').val()) || 0,

        MRP_Rate_RM: parseFloat($('#fMrpRM').val()) || 0,
        MRP_Rate_Sale: parseFloat($('#fMrpSale').val()) || 0,

        RM_SizeId_1: size1 ? parseInt(size1) : null,
        Sheet_Qty_1: parseInt($('#fSheetQty1').val()) || 0,

        RM_SizeId_2: size2 ? parseInt(size2) : null,
        Sheet_Qty_2: parseInt($('#fSheetQty2').val()) || 0,

        RM_SizeId_3: size3 ? parseInt(size3) : null,
        Sheet_Qty_3: parseInt($('#fSheetQty3').val()) || 0,

        RM_SizeId_4: size4 ? parseInt(size4) : null,
        Sheet_Qty_4: parseInt($('#fSheetQty4').val()) || 0,

        Opening_Stock: parseInt($('#fOpenStock').val()) || 0,
        MIN_Stock: parseInt($('#fMinStock').val()) || 0,
        MAX_Stock: parseInt($('#fMaxStock').val()) || 0,

        // PackingId: $('#fPackingId').val() ? parseInt($('#fPackingId').val()) : null,
        Packing_Type: $('#fPackingId').val() ? $('#fPackingId option:selected').text() : '',
        Packing_Qty: parseInt($('#fPackQty').val()) || 1,

        Sale_Trans_Cost: parseFloat($('#fTransCost').val()) || 0,

        // DEFAULT VALUES
        Cycle_Time: 20,
        No_of_Cavity: 1,
        Std_Shot_Weight: 0,
        Finish_Weight: 0,
        Ext_Mould_PVC_RMType: "",
        Lab: 0,

        CreatedBy: "Admin",
        Date: new Date().toISOString(),

        Inner_Packing_Type: "",
        Inner_Packing_Qty: 0,

        __RequestVerificationToken: token
    };

    // ============================
    // AJAX CALL
    // ============================

    $.ajax({
        url: '/ItemDescriptionPPBox/Save',
        method: 'POST',
        data: payload,
        dataType: 'json',

        success: function (d) {

            if (!d.success) {
                showToast(d.message || 'Save failed.', 'danger');
                return;
            }

            itemModal.hide();
            showToast(d.message || 'Saved successfully!', 'success');

            loadData(); // reload table
        },

        error: function (xhr) {
            console.log(xhr.responseText);
            showToast('Error: ' + xhr.status, 'danger');
        }
    });

});
