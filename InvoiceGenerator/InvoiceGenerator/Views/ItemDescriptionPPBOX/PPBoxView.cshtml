function loadSizes(deptId) {

    $.ajax({
        url: '/ItemDescriptionPPBox/GetItemSizes',
        method: 'GET',
        data: { departmentId: deptId },

        success: function (data) {

            let sizeOpts = '<option value="">-- Select Size --</option>';

            data.forEach(s => {
                sizeOpts += `<option value="${s.SizeId}">
                                ${s.ItemSize_Code}
                             </option>`;
            });

            $('#fRMSize1').html(sizeOpts).trigger('change');
