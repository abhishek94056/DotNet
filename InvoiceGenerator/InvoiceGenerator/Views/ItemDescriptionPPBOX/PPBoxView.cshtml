@{
    ViewData["Title"] = "PPBox Master";
}
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<style>
    :root {
        --header-bg: #1a1a2e;
        --row-odd: #f8f9fa;
        --row-even: #eef2ff;
        --row-hover: #cfe2ff;
        --accent: #0d6efd;
        --sec-bg: #343a40;
    }

    /* =========================================
       PAGE HEADER
    ========================================= */

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 10px;
        flex-wrap: wrap;
    }

        .page-header h6 {
            margin: 0;
            font-weight: 700;
            white-space: nowrap;
        }

    .header-controls {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 6px;
        flex-wrap: wrap;
        flex: 1;
    }

        .header-controls .form-select,
        .header-controls .form-control,
        .header-controls .btn {
            width: auto;
        }


    /* =========================================
       TABLE
    ========================================= */

    #itemTable {
        font-size: .70rem;
        min-width: 1700px;
        width: max-content;
    }

        #itemTable thead th {
            font-size: .67rem;
            padding: 4px 5px;
            white-space: nowrap;
            text-align: center;
            background: var(--header-bg);
            color: #fff;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        #itemTable tbody td {
            padding: 3px 5px;
            vertical-align: middle;
            white-space: nowrap;
        }

        #itemTable tbody tr:nth-child(odd) td {
            background-color: var(--row-odd);
        }

        #itemTable tbody tr:nth-child(even) td {
            background-color: var(--row-even);
        }

        #itemTable tbody tr:hover td {
            background-color: var(--row-hover) !important;
            cursor: pointer;
            transition: background-color .15s;
        }

        #itemTable .btn-sm {
            padding: 1px 4px;
            font-size: .65rem;
        }

    /* =========================================
       TABLE WRAP
    ========================================= */

    .table-wrap {
        max-height: 480px;
        overflow: auto;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        width: 100%;
        -webkit-overflow-scrolling: touch;
    }

    /* =========================================
       PAGINATION
    ========================================= */

    .pagination-bar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 8px;
        font-size: .73rem;
    }

        .pagination-bar button {
            min-width: 28px;
            height: 26px;
            font-size: .68rem;
            padding: 0 5px;
            border-radius: 4px;
        }

            .pagination-bar button.active-page {
                background: var(--accent);
                color: #fff;
                border-color: var(--accent);
            }

    /* =========================================
       FORM SECTION
    ========================================= */

    .form-section-title {
        font-size: .72rem;
        font-weight: 700;
        color: #fff;
        background: var(--sec-bg);
        padding: 4px 10px;
        border-radius: 4px;
        margin-bottom: 8px;
    }

    /* =========================================
       SELECT2
    ========================================= */

    .select2-wrapper {
        flex: 1 1 auto;
        width: 100%;
    }

    .select2-container {
        width: 100% !important;
    }

    .select2-container--default .select2-selection--single {
        height: 31px !important;
        border: 1px solid #ced4da !important;
        border-radius: 0 .25rem .25rem 0 !important;
        display: flex !important;
        align-items: center !important;
    }

    .select2-selection__rendered {
        line-height: normal !important;
        display: flex !important;
        align-items: center !important;
        height: 100%;
        padding-left: 6px !important;
    }

    .select2-selection__arrow {
        height: 100% !important;
        top: 0 !important;
    }

    .input-group-sm .input-group-text {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 31px;
    }

    /* =========================================
       MODAL
    ========================================= */

    .modal-xl {
        max-width: 95%;
    }

    .modal-body {
        overflow-x: hidden;
    }

    #itemForm .row {
        margin-left: 0;
        margin-right: 0;
    }

    /* =========================================
       MOBILE
    ========================================= */

    @@media (max-width:575px) {

        .page-header {
            flex-direction: column;
            align-items: stretch;
        }

        .header-controls {
            flex-direction: column;
            align-items: stretch;
            width: 100%;
        }

            .header-controls .form-select,
            .header-controls .form-control,
            .header-controls .btn {
                width: 100% !important;
            }

        .pagination-bar {
            justify-content: center;
        }

        #pageNumbers {
            flex-wrap: wrap;
        }

        .modal-dialog {
            margin: .5rem;
        }

        .modal-xl {
            max-width: 100%;
        }

        #itemForm .col-md-2,
        #itemForm .col-md-3 {
            width: 100%;
        }

        #itemTable {
            min-width: 1500px;
        }

        .select2-container {
            width: 100% !important;
        }
    }

    /* =========================================
       TABLET
    ========================================= */

    @@media (min-width:576px) and (max-width:991px) {

        #itemForm .col-md-2,
        #itemForm .col-md-3 {
            width: 50%;
        }
    }
</style>

<!-- ── PAGE HEADER ── -->
<div class="page-header">
    <h6 class="mb-0 fw-bold">
        <i class="bi bi-box me-2 text-primary"></i>
        PP Box Master
    </h6>
<div class="header-controls">

        <select id="deptFilter" class="form-select form-select-sm"
                style="width:150px" onchange="applyFilter()">
            <option value="">All Departments</option>
        </select>

        <input type="text" id="searchInput"
               class="form-control form-control-sm"
               placeholder="🔍 Search code / desc..."
               style="width:180px"
               oninput="applyFilter()" />

        <button class="btn btn-primary btn-sm" id="btnAddItem">
            <i class="bi bi-plus-lg me-1"></i>Add Item
        </button>
    </div>
</div>

<!-- ── TABLE ── -->
<div class="table-wrap">
    <table class="table table-bordered mb-0" id="itemTable">
    <thead>
<tr>
    <th>#</th>
    <th>Department</th>
    <th>Item Code</th>
    <th>Description</th>
    <th>MRP Rate RM</th>
    <th>MRP Rate Sale</th>
    <th>RM Size 1</th>
    <th>Sheet Qty. 1</th>
    <th>RM Size 2</th>
    <th>Sheet Qty. 2</th>
    <th>RM Size 3</th>
    <th>Sheet Qty. 3</th>
    <th>RM Size 4</th>
    <th>Sheet Qty. 4</th>
    <th>Opening Stock</th>
    <th>MIN Qty.</th>
    <th>MAX Qty.</th>
    <th>Packing Type</th>
    <th>Packing Qty.</th>
    <th>Sale Transport</th>
    <th>Action</th>
</tr>
</thead>
<tbody id="tableBody">
            <tr id="loadingRow">
                <td colspan="21">
                    <div class="spinner-border spinner-border-sm text-primary me-2"></div>
                    Loading data...
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- ── PAGINATION ── -->
<div class="pagination-bar">
    <span id="pageInfo" class="text-muted"></span>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnFirst" onclick="goToPage(1)">«</button>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnPrev"  onclick="goToPage(currentPage-1)">‹</button>
    <span id="pageNumbers" class="d-flex gap-1 flex-wrap"></span>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnNext"  onclick="goToPage(currentPage+1)">›</button>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnLast"  onclick="goToPage(totalPages)">»</button>
    <select id="rppSelect" class="form-select form-select-sm"
            style="width:75px" onchange="changeRPP()">
        <option value="10" selected>10</option>
        <option value="20">20</option>
        <option value="50">50</option>
    </select>
    <span class="text-muted">/ page</span>
</div>

<!-- ══════════════════════════════════════════════
     ADD / EDIT MODAL  (tabbed sections)
══════════════════════════════════════════════ -->
<div class="modal fade" id="itemModal" tabindex="-1">
<div class="modal-dialog modal-xl modal-fullscreen-sm-down modal-dialog-centered modal-dialog-scrollable">
<div class="modal-content">

<!-- HEADER -->
<div class="modal-header bg-dark text-white py-2">
    <h6 class="modal-title mb-0">
        <i class="bi bi-box-seam me-2"></i>
        <span id="modalTitleText">Add Item</span>
    </h6>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
</div>

<!-- BODY -->
<div class="modal-body">
<form id="itemForm">
    @Html.AntiForgeryToken()
    <input type="hidden" id="fItemId"/>

<div class="row g-2">

    <!-- Department -->
<div class="col-md-2">
    <label class="form-label fw-semibold small">Department <span class="text-danger">*</span></label>
    <div class="input-group input-group-sm">
        <span class="input-group-text"><i class="bi bi-building"></i></span>
        <select id="fDeptId" class="form-select"></select>
        <div class="invalid-feedback d-block" id="err-dept"></div>
    </div>
</div>

<!-- Item Code -->
<div class="col-md-3">
    <label class="form-label fw-semibold small">Item Code <span class="text-danger">*</span></label>
    <div class="input-group input-group-sm">
        <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
        <input type="text" id="fItemCode" class="form-control" placeholder="Enter item code"/>
        <div class="invalid-feedback d-block" id="err-itemCode"></div>
    </div>
</div>

<!-- Description -->
<div class="col-md-3">
    <label class="form-label fw-semibold small">Description <span class="text-danger">*</span></label>
    <div class="input-group input-group-sm">
        <span class="input-group-text"><i class="bi bi-card-text"></i></span>
        <input type="text" id="fItemDesc" class="form-control" placeholder="Enter item description"/>
    </div>
    <div class="invalid-feedback d-block" id="err-itemDesc"></div>
</div>



<!-- PRICING -->

<div class="col-md-2">
    <label class="form-label fw-semibold small">MRP Rate RM<span class="text-danger">*</span></label>
    <div class="input-group input-group-sm">
        <span class="input-group-text"><i class="bi bi-currency-rupee"></i></span>
        <input type="number" id="fMrpRM" class="form-control" placeholder="₹"/>
        <div class="invalid-feedback d-block" id="err-mrpRM"></div>
    </div>
</div>

<div class="col-md-2">
    <label class="form-label fw-semibold small">MRP Rate Sale<span class="text-danger">*</span></label>
    <div class="input-group input-group-sm">
        <span class="input-group-text"><i class="bi bi-cash"></i></span>
        <input type="number" id="fMrpSale" class="form-control" placeholder="₹"/>
        <div class="invalid-feedback d-block" id="err-mrpSale"></div>
    </div>
</div>

<!-- RM SIZES -->

<div class="col-md-3">
    <label class="form-label fw-semibold small">RM Size 1<span class="text-danger">*</span></label>
     
    <div class="input-group input-group-sm mb-1">
    @* <span class="input-group-text">
        <i class="bi bi-layers"></i>
    </span> *@

    <div class="select2-wrapper">
        <select id="fRMSize1" class="form-select rm-size"></select>
         <div class="invalid-feedback d-block" id="err-rm1"></div>
    </div>
     </div>


    <div class="input-group input-group-sm">
        <span class="input-group-text"><i class="bi bi-123"></i></span>
        <input type="number" id="fSheetQty1" class="form-control" placeholder="Sheet Qty"/>
        <div class="invalid-feedback d-block" id="err-qty1"></div>
    </div>
</div>

<div class="col-md-3">
    <label class="form-label fw-semibold small">RM Size 2</label>
    <div class="input-group input-group-sm mb-1">
    @* <span class="input-group-text">
        <i class="bi bi-layers"></i>
    </span> *@

    <div class="select2-wrapper">
        <select id="fRMSize2" class="form-select rm-size"></select>
         <div class="invalid-feedback d-block" id="err-rm2"></div>
    </div>
     </div>
    <div class="input-group input-group-sm">
        <span class="input-group-text"><i class="bi bi-123"></i></span>
        <input type="number" id="fSheetQty2" class="form-control" placeholder="Sheet Qty"/>
       <div class="invalid-feedback d-block" id="err-qty2"></div>
    </div>
</div>

<div class="col-md-3">
    <label class="form-label fw-semibold small">RM Size 3</label>
    <div class="input-group input-group-sm mb-1">
    @* <span class="input-group-text">
        <i class="bi bi-layers"></i>
    </span> *@

    <div class="select2-wrapper">
        <select id="fRMSize3" class="form-select rm-size"></select>
         <div class="invalid-feedback d-block" id="err-rm3"></div>
    </div>
     </div>
    <div class="input-group input-group-sm">
        <span class="input-group-text"><i class="bi bi-123"></i></span>
        <input type="number" id="fSheetQty3" class="form-control" placeholder="Sheet Qty"/>
        <div class="invalid-feedback d-block" id="err-qty3"></div>
    </div>
</div>

<div class="col-md-3">
    <label class="form-label fw-semibold small">RM Size 4</label>
     <div class="input-group input-group-sm mb-1">
    @* <span class="input-group-text">
        <i class="bi bi-layers"></i>
    </span> *@

    <div class="select2-wrapper">
        <select id="fRMSize4" class="form-select rm-size"></select>
         <div class="invalid-feedback d-block" id="err-rm4"></div>
    </div>
     </div>
    <div class="input-group input-group-sm">
        <span class="input-group-text"><i class="bi bi-123"></i></span>
        <input type="number" id="fSheetQty4" class="form-control" placeholder="Sheet Qty"/>
        <div class="invalid-feedback d-block" id="err-qty4"></div>
    </div>
</div>

<!-- STOCK -->

<div class="col-md-3">
    <label class="form-label fw-semibold small">Packing Type</label>
    <div class="input-group input-group-sm mb-1">
    <span class="input-group-text"><i class="bi bi-box"></i></span>
    <select id="fPackingId" class="form-select"></select>
</div>
    <label class="form-label fw-semibold small">Packing Qty</label>
    <div class="input-group input-group-sm">
        <span class="input-group-text"><i class="bi bi-123"></i></span>
        <input type="number" id="fPackQty" class="form-control" placeholder="Packing Qty"/>
    </div>
</div>

<div class="col-md-3">
    <label class="form-label fw-semibold small">MIN Qty <span class="text-danger">*</span></label>
    <div class="input-group input-group-sm">
        <span class="input-group-text"><i class="bi bi-arrow-down"></i></span>
        <input type="number" id="fMinStock" class="form-control" placeholder="Minimum"/>
        <div class="invalid-feedback d-block" id="err-min"></div>
    </div>
    <label class="form-label fw-semibold small">MAX Qty <span class="text-danger">*</span></label>
    <div class="input-group input-group-sm">
        <span class="input-group-text"><i class="bi bi-arrow-up"></i></span>
        <input type="number" id="fMaxStock" class="form-control" placeholder="Maximum"/>
        <div class="invalid-feedback d-block" id="err-max"></div>
    </div>
</div>

<div class="col-md-3">
    <label class="form-label fw-semibold small">Opening Stock</label>
    <div class="input-group input-group-sm">
        <span class="input-group-text"><i class="bi bi-box-seam"></i></span>
        <input type="number" id="fOpenStock" class="form-control" placeholder="0"/>
    </div>
      <label class="form-label fw-semibold small">Sale Transport</label>
    <div class="input-group input-group-sm">
        <span class="input-group-text"><i class="bi bi-truck"></i></span>
        <input type="number" id="fTransCost" class="form-control" placeholder="₹"/>
    </div>
</div>

</div>
</form>
</div>

<!-- FOOTER -->
<div class="modal-footer py-2">
    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
        <i class="bi bi-x-lg me-1"></i>Cancel
    </button>
    <button class="btn btn-primary btn-sm" id="btnSaveItem">
        <i class="bi bi-check-lg me-1"></i>Save
    </button>
</div>

</div>
</div>
</div>
<!-- ── DELETE CONFIRM MODAL ── -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white py-2">
                <h6 class="modal-title mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Confirm Delete
                </h6>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center small">
                <p class="mb-1">Delete item</p>
                <strong id="deleteItemCode"></strong>?
            </div>
            <div class="modal-footer justify-content-center py-2">
                <button class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-danger btn-sm"
                        id="btnConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- ── TOAST ── -->
<div class="position-fixed top-0 end-0 p-3" style="z-index:9999">
    <div id="toast" class="toast align-items-center text-white border-0"
         role="alert" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body small" id="toastMsg"></div>
            <button type="button"
                    class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

