@using InvoiceGenerator.Helper
@{
    ViewData["Title"] = "Matrix Item Size Master";
}

<style>
    #matrixTable { font-size: 0.72rem; }
    #matrixTable thead th {
        font-size: 0.69rem; padding: 4px 6px;
        white-space: nowrap; text-align: center;
        background: #1a1a2e; color: #fff;
        position: sticky; top: 0; z-index: 2;
    }
    #matrixTable tbody td {
        padding: 3px 6px; vertical-align: middle;
        white-space: nowrap;
    }
    #matrixTable tbody tr:nth-child(odd)  td { background-color: #f8f9fa; }
    #matrixTable tbody tr:nth-child(even) td { background-color: #eef2ff; }
    #matrixTable tbody tr:hover td {
        background-color: #cfe2ff !important;
        cursor: pointer;
        transition: background-color 0.15s;
    }
    #matrixTable .btn-sm { padding: 1px 5px; font-size: 0.67rem; }

    .table-wrap {
        max-height: 480px;
        overflow-y: auto;
        border: 1px solid #dee2e6;
        border-radius: 4px;
    }
    .pagination-bar {
        display: flex; justify-content: flex-end;
        align-items: center; gap: 5px;
        margin-top: 8px; font-size: 0.73rem;
    }
    .pagination-bar button {
        min-width: 28px; height: 26px;
        font-size: 0.68rem; padding: 0 5px;
        border-radius: 4px;
    }
    .pagination-bar button.active-page {
        background: #0d6efd; color: #fff;
        border-color: #0d6efd;
    }
    #loadingRow td {
        text-align: center; padding: 20px; color: #888;
    }
    .cascade-note {
        font-size: 0.65rem; color: #6c757d;
        margin-top: 2px;
    }
    /* =========================================
   PAGE HEADER
========================================= */

.page-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    margin-bottom:10px;
    flex-wrap:wrap;
}

.page-header h6{
    margin:0;
    font-weight:700;
    white-space:nowrap;
    word-break:break-word;
}

.header-controls{
    display:flex;
    align-items:center;
    gap:6px;
    flex-wrap:wrap;
}

.header-controls .form-select,
.header-controls .form-control,
.header-controls .btn{
    width:auto;
}

/* =========================================
   TABLE WRAP
========================================= */

.table-wrap{
    overflow:auto;
    width:100%;
    -webkit-overflow-scrolling:touch;
}

#matrixTable{
    min-width:900px;
}

/* =========================================
   MODAL
========================================= */

.modal-dialog{
    max-width:650px;
}

/* =========================================
   MOBILE
========================================= */

@@media (max-width:575px){
    .page-header h6{
    font-size:0.9rem;
}
.page-header{
    overflow:hidden;
}

    .page-header{
        flex-direction:column;
        align-items:stretch;
    }

    .header-controls{
        flex-direction:column;
        align-items:stretch;
        width:100%;
    }

    .header-controls .form-select,
    .header-controls .form-control,
    .header-controls .btn{
        width:100%!important;
    }

    #deptFilter,
    #searchInput{
        width:100%!important;
    }

    .pagination-bar{
        justify-content:center;
        flex-wrap:wrap;
    }

    #pageNumbers{
        flex-wrap:wrap;
    }

    .modal-dialog{
        margin:.5rem;
        max-width:100%;
    }

    #matrixTable{
        min-width:850px;
    }
}
</style>

<!-- ── PAGE HEADER ── -->
<div class="page-header">
    <h6 class="mb-0 fw-bold">
        <i class="bi bi-diagram-3 me-2 text-primary"></i>
        Matrix Item Size Master
    </h6>
    <div class="header-controls">

        <!-- Department filter -->
        <select id="deptFilter" class="form-select form-select-sm"
                style="width:155px" onchange="applyFilter()">
            <option value="">All Departments</option>
        </select>

        <!-- Search -->
        <input type="text" id="searchInput"
               class="form-control form-control-sm"
               placeholder="🔍 Search..."
               style="width:170px"
               oninput="applyFilter()" />

        <button class="btn btn-primary btn-sm" id="btnAdd">
            <i class="bi bi-plus-lg me-1"></i>Add Matrix
        </button>
    </div>
</div>

<!-- ── TABLE ── -->
<div class="table-wrap">
    <table class="table table-bordered mb-0" id="matrixTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Department</th>
                <th>Size Code</th>
                <th>Size Description</th>
                <th>Item Code</th>
                <th>Item Description</th>
                @* <th>Date</th>
                <th>Created By</th> *@
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="tableBody">
            <tr id="loadingRow">
                <td colspan="7">
                    <div class="spinner-border spinner-border-sm
                                text-primary me-2"></div>
                    Loading...
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- ── PAGINATION ── -->
<div class="pagination-bar">
    <span id="pageInfo" class="text-muted"></span>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnFirst" onclick="goToPage(1)">«</button>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnPrev"  onclick="goToPage(currentPage-1)">‹</button>
    <span id="pageNumbers" class="d-flex gap-1"></span>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnNext"  onclick="goToPage(currentPage+1)">›</button>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnLast"  onclick="goToPage(totalPages)">»</button>
    <select id="rppSelect" class="form-select form-select-sm"
            style="width:75px" onchange="changeRPP()">
        <option value="10" selected>10</option>
        <option value="20">20</option>
        <option value="50">50</option>
    </select>
    <span class="text-muted">/ page</span>
</div>

<!-- ══════════════════════════════════════════════
     ADD / EDIT MODAL
══════════════════════════════════════════════ -->
<div class="modal fade" id="matrixModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <div class="modal-content">

            <div class="modal-header bg-dark text-white py-2">
                <h6 class="modal-title mb-0">
                    <i class="bi bi-diagram-3 me-2"></i>
                    <span id="modalTitleText">Add Matrix</span>
                </h6>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="matrixForm" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="fMatrixId" value="0" />

                    <div class="row g-2">

                        <!-- Department — drives cascading -->
                        <div class="col-12">
                            <label class="form-label fw-semibold small">
                                Department
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-building"></i>
                                </span>
                                <select id="fDeptId"
                                        class="form-select form-select-sm">
                                    <option value="">-- Select Department --</option>
                                </select>
                            </div>
                            <div class="cascade-note">
                                <i class="bi bi-arrow-down-right me-1"></i>
                                Selecting department filters Items &amp; Sizes below
                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-dept"></div>
                        </div>

                       <!-- Item — filtered by dept -->
                         <div class="col-12">
                            <label class="form-label fw-semibold small">
                                Item Code
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-card-list"></i>
                                </span>
                                <select id="fItemId"
                                        class="form-select form-select-sm"
                                        disabled>
                                    <option value="">
                                        -- Select Department first --
                                    </option>
                                </select>
                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-item"></div>
                        </div>
                        <!-- Size — filtered by dept -->
                        <div class="col-12">
                            <label class="form-label fw-semibold small">
                                Size Code
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-rulers"></i>
                                </span>
                                <select id="fSizeId"
                                        class="form-select form-select-sm"
                                        disabled>
                                    <option value="">
                                        -- Select Department first --
                                    </option>
                                </select>
                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-size"></div>
                        </div>


                         
                       
                        @* <!-- Date -->
                        <div class="col-12">
                            <label class="form-label fw-semibold small">
                                Date
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-calendar3"></i>
                                </span>
                                <input type="date" id="fDate"
                                       class="form-control form-control-sm" />
                            </div>
                        </div>

                        <!-- Created By — readonly from session -->
                        <div class="col-12">
                            <label class="form-label fw-semibold small">
                                Created By
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-person-check"></i>
                                </span>
                                <input type="text" id="fCreatedBy"
                                       class="form-control form-control-sm bg-light"
                                       readonly
                                       value="@SessionHelper.GetUserName(Context.Session)" />
                            </div>
                        </div> *@

                    </div>
                </form>
            </div>

            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary btn-sm"
                        id="btnSave">
                    <i class="bi bi-floppy me-1"></i>Save
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ── DELETE CONFIRM MODAL ── -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white py-2">
                <h6 class="modal-title mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Confirm Delete
                </h6>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center small">
                <p class="mb-1">Delete matrix record</p>
                <strong id="deleteLabel"></strong>?
            </div>
            <div class="modal-footer justify-content-center py-2">
                <button class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-danger btn-sm"
                        id="btnConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- ── TOAST ── -->
<div class="position-fixed top-0 end-0 p-3" style="z-index:9999">
    <div id="toast" class="toast align-items-center text-white border-0"
         role="alert" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body small" id="toastMsg"></div>
            <button type="button"
                    class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
$(function () {

    // ════════════════════════════════════════════
    // STATE
    // ════════════════════════════════════════════
    let allData         = [];
    let filteredData    = [];
    let currentPage     = 1;
    let rowsPerPage     = 10;
    let totalPages      = 1;
    let pendingDeleteId = null;

    const matrixModal = new bootstrap.Modal($('#matrixModal')[0]);
    const deleteModal = new bootstrap.Modal($('#deleteModal')[0]);
    const toastEl     = $('#toast')[0];
    const bsToast     = new bootstrap.Toast(toastEl, { delay: 3000 });

    // ════════════════════════════════════════════
    // LOAD ALL DATA
    // ════════════════════════════════════════════
    // function loadData() {
    //     $('#loadingRow').show();
    //     $('#tableBody tr:not(#loadingRow)').remove();

    //     $.ajax({
    //         url:      '/MatrixItemSize/GetAll',
    //         method:   'GET',
    //         dataType: 'json',
    //         success: function (data) {
    //             allData = data;
    //             applyFilter();
    //             $('#loadingRow').hide();
    //         },
    //         error: function () {
    //             $('#loadingRow td').html(
    //                 '<i class="bi bi-exclamation-triangle ' +
    //                 'text-danger me-1"></i>Failed to load data.');
    //         }
    //     });
    // }
    function loadData() {
    const deptId = $('#deptFilter').val();

    // if (!deptId) {
    //     allData = [];
    //     applyFilter();
    //     return;
    // }

    $('#loadingRow').show();
    $('#tableBody tr:not(#loadingRow)').remove();

    $.ajax({
        url: '/MatrixItemSize/GetAll',
        method: 'GET',
        data: { departmentId: deptId },
        success: function (res) {
            allData = res;
            applyFilter();
            $('#loadingRow').hide();
        },
        error: function () {
            $('#loadingRow td').html('Failed to load data');
        }
    });
}
    // ════════════════════════════════════════════
    // LOAD DEPARTMENTS (page filter + modal)
    // ════════════════════════════════════════════
    function loadDepartments() {
        $.ajax({
            url:      '/MatrixItemSize/GetDepartments',
            method:   'GET',
            dataType: 'json',
            success: function (depts) {

                // Page header filter
                let filterOpts = '<option value="">All Departments</option>';
                depts.forEach(d => {
                    filterOpts +=
                        `<option value="${d.DepartmentId}">
                            ${d.Department}
                         </option>`;
                });
                $('#deptFilter').html(filterOpts);

                // Modal dropdown
                let modalOpts =
                    '<option value="">-- Select Department --</option>';
                depts.forEach(d => {
                    modalOpts +=
                        `<option value="${d.DepartmentId}">
                            ${d.Department}
                         </option>`;
                });
                $('#fDeptId').html(modalOpts);
            }
        });
    }

    // ════════════════════════════════════════════
    // CASCADE: Department → Items + Sizes
    // ════════════════════════════════════════════
    $('#fDeptId').on('change', function () {
        const deptId = $(this).val();

        // Reset dependent dropdowns
        $('#fItemId, #fSizeId')
            .prop('disabled', true)
            .html('<option value="">-- Loading... --</option>');

        if (!deptId) {
            $('#fItemId, #fSizeId')
                .html('<option value="">-- Select Department first --</option>');
            return;
        }

        // Load Items
        $.ajax({
            url:      '/MatrixItemSize/GetItemsByDept?deptId=' + deptId,
            method:   'GET',
            dataType: 'json',
            success: function (items) {
                let opts = '<option value="">-- Select Item --</option>';
                items.forEach(i => {
                    opts +=
                        `<option value="${i.itemId}">
                            ${i.item_Code} — ${i.item_Description}
                         </option>`;
                });
                $('#fItemId').html(opts).prop('disabled', false);
            }
        });

        // Load Sizes
        $.ajax({
            url:      '/MatrixItemSize/GetSizesByDept?deptId=' + deptId,
            method:   'GET',
            dataType: 'json',
            success: function (sizes) {
                let opts = '<option value="">-- Select Size --</option>';
                sizes.forEach(s => {
                    opts +=
                        `<option value="${s.sizeId}">
                            ${s.itemSize_Code} — ${s.item_Size}
                         </option>`;
                });
                $('#fSizeId').html(opts).prop('disabled', false);
            }
        });
    });

    // ════════════════════════════════════════════
    // RENDER TABLE
    // ════════════════════════════════════════════
    function renderTable() {
        totalPages = Math.max(1,
            Math.ceil(filteredData.length / rowsPerPage));
        if (currentPage > totalPages) currentPage = totalPages;

        const start = (currentPage - 1) * rowsPerPage;
        const end   = Math.min(start + rowsPerPage, filteredData.length);
        const slice = filteredData.slice(start, end);

        $('#tableBody tr:not(#loadingRow)').remove();

        if (slice.length === 0) {
            $('#tableBody').append(
                `<tr><td colspan="9" class="text-center text-muted py-3">
                    No records found.
                 </td></tr>`);
        } else {
            slice.forEach((r, idx) => {
                $('#tableBody').append(buildRow(r, start + idx + 1));
            });
        }

        updatePaginationUI(start, end);
    }

    function buildRow(r, sr) {
        const fmtD = v => v
            ? new Date(v).toLocaleDateString('en-IN') : '—';

        return `
        <tr id="row-${r.MatrixId}">
            <td class="text-center">${sr}</td>
            <td>
                <span class="badge bg-dark" style="font-size:0.60rem">
                    ${r.Department}
                </span>
            </td>
            <td class="fw-bold text-primary">
                ${r.ItemSize_Code || '—'}
            </td>
            <td>${r.Item_Size || '—'}</td>
            <td class="fw-bold text-primary">
                ${r.Item_Code || '—'}
            </td>
            <td>${r.Item_Description || '—'}</td>
          
            <td class="text-center">
                <button class="btn btn-outline-primary btn-sm btn-edit me-1"
                        data-id="${r.MatrixId}" title="Edit">
                    <i class="bi bi-pencil-square"></i>
                </button>
                <button class="btn btn-outline-danger btn-sm btn-del"
                        data-id="${r.MatrixId}"
                        data-label="${r.Item_Code} / ${r.ItemSize_Code}"
                        title="Delete">
                    <i class="bi bi-trash3"></i>
                </button>
            </td>
        </tr>`;
    }

    // ════════════════════════════════════════════
    // FILTER
    // ════════════════════════════════════════════
    window.applyFilter = function () {
        const q    = $('#searchInput').val().toLowerCase().trim();
        const dept = $('#deptFilter').val();

        filteredData = allData.filter(r => {
            const matchDept = !dept ||
                String(r.DepartmentId) === String(dept);
            const matchQ = !q ||
                (r.Item_Code        || '').toLowerCase().includes(q) ||
                (r.Item_Description || '').toLowerCase().includes(q) ||
                (r.ItemSize_Code    || '').toLowerCase().includes(q) ||
                (r.Item_Size        || '').toLowerCase().includes(q);
            return matchDept && matchQ;
        });

        currentPage = 1;
        renderTable();
    };

    // ════════════════════════════════════════════
    // PAGINATION
    // ════════════════════════════════════════════
    function updatePaginationUI(start, end) {
        $('#pageInfo').text(
            filteredData.length === 0
                ? 'No records'
                : `${start+1}–${end} of ${filteredData.length}`);

        $('#btnFirst,#btnPrev').prop('disabled', currentPage === 1);
        $('#btnNext,#btnLast').prop('disabled',  currentPage === totalPages);

        const container = $('#pageNumbers').empty();
        const maxV = 5;
        let sp = Math.max(1, currentPage - Math.floor(maxV/2));
        let ep = Math.min(totalPages, sp + maxV - 1);
        if (ep - sp < maxV - 1) sp = Math.max(1, ep - maxV + 1);

        for (let p = sp; p <= ep; p++) {
            $('<button>')
                .text(p)
                .addClass('btn btn-outline-secondary btn-sm'
                    + (p === currentPage ? ' active-page' : ''))
                .on('click', () => goToPage(p))
                .appendTo(container);
        }
    }

    window.goToPage = function (p) {
        if (p < 1 || p > totalPages) return;
        currentPage = p;
        renderTable();
    };

    window.changeRPP = function () {
        rowsPerPage = parseInt($('#rppSelect').val());
        currentPage = 1;
        renderTable();
    };

    // ════════════════════════════════════════════
    // ADD MODAL
    // ════════════════════════════════════════════
    $('#btnAdd').on('click', function () {
        clearForm();
        $('#modalTitleText').text('Add Matrix');
        // $('#fDate').val(new Date().toISOString().split('T')[0]);
        matrixModal.show();
    });

    // ════════════════════════════════════════════
    // EDIT
    // ════════════════════════════════════════════
    $(document).on('click', '.btn-edit', function () {
        const id = $(this).data('id');

        $.ajax({
            url:      '/MatrixItemSize/GetById?id=' + id,
            method:   'GET',
            dataType: 'json',
            success: function (r) {
                clearForm();
                $('#modalTitleText').text('Edit Matrix');
                $('#fMatrixId').val(r.MatrixId);   // ✅ FIX

                $('#fDeptId').val(r.DepartmentId).trigger('change');
                
                setTimeout(function () {
                    $('#fItemId').val(r.ItemId);
                    $('#fSizeId').val(r.SizeId);

                    $('#fDeptId').prop('disabled', true);
                    $('#fItemId').prop('disabled', true);

                }, 600);

                matrixModal.show();
            },
            error: function () {
                showToast('Failed to load record.', 'danger');
            }
        });
    });

    // ════════════════════════════════════════════
    // SAVE
    // ════════════════════════════════════════════
    $('#btnSave').on('click', function () {
        clearErrors();

        const deptId  = $('#fDeptId').val();
        const itemId  = $('#fItemId').val();
        const sizeId  = $('#fSizeId').val();

        let valid = true;

        if (!deptId) {
            showError('fDeptId', 'err-dept', 'Department is required.');
            valid = false;
        }
        if (!itemId) {
            showError('fItemId', 'err-item', 'Item is required.');
            valid = false;
        }
        if (!sizeId) {
            showError('fSizeId', 'err-size', 'Size is required.');
            valid = false;
        }

        if (!valid) return;

        const token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url:      '/MatrixItemSize/Save',
            method:   'POST',
            dataType: 'json',
            data: {
                MatrixId:     $('#fMatrixId').val(),
                SizeId:       sizeId,
                ItemId:       itemId,
                DepartmentId: deptId,
                // Date:         $('#fDate').val() ||
                //               new Date().toISOString(),
                __RequestVerificationToken: token
            },
            success: function (d) {
                if (!d.success) {
                    showToast(d.message || 'Save failed.', 'danger');
                    return;
                }
                matrixModal.hide();
                showToast(d.message, 'success');
                loadData();
            },
            error: function () {
                showToast('Network error.', 'danger');
            }
        });
    });

    // ════════════════════════════════════════════
    // DELETE
    // ════════════════════════════════════════════
    $(document).on('click', '.btn-del', function () {
        pendingDeleteId = $(this).data('id');
        $('#deleteLabel').text($(this).data('label'));
        deleteModal.show();
    });

    $('#btnConfirmDelete').on('click', function () {
        const token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url:      '/MatrixItemSize/Delete',
            method:   'POST',
            dataType: 'json',
            data: {
                id: pendingDeleteId,
                __RequestVerificationToken: token
            },
            success: function (d) {
                deleteModal.hide();
                if (d.success) {
                    allData      = allData.filter(
                        r => r.MatrixId !== pendingDeleteId);
                    filteredData = filteredData.filter(
                        r => r.MatrixId !== pendingDeleteId);
                    renderTable();
                    showToast('Record deleted.', 'success');
                      loadData();
                } else {
                    showToast('Delete failed.', 'danger');
                     
                }
            },
            error: function () {
                showToast('Network error.', 'danger');
            }
        });
    });

    // ════════════════════════════════════════════
    // HELPERS
    // ════════════════════════════════════════════
    function clearForm() {
        $('#fMatrixId').val('0');
        // $('#fDeptId').val('');
         $('#fDeptId').val('').prop('disabled', false);   // ✅ enable
        $('#fItemId')
        .prop('disabled', false)
        .html('<option value="">-- Select Item --</option>');
        $('#fItemId, #fSizeId')
            .prop('disabled', true)
            .html('<option value="">-- Select Department first --</option>');
        $('#fDate').val('');
        clearErrors();
    }

   

    function clearErrors() {
        $('.invalid-feedback.d-block').text('');
        $('#matrixForm .form-control, #matrixForm .form-select')
            .removeClass('is-invalid');
    }

    function showError(fieldId, errId, msg) {
        $('#' + fieldId).addClass('is-invalid');
        $('#' + errId).text(msg);
    }

    function showToast(msg, type) {
        toastEl.className =
            `toast align-items-center text-white border-0 bg-${type}`;
        $('#toastMsg').text(msg);
        bsToast.show();
    }

    // ── INIT ──
    loadDepartments();
    loadData();

});
</script>
}