@{ ViewData["Title"] = "Dashboard"; }

<div class="row g-3 mt-1">

    <!-- Welcome banner -->
    <div class="col-12">
        <div class="alert alert-dark d-flex align-items-center py-2 mb-0">
            <i class="bi bi-person-circle fs-4 me-2"></i>
            <div>
                Welcome, <strong>@ViewBag.UserName</strong>
                &nbsp;
                <span class="badge
                    bg-@(ViewBag.UserRole == "Admin" ? "danger"
                       : ViewBag.UserRole == "MD"    ? "danger"
                       : ViewBag.UserRole == "CEO"   ? "danger"
                       : ViewBag.UserRole == "HOD"   ? "warning"
                       : ViewBag.UserRole == "Supervisor" ? "info"
                       : "primary")">
                    @ViewBag.UserRole
                </span>
            </div>
        </div>
    </div>

    <!-- Invoice card — User + Supervisor + Admin/MD/CEO/HOD -->
    @if ((bool)ViewBag.HasInvoice)
    {
        <div class="col-md-3">
            <a asp-controller="Invoice" asp-action="InvoiceView"
               class="text-decoration-none">
                <div class="card border-primary h-100 text-center py-4 shadow-sm hover-card">
                    <i class="bi bi-receipt fs-1 text-primary"></i>
                    <div class="mt-2 fw-bold">Invoice</div>
                    <small class="text-muted">Create &amp; Download</small>
                </div>
            </a>
        </div>
    }

    <!-- Master cards — Admin / MD / CEO / HOD only -->
    @if ((bool)ViewBag.IsAdmin)
    {
        <div class="col-md-3">
            <a asp-controller="Company" asp-action="CompanyView"
               class="text-decoration-none">
                <div class="card border-success h-100 text-center py-4 shadow-sm hover-card">
                    <i class="bi bi-building fs-1 text-primary"></i>
                    <div class="mt-2 fw-bold">Company Master</div>
                    <small class="text-muted">Manage Companies</small>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-controller="Item" asp-action="ItemView"
               class="text-decoration-none">
                <div class="card border-warning h-100 text-center py-4 shadow-sm hover-card">
                    <i class="bi bi-box-seam fs-1 text-warning"></i>
                    <div class="mt-2 fw-bold">Item Master</div>
                    <small class="text-muted">Manage Items</small>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-controller="Transport" asp-action="TransportView"
               class="text-decoration-none">
                <div class="card border-info h-100 text-center py-4 shadow-sm hover-card">
                    <i class="bi bi-truck fs-1 text-info"></i>
                    <div class="mt-2 fw-bold">Transport Master</div>
                    <small class="text-muted">Manage Modes</small>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-controller="Auth" asp-action="Users"
               class="text-decoration-none">
                <div class="card border-danger h-100 text-center py-4 shadow-sm hover-card">
                    <i class="bi bi-people fs-1 text-danger"></i>
                    <div class="mt-2 fw-bold">User Management</div>
                    <small class="text-muted">Admin / MD / CEO / HOD</small>
                </div>
            </a>
        </div>
    }

    <!-- No access message for Supervisor (invoice only) -->
    @if (ViewBag.UserRole == "Supervisor")
    {
        <div class="col-12">
            <div class="alert alert-info py-2 small mb-0">
                <i class="bi bi-info-circle me-1"></i>
                You have <strong>Invoice access only</strong>.
                Contact your Admin to request additional access.
            </div>
        </div>
    }

</div>

<style>
    .hover-card {
        transition: transform .15s, box-shadow .15s;
        cursor: pointer;
    }
    .hover-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 6px 20px rgba(0,0,0,.12) !important;
    }
</style>