@{
    ViewData["Title"] = "Manual Schedule vs Dispatch";
}

<style>
    :root {
        --header-bg: #1a1a4e;
        --row-odd: #f8f9fa;
        --row-even: #eff0ff;
        --row-hover: #c8cbff;
    }

    /* HEADER */
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 10px;
    }

        .page-header h6 {
            margin: 0;
            font-weight: 700;
        }

    .header-controls {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
    }

    /* MAIN TABLE */
    #msTable {
        width: 100%;
        min-width: 1250px;
        font-size: 0.70rem;
    }

        #msTable thead th {
            font-size: 0.67rem;
            padding: 4px 5px;
            white-space: nowrap;
            text-align: center;
            background: var(--header-bg);
            color: #fff;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        #msTable tbody td {
            padding: 3px 5px;
            vertical-align: middle;
            white-space: nowrap;
        }

        #msTable tbody tr:nth-child(odd) td {
            background: #f8f9fa;
        }

        #msTable tbody tr:nth-child(even) td {
            background: #eff0ff;
        }

        #msTable tbody tr:hover td {
            background: var(--row-hover) !important;
            cursor: pointer;
        }

        #msTable .btn-sm {
            padding: 1px 4px;
            font-size: 0.65rem;
        }

    /* REPORT TABLE */
    #reportTable {
        width: 100%;
        min-width: 2200px;
        font-size: 0.64rem;
    }

        #reportTable thead th {
            background: var(--header-bg);
            color: #fff;
            padding: 3px 4px;
            text-align: center;
            white-space: nowrap;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        #reportTable tbody td {
            padding: 2px 4px;
            text-align: center;
            white-space: nowrap;
        }

        #reportTable tbody tr:nth-child(odd) td {
            background: #f8f9fa;
        }

        #reportTable tbody tr:nth-child(even) td {
            background: #eff0ff;
        }

    .req-cell {
        color: #0d6efd;
        font-weight: 600;
    }

    .dis-cell {
        color: #198754;
        font-weight: 600;
    }

    .zero-cell {
        color: #adb5bd;
    }

    .day-header-req {
        background: #dbeafe !important;
        color: #1d4ed8 !important;
    }

    .day-header-dis {
        background: #dcfce7 !important;
        color: #166534 !important;
    }

    /* TABLE WRAP */
    .table-wrap {
        max-height: 450px;
        overflow-y: auto;
        overflow-x: auto;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        -webkit-overflow-scrolling: touch;
    }

    /* PAGINATION */
    .pagination-bar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 6px;
        font-size: 0.72rem;
    }

        .pagination-bar button {
            min-width: 28px;
            height: 26px;
            font-size: 0.68rem;
            padding: 0 5px;
            border-radius: 4px;
        }

            .pagination-bar button.active-pg {
                background: #4f46e5;
                color: #fff;
                border-color: #4f46e5;
            }

    /* REPORT BAR */
    .report-bar {
        background: #f1f5f9;
        border-radius: 6px;
        padding: 8px 12px;
        margin-bottom: 8px;
        font-size: 0.71rem;
    }

    /* MODAL */
    .modal .form-label {
        margin-bottom: 3px;
    }

    .modal .input-group-text {
        height: 31px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal .form-control-sm,
    .modal .form-select-sm {
        font-size: 0.75rem;
    }

    /* LOADING */
    #loadingRow td {
        text-align: center;
        padding: 20px;
        color: #888;
    }

    /* MOBILE */
    @@media (max-width:575px) {

        .page-header {
            flex-direction: column;
            align-items: stretch;
        }

        .header-controls {
            flex-direction: column;
            align-items: stretch;
        }

            .header-controls select,
            .header-controls input,
            .header-controls button {
                width: 100% !important;
            }

        #msTable {
            min-width: 1250px;
        }

        #reportTable {
            min-width: 2200px;
        }

        .pagination-bar {
            justify-content: center;
        }

            .pagination-bar #pageNumbers {
                flex-wrap: wrap;
            }

        .modal-dialog {
            margin: .5rem;
        }

        .modal .row > div {
            margin-bottom: 2px;
        }
    }

    /* TABLET */
    @@media (min-width:576px) and (max-width:991px) {

        #msTable {
            min-width: 1200px;
        }

        #reportTable {
            min-width: 2000px;
        }

        .pagination-bar {
            justify-content: center;
        }
    }
</style>

<!-- ── PAGE HEADER ── -->
<div class="page-header">
    <h6 class="mb-0 fw-bold">
        <i class="bi bi-table me-2 text-primary"
           style="color:#4f46e5!important"></i>
        Manual Customer Schedule vs Dispatch
    </h6>
    <div class="header-controls">

       <select id="deptFilter" class="form-select form-select-sm"
        style="width:150px">
            <option value="0">-- Department --</option>
        </select>

        <select id="monthFilter" class="form-select form-select-sm"
                style="width:110px">
            <option value="1">January</option>
            <option value="2">February</option>
            <option value="3">March</option>
            <option value="4">April</option>
            <option value="5">May</option>
            <option value="6">June</option>
            <option value="7">July</option>
            <option value="8">August</option>
            <option value="9">September</option>
            <option value="10">October</option>
            <option value="11">November</option>
            <option value="12">December</option>
        </select>

        <input type="text" id="searchInput"
               class="form-control form-control-sm"
               placeholder="🔍 Search..."
               style="width:145px" oninput="applyFilter()" />

        <button class="btn btn-sm" id="btnAdd"
                style="background:#4f46e5;color:#fff">
            <i class="bi bi-plus-lg me-1"></i>Add Entry
        </button>
    </div>
</div>


<!-- ═══ DATA ENTRY TAB ═══ -->
<div id="panelEntry">
    <div class="table-wrap">
        <table class="table table-bordered mb-0" id="msTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Department</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Item Code</th>
                    <th>Description</th>
                    <th>Tentative PO</th>
                    <th>Req Qty</th>
                    <th>Dis Qty</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                <tr id="loadingRow">
                    <td colspan="11">
                        <i class="bi bi-info-circle me-2"
                           style="color:#4f46e5"></i>
                        Select Department and Month then click Load.
                    </td>
                </tr>
            </tbody>
            
        </table>
    </div>
    <div class="pagination-bar">
        <span id="pageInfo" class="text-muted"></span>
        <button class="btn btn-outline-secondary btn-sm"
                id="btnFirst" onclick="goToPage(1)">«</button>
        <button class="btn btn-outline-secondary btn-sm"
                id="btnPrev"  onclick="goToPage(currentPage-1)">‹</button>
        <span id="pageNumbers" class="d-flex gap-1"></span>
        <button class="btn btn-outline-secondary btn-sm"
                id="btnNext"  onclick="goToPage(currentPage+1)">›</button>
        <button class="btn btn-outline-secondary btn-sm"
                id="btnLast"  onclick="goToPage(totalPages)">»</button>
        <select id="rppSelect" class="form-select form-select-sm"
                style="width:75px" onchange="changeRPP()">
            <option value="10" selected>10</option>
            <option value="20">20</option>
            <option value="50">50</option>
        </select>
        <span class="text-muted">/ page</span>
    </div>
</div>
<!-- ══════════════════════════════════════════════
     ADD / EDIT MODAL
══════════════════════════════════════════════ -->
<div class="modal fade" id="msModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-dark text-white py-2">
                <h6 class="modal-title mb-0">
                    <i class="bi bi-table me-2"></i>
                    <span id="modalTitleText">Add Schedule Entry</span>
                </h6>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="msForm" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="fSrNo"value="0" />

                    <div class="row g-2">
                       <!-- Department -->
    <div class="col-md-3">
        <label class="form-label fw-semibold small">
            Department <span class="text-danger">*</span>
        </label>

        <div class="input-group input-group-sm">
            <span class="input-group-text">
                <i class="bi bi-diagram-3"></i>
            </span>

            <select id="fDepartmentId"
                    class="form-select form-select-sm"
                    onchange="onFormDepartmentChange()">
                <option value="0">-- Select Department --</option>
            </select>
        </div>

        <div class="invalid-feedback d-block"
             id="err-dept"></div>
    </div>
                        <!-- Customer -->
                        <div class="col-md-5">
                            <label class="form-label fw-semibold small">
                                Customer
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-person-lines-fill"></i>
                                </span>
                                <select id="fCustomerId"
                                        class="form-select form-select-sm"
                                        onchange="onCustomerChange()">
                                    <option value="0">
                                        -- Select Customer --
                                    </option>
                                </select>
                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-customer"></div>
                        </div>

                        <!-- Date -->
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">
                                Date
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-calendar3"></i>
                                </span>
                                <input type="date" id="fDate"
                                       class="form-control form-control-sm" />
                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-date"></div>
                        </div>

                        <!-- Item — cascade from customer+dept -->
                        <div class="col-md-7">
                            <label class="form-label fw-semibold small">
                                Item Code
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-upc-scan"></i>
                                </span>
                                <select id="fItemId"
                                        class="form-select form-select-sm"
                                        disabled
                                        onchange="onItemChange()">
                                    <option value="0">
                                        -- Select Customer first --
                                    </option>
                                </select>
                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-item"></div>
                        </div>

                        <!-- Item Description -->
                        <div class="col-md-5">
                            <label class="form-label fw-semibold small">
                                Description
                            </label>
                            <input type="text" id="fItemDesc"
                                   class="form-control form-control-sm bg-light"
                                   readonly
                                   placeholder="Auto-filled" />
                        </div>

                        <!-- Tentative PO Qty -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Tentative PO Qty
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-clipboard-check"></i>
                                </span>
                                <input type="number" id="fTentativePO"
                                       class="form-control form-control-sm"
                                       min="0" step="1" placeholder="0" />
                            </div>
                        </div>

                        <!-- Req Quantity -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Required Quantity
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text text-primary">
                                    <i class="bi bi-box-arrow-in-down"></i>
                                </span>
                                <input type="number" id="fReqQty"
                                       class="form-control form-control-sm"
                                       min="0" step="1" placeholder="0" />
                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-req"></div>
                        </div>

                        <!-- Dis Quantity -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Dispatched Quantity
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text text-success">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </span>
                                <input type="number" id="fDisQty"
                                       class="form-control form-control-sm"
                                       min="0" step="1" placeholder="0" />
                            </div>
                        </div>

                    </div>
                </form>
            </div>

            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-sm" id="btnSave"
                        style="background:#4f46e5;color:#fff">
                    <i class="bi bi-floppy me-1"></i>Save
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ── DELETE CONFIRM MODAL ── -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white py-2">
                <h6 class="modal-title mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Confirm Delete
                </h6>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center small">
                <p class="mb-1">Delete schedule record</p>
                <strong id="deleteLabel"></strong>?
            </div>
            <div class="modal-footer justify-content-center py-2">
                <button class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-danger btn-sm"
                        id="btnConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- ── TOAST ── -->
<div class="position-fixed top-0 end-0 p-3" style="z-index:9999">
    <div id="toast" class="toast align-items-center text-white border-0"
         role="alert" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body small" id="toastMsg"></div>
            <button type="button"
                    class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
$(function () {

    // ════════════════════════════════════════════
    // STATE
    // ════════════════════════════════════════════
    let allData         = [];
    let filteredData    = [];
    let currentPage     = 1;
    let rowsPerPage     = 10;
    let totalPages      = 1;
    let pendingDeleteId = null;
    let currentDeptId   = 0;
    let itemDescMap     = {};

    const msModal     = new bootstrap.Modal($('#msModal')[0]);
    const deleteModal = new bootstrap.Modal($('#deleteModal')[0]);
    const toastEl     = $('#toast')[0];
    const bsToast     = new bootstrap.Toast(toastEl, { delay: 3500 });

    // ── Set current month ──
    const now = new Date();
    $('#monthFilter').val(now.getMonth() + 1);

    

    // ════════════════════════════════════════════
    // INIT
    // ════════════════════════════════════════════
  $.ajax({
    url: '/ManualScheduleDispatch/GetDepartments',
    method: 'GET',
    dataType: 'json',
    success: function (depts) {

        let headerOpts =
            '<option value="0">-- Department --</option>';

        let formOpts =
            '<option value="0">-- Select Department --</option>';

        depts.forEach(d => {

            headerOpts += `
                <option value="${d.DepartmentId}">
                    ${d.Department}
                </option>`;

            formOpts += `
                <option value="${d.DepartmentId}">
                    ${d.Department}
                </option>`;
        });

        $('#deptFilter').html(headerOpts);
        $('#fDepartmentId').html(formOpts);
    }
});

    $.ajax({
        url: '/ManualScheduleDispatch/GetCustomers',
        method: 'GET', dataType: 'json',
       success: function (custs) {
    let modalOpts =
        '<option value="0">-- Select Customer --</option>';

    custs.forEach(c => {
        modalOpts += `<option value="${c.customerId}">
                        ${c.customer}
                      </option>`;
    });

    $('#fCustomerId').html(modalOpts);
}
    });


    // ════════════════════════════════════════════
    // LOAD BUTTON
    // ════════════════════════════════════════════
   $('#deptFilter, #monthFilter').on('change', function () {

    currentDeptId = parseInt($('#deptFilter').val()) || 0;
    const monthId = parseInt($('#monthFilter').val()) || 0;

    if (!currentDeptId || !monthId)
        return;

    $('#fDepartmentId').val(currentDeptId);

    loadData(currentDeptId, monthId);
});

    // ════════════════════════════════════════════
    // CUSTOMER CHANGE → cascade items
    // ════════════════════════════════════════════
    window.onCustomerChange = function () {
        const custId = parseInt($('#fCustomerId').val()) || 0;
        const deptId = parseInt($('#fDepartmentId').val()) || 0;

        itemDescMap = {};
        $('#fItemId')
            .html('<option value="0">-- Loading... --</option>')
            .prop('disabled', true);
        $('#fItemDesc').val('');

        if (!custId || !deptId) {
            $('#fItemId')
                .html('<option value="0">-- Select Customer first --</option>');
            return;
        }

        $.ajax({
            url: `/ManualScheduleDispatch/GetItemsByDeptCustomer` +
                 `?deptId=${deptId}&customerId=${custId}`,
            method: 'GET', dataType: 'json',
            success: function (items) {
                let opts =
                    '<option value="0">-- Select Item --</option>';
                items.forEach(i => {
                    itemDescMap[i.itemId] = i.item_Description;
                    opts += `<option value="${i.itemId}"
                                     data-desc="${i.item_Description}">
                                ${i.item_Code}
                             </option>`;
                });
                $('#fItemId').html(opts).prop('disabled', false);
            },
            error: function () {
                $('#fItemId')
                    .html('<option value="0">-- Load failed --</option>');
            }
        });
    };

    // ── Item change → description ──
    window.onItemChange = function () {
        const sel  = $('#fItemId')[0];
        const opt  = sel.options[sel.selectedIndex];
        const desc = opt.getAttribute('data-desc') || '';
        $('#fItemDesc').val(desc);
    };

    // ════════════════════════════════════════════
    // LOAD DATA (Entry Tab)
    // ════════════════════════════════════════════
    function loadData(deptId, monthId) {
        $('#loadingRow').show()
            .find('td').html(
                '<div class="spinner-border spinner-border-sm ' +
                'me-2" style="color:#4f46e5"></div>Loading...');
        $('#tableBody tr:not(#loadingRow)').remove();

        $.ajax({
            url: `/ManualScheduleDispatch/GetAll` +
                 `?deptId=${deptId}&monthId=${monthId}`,
            method: 'GET', dataType: 'json',
            success: function (data) {
                allData = data;
                applyFilter();
                $('#loadingRow').hide();
            },
            error: function () {
                $('#loadingRow td').html(
                    '<i class="bi bi-exclamation-triangle ' +
                    'text-danger me-1"></i>Failed to load data.');
            }
        });
    }

    // ════════════════════════════════════════════
    // RENDER TABLE
    // ════════════════════════════════════════════
    function renderTable() {
        totalPages = Math.max(1,
            Math.ceil(filteredData.length / rowsPerPage));
        if (currentPage > totalPages) currentPage = totalPages;

        const start = (currentPage - 1) * rowsPerPage;
        const end   = Math.min(start + rowsPerPage, filteredData.length);
        const slice = filteredData.slice(start, end);

        $('#tableBody tr:not(#loadingRow)').remove();

        if (slice.length === 0) {
            $('#tableBody').append(
                `<tr><td colspan="11"
                    class="text-center text-muted py-3">
                    No records found.
                 </td></tr>`);
        } else {
            slice.forEach((r, i) =>
                $('#tableBody').append(buildRow(r, start+i+1)));
        }

        updatePagination(start, end);
    }

    function buildRow(r, sr) {
        const fmt  = v => v || '—';
        const fmtN = v => {
            const n = parseInt(v) || 0;
            return n > 0
                ? n.toLocaleString('en-IN') : '—';
        };

        const reqVsDis = (() => {
            const req = parseInt(r.Req_Quantity) || 0;
            const dis = parseInt(r.Dis_Quantity) || 0;
            if (req === 0 && dis === 0) return '';
            const pct = req > 0 ? Math.round((dis / req) * 100) : 0;
            const color = pct >= 100 ? '#198754'
                        : pct >= 50  ? '#ffc107' : '#dc3545';
            return `<div style="font-size:0.58rem;color:${color}">
                        ${dis}/${req} (${pct}%)
                    </div>`;
        })();

        return `
        <tr id="row-${r.SrNo}">
            <td class="text-center">${sr}</td>
            <td>
                <span class="badge bg-dark" style="font-size:0.60rem">
                    ${fmt(r.Department)}
                </span>
            </td>
            <td class="fw-bold text-primary">${fmt(r.Customer)}</td>
            <td class="text-center">${fmt(r.Date)}</td>
            <td class="fw-bold" style="color:#4f46e5">
                ${fmt(r.Item_Code)}
            </td>
            <td title="${fmt(r.Item_Description)}">
                ${fmt(r.Item_Description)}
            </td>
            <td class="text-center">
                ${r.Tentative_PO_Qty > 0
                    ? `<span class="badge bg-secondary">
                           ${r.Tentative_PO_Qty}
                       </span>` : '—'}
            </td>
            <td class="text-center text-primary fw-bold">
                ${fmtN(r.Req_Quantity)}
            </td>
            <td class="text-center">
                <span class="text-success fw-bold">
                    ${fmtN(r.Dis_Quantity)}
                </span>
                ${reqVsDis}
            </td>
            
            <td class="text-center">
                <button class="btn btn-outline-primary btn-sm btn-edit"
                        data-id="${r.SrNo}" title="Edit">
                    <i class="bi bi-pencil-square"></i>
                </button>
                <button class="btn btn-outline-danger btn-sm btn-del"
                        data-id="${r.SrNo}"
                        data-label="${fmt(r.Customer)} / ${fmt(r.Item_Code)}"
                        title="Delete">
                    <i class="bi bi-trash3"></i>
                </button>
            </td>
        </tr>`;
    }

    // ════════════════════════════════════════════
    // FILTER
    // ════════════════════════════════════════════
    window.applyFilter = function () {
        const q = $('#searchInput').val().toLowerCase().trim();
        filteredData = allData.filter(r =>
            !q ||
            (r.Customer        || '').toLowerCase().includes(q) ||
            (r.Item_Code       || '').toLowerCase().includes(q) ||
            (r.Item_Description|| '').toLowerCase().includes(q)
        );
        currentPage = 1;
        renderTable();
    };

    // ════════════════════════════════════════════
    // PAGINATION
    // ════════════════════════════════════════════
    function updatePagination(start, end) {
        $('#pageInfo').text(
            filteredData.length === 0
                ? 'No records'
                : `${start+1}–${end} of ${filteredData.length}`);

        $('#btnFirst,#btnPrev').prop('disabled', currentPage === 1);
        $('#btnNext,#btnLast').prop('disabled',  currentPage === totalPages);

        const container = $('#pageNumbers').empty();
        const maxV = 5;
        let sp = Math.max(1, currentPage - Math.floor(maxV/2));
        let ep = Math.min(totalPages, sp + maxV - 1);
        if (ep - sp < maxV - 1) sp = Math.max(1, ep - maxV + 1);

        for (let p = sp; p <= ep; p++) {
            $('<button>').text(p)
                .addClass('btn btn-outline-secondary btn-sm'
                    + (p === currentPage ? ' active-pg' : ''))
                .on('click', () => goToPage(p))
                .appendTo(container);
        }
    }

    window.goToPage = function (p) {
        if (p < 1 || p > totalPages) return;
        currentPage = p; renderTable();
    };
    window.changeRPP = function () {
        rowsPerPage = parseInt($('#rppSelect').val());
        currentPage = 1; renderTable();
    };

    

    // ════════════════════════════════════════════
    // ADD MODAL
    // ════════════════════════════════════════════
    $('#btnAdd').on('click', function () {

    clearForm();

    $('#modalTitleText').text('Add Schedule Entry');

    $('#fDate').val(
        new Date().toISOString().split('T')[0]
    );

    msModal.show();
});

    // ════════════════════════════════════════════
    // EDIT
    // ════════════════════════════════════════════
    $(document).on('click', '.btn-edit', function () {
        const id = parseInt($(this).data('id'));
        const r  = allData.find(x => x.SrNo === id);
        if (!r) return;

        clearForm();
        $('#modalTitleText').text('Edit Schedule Entry');
        $('#fSrNo').val(r.SrNo);
        $('#fDepartmentId')
    .val(r.DepartmentId || r.departmentId)
    .prop('disabled', true);
        $('#fCustomerId').val(r.CustomerId);

        // Populate item in read-only for edit
        $('#fItemId')
            .html(`<option value="${r.ItemId}">
                       ${r.Item_Code}
                   </option>`)
            .val(r.ItemId)
            .prop('disabled', true);
        $('#fItemDesc').val(r.Item_Description);
        $('#fTentativePO').val(r.Tentative_PO_Qty);
        $('#fReqQty').val(r.Req_Quantity);
        $('#fDisQty').val(r.Dis_Quantity);
       
//         const dt = r.Date || r.date;

// $('#fDate').val(
//     dt ? dt.split('T')[0] : ''
// );

 $('#fDate').val(r.Add_Date);
        msModal.show();
    });

    // ════════════════════════════════════════════
    // SAVE
    // ════════════════════════════════════════════
    $('#btnSave').on('click', function () {
        clearErrors();
        const deptId = parseInt($('#fDepartmentId').val()) || 0;
        const custId = parseInt($('#fCustomerId').val()) || 0;
        const itemId = parseInt($('#fItemId').val())     || 0;
        const reqQty = parseInt($('#fReqQty').val())     || 0;
        const date   = $('#fDate').val();

        let valid = true;
        if (!deptId) {
    showError(
        'fDepartmentId',
        'err-dept',
        'Department required.'
    );
    valid = false;
}
        if (!custId) {
            showError('fCustomerId','err-customer',
                'Customer required.'); valid = false;
        }
        if (!itemId) {
            showError('fItemId','err-item',
                'Item required.'); valid = false;
        }
        if (reqQty < 0) {
            showError('fReqQty','err-req',
                'Req Qty cannot be negative.'); valid = false;
        }
        if (!date) {
            showError('fDate','err-date',
                'Date required.'); valid = false;
        }
        if (!valid) return;

        const token =
            $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url:      '/ManualScheduleDispatch/Save',
            method:   'POST',
            dataType: 'json',
            data: {
                SrNo:             $('#fSrNo').val(),
                DepartmentId: deptId,
                CustomerId:       custId,
                ItemId:           itemId,
                Tentative_PO_Qty: parseInt($('#fTentativePO').val()) || 0,
                Req_Quantity:     reqQty,
                Dis_Quantity:     parseInt($('#fDisQty').val())      || 0,
                Date:             date,
                __RequestVerificationToken: token
            },
            success: function (d) {
                if (!d.success) {
                    showToast(d.message || 'Save failed.', 'danger');
                    return;
                }
                msModal.hide();
                showToast(d.message, 'success');
                const deptId  = currentDeptId;
                const monthId = parseInt($('#monthFilter').val()) || 0;
                loadData(deptId, monthId);
            },
            error: function () {
                showToast('Network error.', 'danger');
            }
        });
    });

    // ════════════════════════════════════════════
    // DELETE
    // ════════════════════════════════════════════
    $(document).on('click', '.btn-del', function () {
        pendingDeleteId = parseInt($(this).data('id'));
        $('#deleteLabel').text($(this).data('label'));
        deleteModal.show();
    });

    $('#btnConfirmDelete').on('click', function () {
        const token =
            $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url:      '/ManualScheduleDispatch/Delete',
            method:   'POST',
            dataType: 'json',
            data: { srNo: pendingDeleteId,
                    __RequestVerificationToken: token },
            success: function (d) {
                deleteModal.hide();
                if (d.success) {
                    allData      = allData.filter(
                        r => r.SrNo !== pendingDeleteId);
                    filteredData = filteredData.filter(
                        r => r.SrNo !== pendingDeleteId);
                    renderTable();
                    showToast('Record deleted.', 'success');
                } else {
                    showToast('Delete failed.', 'danger');
                }
            },
            error: function () {
                showToast('Network error.', 'danger');
            }
        });
    });

    // ════════════════════════════════════════════
    // HELPERS
    // ════════════════════════════════════════════
    function clearForm() {
        $('#fDepartmentId')
    .val('0')
    .prop('disabled', false);
        $('#fSrNo').val('0');
        $('#fCustomerId').val('0');
        $('#fItemId')
            .html('<option value="0">-- Select Customer first --</option>')
            .prop('disabled', true);
        $('#fItemDesc').val('');
        $('#fTentativePO,#fReqQty,#fDisQty').val('');
        $('#fDate').val('');
        clearErrors();
    }

    function clearErrors() {
        $('.invalid-feedback.d-block').text('');
        $('#msForm .form-control, #msForm .form-select')
            .removeClass('is-invalid');
    }

    function showError(fieldId, errId, msg) {
        $('#' + fieldId).addClass('is-invalid');
        $('#' + errId).text(msg);
    }

    function showToast(msg, type) {
        toastEl.className =
            `toast align-items-center text-white border-0 bg-${type}`;
        $('#toastMsg').text(msg);
        bsToast.show();
    }

});
</script>
}