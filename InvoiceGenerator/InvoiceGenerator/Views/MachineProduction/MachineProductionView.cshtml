@{
    ViewData["Title"] = "Machine Production Data";
}
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<style>
    /* ════════════════════════════════════════
       CSS VARIABLES
    ════════════════════════════════════════ */
    :root {
        --header-bg: #1a1a2e;
        --row-odd: #f8f9fa;
        --row-even: #eef2ff;
        --row-hover: #cfe2ff;
        --font-xs: 0.72rem;
        --font-xxs: 0.69rem;
        --font-tiny: 0.67rem;
    }

    /* ════════════════════════════════════════
       PAGE HEADER
    ════════════════════════════════════════ */
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 10px;
    }

        .page-header h6 {
            margin: 0;
            font-weight: 700;
            white-space: nowrap;
            word-break: break-word;
        }

    .header-controls {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
    }

        .header-controls select,
        .header-controls input[type="text"] {
            font-size: 0.78rem;
        }

    /* ════════════════════════════════════════
       TABLE
    ════════════════════════════════════════ */
    #prodTable {
        width: 100%;
        min-width: 1200px;
        font-size: 0.70rem;
    }

        #prodTable thead th {
            font-size: 0.67rem;
            padding: 4px 5px;
            white-space: nowrap;
            text-align: center;
            background: var(--header-bg);
            color: #fff;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        #prodTable tbody td {
            padding: 3px 5px;
            vertical-align: middle;
            white-space: nowrap;
        }

        #prodTable tbody tr:nth-child(odd) td {
            background-color: var(--row-odd);
        }

        #prodTable tbody tr:nth-child(even) td {
            background-color: var(--row-even);
        }

        #prodTable tbody tr:hover td {
            background-color: var(--row-hover) !important;
            cursor: pointer;
            transition: background-color 0.15s;
        }

        #prodTable .btn-sm {
            padding: 1px 4px;
            font-size: 0.65rem;
        }

    /* ════════════════════════════════════════
       TABLE WRAPPER
    ════════════════════════════════════════ */
    .table-wrap {
        max-height: 450px;
        overflow-y: auto;
        overflow-x: auto;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        -webkit-overflow-scrolling: touch;
    }

    /* ════════════════════════════════════════
       PAGINATION
    ════════════════════════════════════════ */
    .pagination-bar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 8px;
        font-size: 0.72rem;
    }

        .pagination-bar button {
            min-width: 28px;
            height: 26px;
            font-size: 0.68rem;
            padding: 0 5px;
            border-radius: 4px;
        }

            .pagination-bar button.active-pg {
                background: #0d6efd;
                color: #fff;
                border-color: #0d6efd;
            }

    /* ════════════════════════════════════════
           SELECT2
        ════════════════════════════════════════ */


    .select2-wrapper {
        flex: 1 1 auto;
        width: 100%;
    }

    .select2-container {
        width: 100% !important;
    }

    .select2-container--default .select2-selection--single {
        height: 31px !important;
        border: 1px solid #ced4da !important;
        border-radius: 0 .25rem .25rem 0 !important;
        display: flex !important;
        align-items: center !important;
    }

    .select2-selection__rendered {
        line-height: normal !important;
        display: flex !important;
        align-items: center !important;
        height: 100%;
        padding-left: 6px !important;
    }

    .select2-selection__arrow {
        height: 100% !important;
        top: 0 !important;
    }
    /* ════════════════════════════════════════
       VALIDATION PANELS
    ════════════════════════════════════════ */
    .val-panel {
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 0.70rem;
        text-align: center;
        height: 100%;
    }

        .val-panel .val {
            font-size: 1rem;
            font-weight: 700;
        }

    .panel-plan {
        background: #e8f0ff;
        border: 1px solid #0d6efd;
    }

    .panel-prod {
        background: #e8f8e8;
        border: 1px solid #198754;
    }

    .panel-warn {
        background: #fff3cd;
        border: 1px solid #ffc107;
    }

    .panel-err {
        background: #f8d7da;
        border: 1px solid #dc3545;
    }

    /* ════════════════════════════════════════
       MODAL
    ════════════════════════════════════════ */
    .modal .form-label {
        margin-bottom: 3px;
    }

    .modal .input-group-text {
        height: 31px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal .form-control-sm,
    .modal .form-select-sm {
        font-size: 0.75rem;
    }

    /* ════════════════════════════════════════
       LOADING
    ════════════════════════════════════════ */
    #loadingRow td {
        text-align: center;
        padding: 20px;
        color: #888;
    }

    /* ════════════════════════════════════════
       MOBILE RESPONSIVE
    ════════════════════════════════════════ */
    @@media (max-width:575px) {

        .page-header {
            flex-direction: column;
            align-items: stretch;
            overflow: hidden;
        }

            .page-header h6 {
                font-size: 0.90rem;
            }

        .header-controls {
            flex-direction: column;
            align-items: stretch;
        }

            .header-controls select,
            .header-controls input,
            .header-controls button {
                width: 100% !important;
            }

        .table-wrap {
            display: block;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        #prodTable {
            min-width: 1200px;
        }

        .pagination-bar {
            justify-content: center;
        }

            .pagination-bar #pageNumbers {
                flex-wrap: wrap;
            }

            .pagination-bar button {
                min-width: 30px;
            }

        #rppSelect {
            width: 75px !important;
        }

        .modal-dialog {
            margin: 0.5rem;
        }

        .modal .row > div {
            margin-bottom: 2px;
        }

        .val-panel {
            padding: 6px;
        }

            .val-panel .val {
                font-size: 0.90rem;
            }
    }

    /* ════════════════════════════════════════
       TABLET RESPONSIVE
    ════════════════════════════════════════ */
    @@media (min-width:576px) and (max-width:991px) {

        .page-header {
            align-items: flex-start;
        }

        .header-controls {
            justify-content: flex-end;
        }

        #prodTable {
            min-width: 1150px;
        }

        .pagination-bar {
            justify-content: center;
        }
    }</style>

<!-- ── PAGE HEADER ── -->
    <div class="page-header">
    <h6 class="mb-0 fw-bold">
        <i class="bi bi-gear-wide-connected me-2 text-primary"></i>
        Machine Production Data Entry
    </h6>
    <div class="header-controls">

        <select id="headerDeptFilter"
                class="form-select form-select-sm"
                style="width:160px">
            <option value="0">-- Department --</option>
        </select>

        <input type="text" id="searchInput"
               class="form-control form-control-sm"
               placeholder="🔍 Search..."
               style="width:155px" oninput="applyFilter()" />

      

       <button class="btn btn-primary btn-sm" id="btnAdd">
            <i class="bi bi-plus-lg me-1"></i>Add Entry
        </button>
    </div>
</div>

<!-- ── TABLE ── -->
<div class="table-wrap">
    <table class="table table-bordered mb-0" id="prodTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Department</th>
                <th>Date</th>
                <th>Shift</th>
                <th>Machine</th>
                <th>Item Code</th>
                <th>Description</th>
                <th>Quantity</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="tableBody">
            <tr id="loadingRow">
                <td colspan="9">
                    <i class="bi bi-info-circle text-primary me-2"></i>
                    Select Department to view records.
                </td>
            </tr>
        </tbody>
        
    </table>
</div>

<!-- ── PAGINATION ── -->
<div class="pagination-bar">
    <span id="pageInfo" class="text-muted"></span>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnFirst" onclick="goToPage(1)">«</button>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnPrev"  onclick="goToPage(currentPage-1)">‹</button>
    <span id="pageNumbers" class="d-flex gap-1"></span>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnNext"  onclick="goToPage(currentPage+1)">›</button>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnLast"  onclick="goToPage(totalPages)">»</button>
    <select id="rppSelect" class="form-select form-select-sm"
            style="width:75px" onchange="changeRPP()">
        <option value="10" selected>10</option>
        <option value="20">20</option>
        <option value="50">50</option>
    </select>
    <span class="text-muted">/ page</span>
</div>

<!-- ══════════════════════════════════════════════
     ADD / EDIT MODAL
══════════════════════════════════════════════ -->
<div class="modal fade" id="prodModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-dark text-white py-2">
                <h6 class="modal-title mb-0">
                    <i class="bi bi-gear-wide-connected me-2"></i>
                    <span id="modalTitleText">Add Production Entry</span>
                </h6>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="prodForm" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="fSrNo"         value="0" />
                   

                    <div class="row g-3">
                        <div class="col-md-4">
    <label class="form-label fw-semibold small">
        Department <span class="text-danger">*</span>
    </label>

    <div class="input-group input-group-sm">
        <span class="input-group-text">
            <i class="bi bi-building"></i>
        </span>

        <select id="fDepartmentId"
                class="form-select form-select-sm"
                onchange="onDepartmentChange()">

            <option value="0">
                -- Select Department --
            </option>

        </select>
    </div>

    <div class="invalid-feedback d-block"
         id="err-dept"></div>
</div>
                        <!-- Shift -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Shift <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-clock"></i>
                                </span>
                                <select id="fShiftId"
                                        class="form-select form-select-sm">
                                    <option value="0">-- Select Shift --</option>
                                </select>
                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-shift"></div>
                        </div>

                        <!-- Machine — cascade from dept -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Machine <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-cpu"></i>
                                </span>
                                <select id="fMachineId"
                                        class="form-select form-select-sm"
                                        onchange="onMachineChange()">
                                    <option value="0">
                                        -- Select Machine --
                                    </option>
                                </select>
                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-machine"></div>
                        </div>

                        <!-- Date -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Date <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-calendar3"></i>
                                </span>
                                <input type="date" id="fDate"
                                       class="form-control form-control-sm" />
                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-date"></div>
                        </div>

                        <!-- Item Code — cascade from dept -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Item Code <span class="text-danger">*</span>
                            </label>
                            @* <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-upc-scan"></i>
                                </span>
                                <select id="fItemId"
                                        class="form-select form-select-sm"
                                        onchange="onItemChange()">
                                    <option value="0">
                                        -- Select Item --
                                    </option>
                                </select>
                            </div> *@

                                <div class="input-group input-group-sm">

                                    <div class="select2-wrapper">
                                        <select id="fItemId"
                                                class="form-select form-select-sm"
                                                onchange="onItemChange()">
                                            <option value="0">-- Select Item --</option>
                                        </select>
                                    </div>

                                </div>
                            <div class="invalid-feedback d-block"
                                 id="err-item"></div>
                        </div>

                        <!-- Item Description — readonly -->
                        @* <div class="col-md-4">
                                <label class="form-label fw-semibold small">
                                    <i class="bi bi-card-text me-1"></i>
                                    Description
                                </label>
                            <input type="text" id="fItemDesc"
                                   class="form-control form-control-sm bg-light"
                                   readonly
                                   placeholder="Auto-filled on item select" />
                        </div> *@
                            <div class="col-md-4">
                                <label class="form-label fw-semibold small">
                                    Description
                                </label>

                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">
                                        <i class="bi bi-card-text"></i>
                                    </span>

                                    <input type="text"
                                           id="fItemDesc"
                                           class="form-control form-control-sm bg-light"
                                           readonly
                                           placeholder="Auto-filled on item select" />
                                </div>
                            </div>
                        <!-- Quantity -->
                        @* <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Quantity <span class="text-danger">*</span>
                            </label>
                            <input type="number" id="fQuantity"
                                   class="form-control form-control-sm"
                                   min="1" step="1" placeholder="0"
                                   oninput="checkQtyAgainstPlan()" />
                            <div class="invalid-feedback d-block"
                                 id="err-qty"></div>
                        </div> *@

                    <div class="col-md-4">
    <label class="form-label fw-semibold small">
        Quantity <span class="text-danger">*</span>
    </label>

    <div class="input-group input-group-sm">
        <span class="input-group-text">
            <i class="bi bi-box-seam"></i>
        </span>

        <input type="number"
               id="fQuantity"
               class="form-control form-control-sm"
               min="1"
               step="1"
               placeholder="0"
               oninput="checkQtyAgainstPlan()" />
    </div>

    <div class="invalid-feedback d-block"
         id="err-qty"></div>
</div>

                    <!-- ── VALIDATION PANELS ── -->
                     

                        @* <!-- Plan Qty -->
                        <div class="col-md-4">
                            <div class="val-panel panel-plan">
                                <div class="small text-muted">
                                    Plan Qty (this month)
                                </div>
                                <div class="val text-primary"
                                     id="vPlanQty">—</div>
                            </div>
                        </div>

                        <!-- Produced so far -->
                        <div class="col-md-4">
                            <div class="val-panel panel-prod"
                                 id="pnlProduced">
                                <div class="small text-muted">
                                    Produced so far
                                </div>
                                <div class="val text-primary"
                                     id="vProduceQty">—</div>
                            </div>
                        </div> *@
                            <!-- Plan Qty -->
                            @* <div class="col-md-4">
                                <label class="form-label fw-semibold small">
                                    Plan Qty (This Month)
                                </label>
                                <input type="text"
                                       id="vPlanQty"
                                       class="form-control form-control-sm bg-light"
                                       readonly placeholder="Auto-filled on item select" />
                            </div> *@
                            <div class="col-md-4">
                                <label class="form-label fw-semibold small">
                                    Plan Qty (This Month)
                                </label>

                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">
                                        <i class="bi bi-calendar-check"></i>
                                    </span>

                                    <input type="text"
                                           id="vPlanQty"
                                           class="form-control form-control-sm bg-light"
                                           readonly
                                           placeholder="Auto-filled on item select" />
                                </div>
                            </div>
                            <!-- Produced Qty -->
                            @* <div class="col-md-4">
                                <label class="form-label fw-semibold small">
                                    Produced So Far
                                </label>
                                <input type="text"
                                       id="vProduceQty"
                                       class="form-control form-control-sm bg-light"
                                       readonly placeholder="Auto-filled on item select" />
                            </div> *@

                            <div class="col-md-4">
                                <label class="form-label fw-semibold small">
                                    Produced So Far
                                </label>

                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">
                                        <i class="bi bi-gear-fill"></i>
                                    </span>

                                    <input type="text"
                                           id="vProduceQty"
                                           class="form-control form-control-sm bg-light"
                                           readonly
                                           placeholder="Auto-filled on item select" />
                                </div>
                            </div>
                        @* <!-- Remaining -->
                        <div class="col-md-4">
                            <div class="val-panel" id="pnlRemaining">
                                <div class="small text-muted">Remaining</div>
                                <div class="val" id="vRemaining">—</div>
                            </div>
                        </div> *@

                        <!-- Alert -->
                        <div class="col-md-12">
                            <div id="alertMsg"
                                 class="alert py-1 px-2 mb-0 small"
                                 style="display:none!important"></div>
                        </div>

                    </div>

                   

                </form>
            </div>

            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary btn-sm"
                        id="btnSave">
                    <i class="bi bi-floppy me-1"></i>Save
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ── DELETE CONFIRM MODAL ── -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white py-2">
                <h6 class="modal-title mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Confirm Delete
                </h6>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center small">
                <p class="mb-1">Delete production record</p>
                <strong id="deleteLabel"></strong>?
            </div>
            <div class="modal-footer justify-content-center py-2">
                <button class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-danger btn-sm"
                        id="btnConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- ── TOAST ── -->
<div class="position-fixed top-0 end-0 p-3" style="z-index:9999">
    <div id="toast" class="toast align-items-center text-white border-0"
         role="alert" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body small" id="toastMsg"></div>
            <button type="button"
                    class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
$(function () {

    // ════════════════════════════════════════════
    // STATE
    // ════════════════════════════════════════════
    let allData         = [];
    let filteredData    = [];
    let currentPage     = 1;
    let rowsPerPage     = 10;
    let totalPages      = 1;
    let pendingDeleteId = null;
    let currentDeptId   = 0;
    let isEditMode      = false;

    // cached validation values
    let cachedPlanQty    = 0;
    let cachedProduceQty = 0;

    const prodModal   = new bootstrap.Modal($('#prodModal')[0]);
    const deleteModal = new bootstrap.Modal($('#deleteModal')[0]);
    const toastEl     = $('#toast')[0];
    const bsToast     = new bootstrap.Toast(toastEl, { delay: 3500 });

    // ════════════════════════════════════════════
    // LOAD DEPARTMENTS + SHIFTS on init
    // ════════════════════════════════════════════
    $.ajax({
        url: '/MachineProduction/GetDepartments',
        method: 'GET', dataType: 'json',
       success: function (depts) {

    let opts =
        '<option value="0">-- Select Department --</option>';

    depts.forEach(d => {

        opts += `
            <option value="${d.DepartmentId}">
                ${d.Department}
            </option>`;
    });

    // Header dropdown
    $('#headerDeptFilter').html(opts);

    // Modal dropdown
    $('#fDepartmentId').html(opts);
}
    });

    $.ajax({
        url: '/MachineProduction/GetShifts',
        method: 'GET', dataType: 'json',
        success: function (shifts) {
            let opts = '<option value="0">-- Select Shift --</option>';
            shifts.forEach(s => {
                opts += `<option value="${s.shiftId}">
                            ${s.shiftName}</option>`;
            });
            $('#fShiftId').html(opts);
        }
    });

    // ════════════════════════════════════════════
    // LOAD BUTTON
    // ════════════════════════════════════════════
    $('#headerDeptFilter').on('change', function () {

    currentDeptId =
        parseInt($(this).val()) || 0;

    if (!currentDeptId) {

        $('#tableBody').html(`
            <tr id="loadingRow">
                <td colspan="9"
                    class="text-center text-muted py-3">

                    Select Department
                </td>
            </tr>
        `);

        return;
    }

    loadData();
});
    // ════════════════════════════════════════════
    // LOAD MODAL DROPDOWNS
    // ════════════════════════════════════════════
            function loadModalDropdowns(deptId, selectedMachineId = 0, selectedItemId = 0) {

            $.ajax({
            url: '/MachineProduction/GetMachinesByDept?deptId=' + deptId,
            success: function (machines) {

            let opts = '<option value="0">-- Select Machine --</option>';

            machines.forEach(m => {
            opts += `<option value="${m.machineId}">
            ${m.machineName}
            </option>`;
            });

            $('#fMachineId').html(opts);

            if (selectedMachineId) {
            $('#fMachineId').val(selectedMachineId);
            }
            }
            });

            $.ajax({
            url: '/MachineProduction/GetItemsByDept?deptId=' + deptId,
            success: function (items) {

            let opts = '<option value="0">-- Select Item --</option>';

            items.forEach(i => {
            opts += `<option value="${i.itemId}">
            ${i.item_Code}
            </option>`;
            });

            $('#fItemId').html(opts);

            applyItemSelect2();

            if (selectedItemId) {
            $('#fItemId')
            .val(selectedItemId)
            .trigger('change');
            }
            }
            });
            }

    // ════════════════════════════════════════════
    // MACHINE CHANGE (for PPBox dept=4)
    // ════════════════════════════════════════════
    window.onMachineChange = function () {
        const itemId = parseInt($('#fItemId').val()) || 0;
        if (itemId !== 0) onItemChange();
    };

    // ════════════════════════════════════════════
    // ITEM CHANGE → description + plan/produce panels
    // ════════════════════════════════════════════
    window.onItemChange = function () {
        const itemId  = parseInt($('#fItemId').val())   || 0;
        const deptId  = parseInt($('#fDepartmentId').val()) || 0;
        const machId  = parseInt($('#fMachineId').val()) || 0;

        if (!itemId) {
            $('#fItemDesc').val('');
            resetPanels();
            return;
        }

        // Item description
        $.ajax({
            url: `/MachineProduction/GetItemDescription?itemId=${itemId}&deptId=${deptId}`,
            method: 'GET', dataType: 'json',
            success: function (d) {
                $('#fItemDesc').val(d?.item_Description || '');
            }
        });

        // ── Plan Qty ──
        $.ajax({
            url: `/MachineProduction/GetPlanQty?deptId=${deptId}&itemId=${itemId}`,
            method: 'GET', dataType: 'json',
            success: function (d) {
                cachedPlanQty = d.addedPlan_Qty || 0;
            $('#vPlanQty').val(cachedPlanQty);
                loadProduceQty(deptId, itemId, machId);
            }
        });
    };

    function loadProduceQty(deptId, itemId, machId) {
        const isPPBox = deptId === 4;
        const url     = isPPBox
            ? `/MachineProduction/GetProduceQtyPPBox?deptId=${deptId}&itemId=${itemId}&machineId=${machId}`
            : `/MachineProduction/GetProduceQty?deptId=${deptId}&itemId=${itemId}`;

        $.ajax({
            url: url, method: 'GET', dataType: 'json',
            success: function (d) {
                cachedProduceQty = d.produce_Qty || 0;
                $('#vProduceQty').val(cachedProduceQty);
                // updateRemainingPanel();
            }
        });
    }

    // function updateRemainingPanel() {
    //     const remaining = cachedPlanQty - cachedProduceQty;
    //     $('#vRemaining').text(remaining);
    //     const pnl = $('#pnlRemaining');
    //     pnl.removeClass('panel-plan panel-prod panel-warn panel-err');
    //     if (remaining > 0)
    //         pnl.addClass('panel-prod')
    //            .find('.val').css('color', '#198754');
    //     else
    //         pnl.addClass('panel-err')
    //            .find('.val').css('color', '#dc3545');
    // }

    // ── Live check quantity against plan ──
    window.checkQtyAgainstPlan = function () {
        hideAlert();
        const qty        = parseInt($('#fQuantity').val()) || 0;
        const newTotal   = cachedProduceQty + qty;

        if (qty > 0 && newTotal > cachedPlanQty && cachedPlanQty > 0) {
            showAlert(
                `Production Qty (${newTotal}) will exceed ` +
                `Plan Qty (${cachedPlanQty}).`, 'warning');
        }
    };

    // ════════════════════════════════════════════
    // LOAD DATA
    // ════════════════════════════════════════════
    function loadData() {
        $('#loadingRow').show()
            .find('td').html(
                '<div class="spinner-border spinner-border-sm ' +
                'text-primary me-2"></div>Loading...');
        $('#tableBody tr:not(#loadingRow)').remove();
        $('#prodFoot').hide();

        $.ajax({
            url: '/MachineProduction/GetAll?deptId=' + currentDeptId,
            method: 'GET', dataType: 'json',
            success: function (data) {
                allData = data;
                applyFilter();
                $('#loadingRow').hide();
            },
            error: function () {
                $('#loadingRow td').html(
                    '<i class="bi bi-exclamation-triangle ' +
                    'text-danger me-1"></i>Failed to load data.');
            }
        });
    }

    // ════════════════════════════════════════════
    // RENDER TABLE
    // ════════════════════════════════════════════
    function renderTable() {
        totalPages = Math.max(1,
            Math.ceil(filteredData.length / rowsPerPage));
        if (currentPage > totalPages) currentPage = totalPages;

        const start = (currentPage - 1) * rowsPerPage;
        const end   = Math.min(start + rowsPerPage, filteredData.length);
        const slice = filteredData.slice(start, end);

        $('#tableBody tr:not(#loadingRow)').remove();

        if (slice.length === 0) {
            $('#prodFoot').hide();
            $('#tableBody').append(
                `<tr><td colspan="9"
                    class="text-center text-muted py-3">
                    No records found.
                 </td></tr>`);
        } else {
            slice.forEach((r, i) =>
                $('#tableBody').append(buildRow(r, start+i+1)));
            $('#prodFoot').show();
        }

        updatePagination(start, end);
    }

    function buildRow(r, sr) {
        const fmt = v => v || '—';
        return `
        <tr id="row-${r.SrNo}">
            <td class="text-center">${sr}</td>
            <td>
                <span class="badge bg-dark" style="font-size:0.60rem">
                    ${fmt(r.DepartmentName)}
                </span>
            </td>
            <td class="text-center">${fmt(r.Add_Date)}</td>
            <td>${fmt(r.ShiftName)}</td>
            <td>${fmt(r.MachineName)}</td>
            <td class="fw-bold text-primary">${fmt(r.Item_Code)}</td>
            <td title="${fmt(r.Item_Description)}">
                ${fmt(r.Item_Description)}
            </td>
            <td>${r.Quantity ?? '—'}</td>
            <td class="text-center">
                <button class="btn btn-outline-primary btn-sm btn-edit"
                        data-id="${r.SrNo}" title="Edit">
                    <i class="bi bi-pencil-square"></i>
                </button>
                <button class="btn btn-outline-danger btn-sm btn-del"
                        data-id="${r.SrNo}"
                        data-label="${fmt(r.item_Code)} / ${fmt(r.add_Date)}"
                        title="Delete">
                    <i class="bi bi-trash3"></i>
                </button>
            </td>
        </tr>`;
    }

    

    // ════════════════════════════════════════════
    // FILTER
    // ════════════════════════════════════════════
    window.applyFilter = function () {
        const q = $('#searchInput').val().toLowerCase().trim();
        filteredData = allData.filter(r =>
            !q ||
            (r.item_Code        || '').toLowerCase().includes(q) ||
            (r.item_Description || '').toLowerCase().includes(q) ||
            (r.machineName      || '').toLowerCase().includes(q) ||
            (r.shiftName        || '').toLowerCase().includes(q)
        );
        currentPage = 1;
        renderTable();
    };

    // ════════════════════════════════════════════
    // PAGINATION
    // ════════════════════════════════════════════
    function updatePagination(start, end) {
        $('#pageInfo').text(
            filteredData.length === 0
                ? 'No records'
                : `${start+1}–${end} of ${filteredData.length}`);

        $('#btnFirst,#btnPrev').prop('disabled', currentPage === 1);
        $('#btnNext,#btnLast').prop('disabled',  currentPage === totalPages);

        const container = $('#pageNumbers').empty();
        const maxV = 5;
        let sp = Math.max(1, currentPage - Math.floor(maxV/2));
        let ep = Math.min(totalPages, sp + maxV - 1);
        if (ep - sp < maxV - 1) sp = Math.max(1, ep - maxV + 1);

        for (let p = sp; p <= ep; p++) {
            $('<button>').text(p)
                .addClass('btn btn-outline-secondary btn-sm'
                    + (p === currentPage ? ' active-pg' : ''))
                .on('click', () => goToPage(p))
                .appendTo(container);
        }
    }

    window.goToPage = function (p) {
        if (p < 1 || p > totalPages) return;
        currentPage = p; renderTable();
    };
    window.changeRPP = function () {
        rowsPerPage = parseInt($('#rppSelect').val());
        currentPage = 1; renderTable();
    };

    // ════════════════════════════════════════════
    // ADD MODAL
    // ════════════════════════════════════════════
            $('#btnAdd').on('click', function () {

            clearForm(false);

            $('#modalTitleText').text('Add Production Entry');

            $('#fDate').val(new Date().toISOString().split('T')[0]);

            prodModal.show();

            setTimeout(function () {
            applyItemSelect2();
            }, 300);
            });

            // ════════════════════════════════════════════
            // EDIT
            // ════════════════════════════════════════════
            $(document).on('click', '.btn-edit', function () {

            const id = parseInt($(this).data('id'));

            const r = allData.find(x => x.SrNo == id);

            if (!r) {
            showToast('Record not found.', 'danger');
            return;
            }

            clearForm(true);

            $('#modalTitleText').text('Edit Production Entry');

            // Hidden ID
            $('#fSrNo').val(r.SrNo);

            // Department
            $('#fDepartmentId')
            .val(r.DepartmentId)
            .prop('disabled', true);

            // Load machine + item dropdowns first
            loadModalDropdowns(r.DepartmentId);

            // Shift
            $('#fShiftId').val(r.ShiftId);

            // Delay because dropdown loads via ajax
            // setTimeout(function () {

            // $('#fMachineId')
            // .val(r.MachineId)
            // .prop('disabled', true);

            // $('#fItemId')
            // .val(r.ItemId)
            // .prop('disabled', true);

            // }, 300);
            setTimeout(function () {

            $('#fMachineId')
            .val(r.MachineId)
            .prop('disabled', true);

            $('#fItemId')
            .val(r.ItemId)
            .trigger('change'); // important for Select2

            $('#fItemId').prop('disabled', true);

            onItemChange();

            }, 500);
            // Description
            $('#fItemDesc').val(r.Item_Description || '');

            // Quantity
            $('#fQuantity').val(r.Quantity);
            // Date
            if (r.Add_Date) {

            let dt = r.Add_Date;

            // if date format is dd-MM-yyyy
            if (dt.includes('-')) {

            let parts = dt.split('-');

            if (parts[0].length == 2) {
            dt = `${parts[2]}-${parts[1]}-${parts[0]}`;
            }
            }

            $('#fDate').val(dt);
            }

           

            prodModal.show();
            });

    // ════════════════════════════════════════════
    // SAVE — with plan vs produce validation
    // ════════════════════════════════════════════
    $('#btnSave').on('click', function () {
        clearErrors();
        hideAlert();

        const shiftId  = parseInt($('#fShiftId').val())   || 0;
        const machId   = parseInt($('#fMachineId').val())  || 0;
        const itemId   = parseInt($('#fItemId').val())     || 0;
        const qty      = parseInt($('#fQuantity').val())   || 0;
        const date     = $('#fDate').val();

        let valid = true;
        if (!shiftId) {
            showError('fShiftId','err-shift','Shift required.'); valid=false; }
        if (!machId) {
            showError('fMachineId','err-machine','Machine required.'); valid=false; }
        if (!itemId) {
            showError('fItemId','err-item','Item required.'); valid=false; }
        if (qty <= 0) {
            showError('fQuantity','err-qty','Quantity must be > 0.'); valid=false; }
        if (!date) {
            showError('fDate','err-date','Date required.'); valid=false; }
        if (!valid) return;

        // ── Business Rule (matches original JS) ──
        if (!isEditMode) {
            const newTotal = cachedProduceQty + qty;
            if (cachedPlanQty > 0 && newTotal > cachedPlanQty) {
                showAlert(
                    `Production Qty (${newTotal}) exceeds Plan Qty ` +
                    `(${cachedPlanQty}). Cannot save.`, 'danger');
                return;
            }
        }

        const token =
            $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url:      '/MachineProduction/Save',
            method:   'POST',
            dataType: 'json',
            data: {
                SrNo:         $('#fSrNo').val(),
                ShiftId:      shiftId,
                MachineId:    machId,
                ItemId:       itemId,
                Quantity:     qty,
                Date:         date,
                DepartmentId: $('#fDepartmentId').val(),
                __RequestVerificationToken: token
            },
            success: function (d) {
                if (!d.success) {
                    showToast(d.message || 'Save failed.', 'danger');
                    return;
                }
                prodModal.hide();
                showToast(d.message, 'success');
                loadData();
            },
            error: function () {
                showToast('Network error.', 'danger');
            }
        });
    });

    // ════════════════════════════════════════════
    // DELETE
    // ════════════════════════════════════════════
    $(document).on('click', '.btn-del', function () {
        pendingDeleteId = parseInt($(this).data('id'));
        $('#deleteLabel').text($(this).data('label'));
        deleteModal.show();
    });

    $('#btnConfirmDelete').on('click', function () {
        const token =
            $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url:      '/MachineProduction/Delete',
            method:   'POST',
            dataType: 'json',
            data: { srNo: pendingDeleteId,
                    __RequestVerificationToken: token },
            success: function (d) {
                deleteModal.hide();
                if (d.success) {
                    allData      = allData.filter(
                        r => r.SrNo !== pendingDeleteId);
                    filteredData = filteredData.filter(
                        r => r.SrNo !== pendingDeleteId);
                    renderTable();
                    showToast('Production record deleted.', 'success');
                } else {
                    showToast('Delete failed.', 'danger');
                }
            },
            error: function () {
                showToast('Network error.', 'danger');
            }
        });
    });

    // ════════════════════════════════════════════
    // HELPERS
    // ════════════════════════════════════════════
    function clearForm(editMode) {
        isEditMode       = editMode;
        cachedPlanQty    = 0;
        cachedProduceQty = 0;
            $('#fDepartmentId')
            .val('0')
            .prop('disabled', false);
        $('#fSrNo').val('0');
        $('#fShiftId').val('0');
        $('#fMachineId').val('0').prop('disabled', false);
        $('#fItemId').val('0').prop('disabled', false);
        $('#fItemDesc').val('');
        $('#fQuantity').val('').prop('disabled', false);
        $('#fDate').val('').prop('disabled', false);
       
      
        resetPanels();
        clearErrors();
        hideAlert();
    }

            function resetPanels() {
            $('#vPlanQty').val('');
            $('#vProduceQty').val('');
            }

    function clearErrors() {
        $('.invalid-feedback.d-block').text('');
        $('#prodForm .form-control, #prodForm .form-select')
            .removeClass('is-invalid');
    }

    function showError(fieldId, errId, msg) {
        $('#' + fieldId).addClass('is-invalid');
        $('#' + errId).text(msg);
    }

    function showAlert(msg, type) {
        $('#alertMsg')
            .attr('class',
                `alert py-1 px-2 mb-0 small alert-${type}`)
            .html(`<i class="bi bi-exclamation-triangle me-1"></i>${msg}`)
            .show();
    }

    function hideAlert() {
        $('#alertMsg').hide().text('');
    }

    function showToast(msg, type) {
        toastEl.className =
            `toast align-items-center text-white border-0 bg-${type}`;
        $('#toastMsg').text(msg);
        bsToast.show();
    }
    window.onDepartmentChange = function () {

    const deptId =
        parseInt($('#fDepartmentId').val()) || 0;

    if (!deptId) return;

    loadModalDropdowns(deptId);
};

            function applyItemSelect2() {

            if ($('#fItemId').hasClass('select2-hidden-accessible')) {
            $('#fItemId').select2('destroy');
            }

            $('#fItemId').select2({
            placeholder: 'Search Item Code',
            width: '100%',
            dropdownParent: $('#prodModal')
            });
            }
});
</script>
}