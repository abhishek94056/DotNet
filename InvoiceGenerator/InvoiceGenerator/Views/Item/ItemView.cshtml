@model List<InvoiceGenerator.Models.ItemModel>
@{
    ViewData["Title"] = "Item Master";
}
@section Styles {
    <link rel="stylesheet" href="~/css/Item.css" />
}

<!-- ── PAGE HEADER ── -->
<div class="d-flex align-items-center justify-content-between mb-2">
    <h6 class="mb-0 fw-bold">
        <i class="bi bi-box-seam me-2 text-primary"></i>Item Master
    </h6>
    <div class="d-flex align-items-center gap-2">
        <input type="text" id="searchInput"
               class="form-control form-control-sm"
               placeholder="🔍 Search..."
               style="width:180px"
               oninput="filterTable()" />
        <button class="btn btn-primary btn-sm" onclick="openModal()">
            <i class="bi bi-plus-lg me-1"></i>Add Item
        </button>
    </div>
</div>

<!-- ── GRID ── -->
<div class="table-responsive">
    <table class="table table-bordered table-sm align-middle mb-0"
           id="itemTable">
        <thead class="table-dark text-center">
            <tr>
                @* <th style="width:40px">#</th>
                <th style="width:90px">Item Code</th>
                <th>Item Description</th>
                <th style="width:100px">HSN Code</th>
                <th style="width:90px">Rate (₹)</th>
                <th style="width:70px">GST (%)</th>
                <th style="width:70px">Actions</th> *@
                 <th>#</th>
                <th>Item Code</th>
                <th>Item Description</th>
                <th>HSN Code</th>
                <th>Rate (₹)</th>
                <th>GST (%)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="itemTableBody">
            @{ int sr = 1; }
            @foreach (var item in Model)
            {
                <tr id="row-@item.ItemId">
                    <td class="text-center">@sr</td>
                    <td>@item.ItemCode</td>
                    <td>@item.ItemDescription</td>
                    <td class="text-center">@item.HSNCode</td>
                    <td class="text-end pe-2">@item.Rate.ToString("0.00")</td>
                    <td class="text-center">@item.GST %</td>
                    <td class="text-center">
                        <button class="btn btn-outline-primary btn-sm"
                                onclick="editItem(@item.ItemId)"
                                title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="btn btn-outline-danger btn-sm"
                                onclick="deleteItem(@item.ItemId, '@item.ItemDescription')"
                                title="Delete">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </td>
                </tr>
                sr++;
            }
        </tbody>
    </table>
</div>

<!-- ── PAGINATION BAR ── -->
<div class="pagination-bar">
    <span class="page-info" id="pageInfo"></span>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnFirst" onclick="goToPage(1)" title="First">«</button>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnPrev" onclick="goToPage(currentPage - 1)" title="Previous">‹</button>
    <span id="pageNumbers" class="d-flex gap-1"></span>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnNext" onclick="goToPage(currentPage + 1)" title="Next">›</button>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnLast" onclick="goToPage(totalPages)" title="Last">»</button>
    <select id="rowsPerPageSelect"
            class="form-select form-select-sm"
            style="width:80px"
            onchange="changeRowsPerPage()">
        <option value="15" selected>15</option>
        <option value="20">20</option>
        <option value="50">50</option>
    </select>
    <span class="page-info">/ page</span>
</div>

<!-- ══════════════════════════════════════════════
     ADD / EDIT MODAL
══════════════════════════════════════════════ -->
<div class="modal fade" id="itemModal" tabindex="-1"
     aria-labelledby="itemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-dark text-white py-2">
                <h6 class="modal-title mb-0" id="itemModalLabel">
                    <i class="bi bi-box-seam me-2"></i>
                    <span id="modalTitleText">Add Item</span>
                </h6>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="itemForm" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="itemId" value="0" />

                    <div class="row g-2">

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">
                                Item Code <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="itemCode"
                                   class="form-control form-control-sm"
                                   maxlength="20"
                                   placeholder="e.g. ITEM001" />
                            <div class="invalid-feedback" id="err-itemCode"></div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">
                                HSN Code <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="hsnCode"
                                   class="form-control form-control-sm"
                                   maxlength="50"
                                   placeholder="e.g. 8537" />
                            <div class="invalid-feedback" id="err-hsnCode"></div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small">
                                Item Description <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="itemDescription"
                                   class="form-control form-control-sm"
                                   maxlength="100"
                                   placeholder="e.g. Control Panel Assembly" />
                            <div class="invalid-feedback" id="err-itemDescription"></div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">
                                Rate (₹) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">₹</span>
                                <input type="number" id="rate"
                                       class="form-control form-control-sm"
                                       min="0.01" step="0.01"
                                       placeholder="0.00" />
                            </div>
                            <div class="invalid-feedback d-block" id="err-rate"></div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">
                                GST (%) <span class="text-danger">*</span>
                            </label>
                            <select id="gst" class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                <option value="0">0%</option>
                                <option value="5">5%</option>
                                <option value="9">9%</option>
                                <option value="12">12%</option>
                                <option value="18">18%</option>
                                <option value="28">28%</option>
                            </select>
                            <div class="invalid-feedback d-block" id="err-gst"></div>
                        </div>

                    </div>
                </form>
            </div>

            <div class="modal-footer py-2">
                <button class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cancel
                </button>
                <button class="btn btn-primary btn-sm" onclick="saveItem()">
                    <i class="bi bi-floppy me-1"></i>Save
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════
     DELETE CONFIRM MODAL
══════════════════════════════════════════════ -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white py-2">
                <h6 class="modal-title mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>Confirm Delete
                </h6>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center small">
                <p class="mb-1">Are you sure you want to delete</p>
                <strong id="deleteItemDescription"></strong>?
            </div>
            <div class="modal-footer justify-content-center py-2">
                <button class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cancel
                </button>
                <button class="btn btn-danger btn-sm" id="btnConfirmDelete">
                    <i class="bi bi-trash3 me-1"></i>Delete
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ── TOAST ── -->
<div class="position-fixed top-0 end-0 p-3" style="z-index:9999">
    <div id="toast" class="toast align-items-center text-white border-0"
         role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body small" id="toastMsg"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Item.js?v=2"></script>
}