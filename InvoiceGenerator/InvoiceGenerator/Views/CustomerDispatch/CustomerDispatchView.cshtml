@{
    ViewData["Title"] = "Customer Dispatch";
}
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<style>
    :root {
        --header-bg: #1a2e4e;
        --row-odd: #f8f9fa;
        --row-even: #e8f0ff;
        --row-hover: #c8d8ff;
    }

    /* HEADER */
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 10px;
    }

        .page-header h6 {
            margin: 0;
            font-weight: 700;
        }

    .header-controls {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
    }

    /* TABLE */
    #dispTable {
        width: 100%;
        min-width: 1200px;
        font-size: 0.70rem;
    }

        #dispTable thead th {
            font-size: 0.67rem;
            padding: 4px 5px;
            white-space: nowrap;
            text-align: center;
            background: var(--header-bg);
            color: #fff;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        #dispTable tbody td {
            padding: 3px 5px;
            vertical-align: middle;
            white-space: nowrap;
        }

        #dispTable tbody tr:nth-child(odd) td {
            background: var(--row-odd);
        }

        #dispTable tbody tr:nth-child(even) td {
            background: var(--row-even);
        }

        #dispTable tbody tr:hover td {
            background: var(--row-hover) !important;
            cursor: pointer;
        }

        #dispTable .btn-sm {
            padding: 1px 4px;
            font-size: 0.65rem;
        }

    /* TABLE WRAPPER */
    .table-wrap {
        max-height: 450px;
        overflow-y: auto;
        overflow-x: auto;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        -webkit-overflow-scrolling: touch;
    }

    /* PAGINATION */
    .pagination-bar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 8px;
        font-size: 0.72rem;
    }

        .pagination-bar button {
            min-width: 28px;
            height: 26px;
            font-size: 0.68rem;
            font-size: 0.68rem;
        }

            .pagination-bar button.active-pg {
                background: #0d6efd;
                color: #fff;
                border-color: #0d6efd;
            }

    /* SUMMARY */
    .disp-summary {
        background: linear-gradient(135deg,#1a2e4e,#2d5080);
        color: #fff;
        border-radius: 8px;
        padding: 8px 14px;
        font-size: 0.72rem;
        height: 100%;
    }

        .disp-summary .val {
            font-size: 1rem;
            font-weight: 700;
            color: #7ec8ff;
        }

    /* GRN */
    .grn-yes {
        background: #198754;
        color: #fff;
    }

    .grn-no {
        background: #6c757d;
        color: #fff;
    }

    .grn-pending {
        background: #ffc107;
        color: #000;
    }

    /* VALIDATION */
    .val-panel {
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 0.70rem;
        text-align: center;
    }

        .val-panel .val {
            font-size: 1rem;
            font-weight: 700;
        }

    .panel-prod {
        background: #e8f8e8;
        border: 1px solid #198754;
    }

    .panel-disp {
        background: #fff8e1;
        border: 1px solid #ff9800;
    }

    .panel-avail-ok {
        background: #e8f8e8;
        border: 1px solid #198754;
    }

    .panel-avail-err {
        background: #f8d7da;
        border: 1px solid #dc3545;
    }

    /* MODAL */
    .modal .form-label {
        margin-bottom: 3px;
    }

    .modal .input-group-text {
        height: 31px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal .form-control-sm,
    .modal .form-select-sm {
        font-size: 0.75rem;
    }

    /* LOADING */
    #loadingRow td {
        text-align: center;
        padding: 20px;
        color: #888;
    }
    .select2-wrapper {
    flex: 1 1 auto;
    width: 100%;
}

.select2-container {
    width: 100% !important;
}

.select2-container--default .select2-selection--single {
    height: 31px !important;
    border: 1px solid #ced4da !important;
    border-radius: 0 .25rem .25rem 0 !important;
    display: flex !important;
    align-items: center !important;
}

.select2-selection__rendered {
    line-height: normal !important;
    display: flex !important;
    align-items: center !important;
    height: 100%;
    padding-left: 6px !important;
}

.select2-selection__arrow {
    height: 100% !important;
    top: 0 !important;
}
    /* MOBILE */
    @@media (max-width:575px) {

        .page-header {
            flex-direction: column;
            align-items: stretch;
        }

        .header-controls {
            flex-direction: column;
            align-items: stretch;
        }

            .header-controls select,
            .header-controls input,
            .header-controls button {
                width: 100% !important;
            }

        #dispTable {
            min-width: 1200px;
        }

        .pagination-bar {
            justify-content: center;
        }

            .pagination-bar #pageNumbers {
                flex-wrap: wrap;
            }

        .modal-dialog {
            margin: .5rem;
        }

        .modal .row > div {
            margin-bottom: 2px;
        }

        .val-panel {
            padding: 6px;
        }
    }

    /* TABLET */
    @@media (min-width:576px) and (max-width:991px) {

        #dispTable {
            min-width: 1100px;
        }

        .pagination-bar {
            justify-content: center;
        }
    }
</style>

<!-- ── PAGE HEADER ── -->
<div class="page-header">
    <h6 class="mb-0 fw-bold">
        <i class="bi bi-truck me-2 text-primary"></i>
        Customer Dispatch
    </h6>
   <div class="header-controls">

        <select id="headerDeptFilter"
                class="form-select form-select-sm"
                style="width:155px">
            <option value="0">-- Department --</option>
        </select>

        <select id="monthFilter"
                class="form-select form-select-sm"
                style="width:115px">
            <option value="1">January</option>
            <option value="2">February</option>
            <option value="3">March</option>
            <option value="4">April</option>
            <option value="5">May</option>
            <option value="6">June</option>
            <option value="7">July</option>
            <option value="8">August</option>
            <option value="9">September</option>
            <option value="10">October</option>
            <option value="11">November</option>
            <option value="12">December</option>
        </select>

        <input type="text" id="searchInput"
               class="form-control form-control-sm"
               placeholder="🔍 Search..."
               style="width:150px" oninput="applyFilter()" />

        <button class="btn btn-primary btn-sm" id="btnAdd">
            <i class="bi bi-plus-lg me-1"></i>Add Dispatch
        </button>
    </div>
</div>


<!-- ── TABLE ── -->
<div class="table-wrap">
    <table class="table table-bordered mb-0" id="dispTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Department</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Item Code</th>
                <th>Description</th>
                <th>Quantity</th>
                <th>GRN Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="tableBody">
            <tr id="loadingRow">
                <td colspan="9">
                    <i class="bi bi-info-circle text-primary me-2"></i>
                   Please select Department and Month.
                </td>
            </tr>
        </tbody>
      
    </table>
</div>

<!-- ── PAGINATION ── -->
<div class="pagination-bar">
    <span id="pageInfo" class="text-muted"></span>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnFirst" onclick="goToPage(1)">«</button>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnPrev"  onclick="goToPage(currentPage-1)">‹</button>
    <span id="pageNumbers" class="d-flex gap-1"></span>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnNext"  onclick="goToPage(currentPage+1)">›</button>
    <button class="btn btn-outline-secondary btn-sm"
            id="btnLast"  onclick="goToPage(totalPages)">»</button>
    <select id="rppSelect" class="form-select form-select-sm"
            style="width:75px" onchange="changeRPP()">
        <option value="10" selected>10</option>
        <option value="20">20</option>
        <option value="50">50</option>
    </select>
    <span class="text-muted">/ page</span>
</div>

<!-- ══════════════════════════════════════════════
     ADD / EDIT MODAL
══════════════════════════════════════════════ -->
<div class="modal fade" id="dispModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-dark text-white py-2">
                <h6 class="modal-title mb-0">
                    <i class="bi bi-truck me-2"></i>
                    <span id="modalTitleText">Add Dispatch</span>
                </h6>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="dispForm" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="fSrNo" value="0" />

                    <div class="row g-2">

                        @* Select Department *@
                        <!-- Department -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Department <span class="text-danger">*</span>
                            </label>

                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-diagram-3"></i>
                                </span>

                                <select id="fDepartmentId"
                                        class="form-select form-select-sm"
                                        onchange="onFormDepartmentChange()">
                                    <option value="0">-- Select Department --</option>
                                </select>
                            </div>

                            <div class="invalid-feedback d-block"
                                 id="err-dept"></div>
                        </div>


                        <!-- Customer -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Customer
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-person-lines-fill"></i>
                                </span>
                                <select id="fCustomerId"
                                        class="form-select form-select-sm"
                                        onchange="onCustomerChange()">
                                    <option value="0">
                                        -- Select Customer --
                                    </option>
                                </select>
                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-customer"></div>
                        </div>

                        <!-- Date -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Date
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-calendar3"></i>
                                </span>
                                <input type="date" id="fDate"
                                       class="form-control form-control-sm" />
                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-date"></div>
                        </div>

                        <!-- GRN Status -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                GRN Status
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    <i class="bi bi-patch-check"></i>
                                </span>
                                <select id="fGRNStatus"
                                        class="form-select form-select-sm">
                                    <option value="NO">NO</option>
                                    <option value="YES">YES</option>
                                    <option value="PENDING">PENDING</option>
                                </select>
                            </div>
                        </div>

                        <!-- Item — cascade from customer+dept -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Item Code
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                @* <span class="input-group-text">
                                    <i class="bi bi-upc-scan"></i>
                                </span> *@
                                <div class="select2-wrapper">
                                    <select id="fItemId"
                                            class="form-select form-select-sm"
                                            disabled
                                            onchange="onItemChange()">
                                        <option value="0">-- Select Customer first --</option>
                                    </select>
                                </div>
                            </div>
                            <div class="invalid-feedback d-block"
                                 id="err-item"></div>
                        </div>

                        <!-- Item Description -->
                        @* <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Description
                            </label>
                            <input type="text" id="fItemDesc"
                                   class="form-control form-control-sm bg-light"
                                   readonly
                                   placeholder="Auto-filled" />
                        </div> *@
                        <div class="col-md-4">
    <label class="form-label fw-semibold small">
        Description
    </label>

    <div class="input-group input-group-sm">
        <span class="input-group-text">
            <i class="bi bi-card-text"></i>
        </span>

        <input type="text"
               id="fItemDesc"
               class="form-control form-control-sm bg-light"
               readonly
               placeholder="Auto-filled" />
    </div>
</div>
                        <!-- Quantity -->
                    @*     <div class="col-md-4">
                            <label class="form-label fw-semibold small">
                                Quantity
                                <span class="text-danger">*</span>
                            </label>
                            <input type="number" id="fQuantity"
                                   class="form-control form-control-sm"
                                   min="1" step="1" placeholder="0"
                                   oninput="checkDispatchQty()" />
                            <div class="invalid-feedback d-block"
                                 id="err-qty"></div>
                        </div>

                    </div> *@
                    <div class="col-md-4">
    <label class="form-label fw-semibold small">
        Quantity <span class="text-danger">*</span>
    </label>

    <div class="input-group input-group-sm">
        <span class="input-group-text">
            <i class="bi bi-box-seam"></i>
        </span>

        <input type="number"
               id="fQuantity"
               class="form-control form-control-sm"
               min="1"
               step="1"
               placeholder="0"
               oninput="checkDispatchQty()" />
    </div>

    <div class="invalid-feedback d-block"
         id="err-qty"></div>
</div>
                    <!-- ── VALIDATION PANELS ── -->
                    <div class="row g-2 mt-2" id="valPanels"
                         style="display:none!important">

                        <!-- Produce Qty -->
                        <div class="col-md-3">
                            <div class="val-panel panel-prod">
                                <div class="small text-muted">
                                    Production Qty
                                </div>
                                <div class="val text-success"
                                     id="vProduceQty">—</div>
                            </div>
                        </div>

                        <!-- Already Dispatched -->
                        <div class="col-md-3">
                            <div class="val-panel panel-disp">
                                <div class="small text-muted">
                                    Already Dispatched
                                </div>
                                <div class="val"
                                     style="color:#e65100"
                                     id="vDispatchQty">—</div>
                            </div>
                        </div>

                        <!-- Available -->
                        <div class="col-md-3">
                            <div class="val-panel panel-avail-ok"
                                 id="pnlAvail">
                                <div class="small text-muted">
                                    Available
                                </div>
                                <div class="val text-success"
                                     id="vAvailable">—</div>
                            </div>
                        </div>

                        <!-- Alert -->
                        <div class="col-md-12">
                            <div id="alertMsg"
                                 class="alert py-1 px-2 mb-0 small"
                                 style="display:none!important"></div>
                        </div>

                    </div>


                </form>
            </div>

            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary btn-sm"
                        id="btnSave">
                    <i class="bi bi-floppy me-1"></i>Save
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ── DELETE CONFIRM MODAL ── -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white py-2">
                <h6 class="modal-title mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Confirm Delete
                </h6>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center small">
                <p class="mb-1">Delete dispatch record</p>
                <strong id="deleteLabel"></strong>?
            </div>
            <div class="modal-footer justify-content-center py-2">
                <button class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-danger btn-sm"
                        id="btnConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- ── TOAST ── -->
<div class="position-fixed top-0 end-0 p-3" style="z-index:9999">
    <div id="toast" class="toast align-items-center text-white border-0"
         role="alert" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body small" id="toastMsg"></div>
            <button type="button"
                    class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
$(function () {

    // ════════════════════════════════════════════
    // STATE
    // ════════════════════════════════════════════
    let allData         = [];
    let filteredData    = [];
    let currentPage     = 1;
    let rowsPerPage     = 10;
    let totalPages      = 1;
    let pendingDeleteId = null;
    let currentDeptId   = 0;
    let isEditMode      = false;

    let cachedProduceQty  = 0;
    let cachedDispatchQty = 0;

    const dispModal   = new bootstrap.Modal($('#dispModal')[0]);
    const deleteModal = new bootstrap.Modal($('#deleteModal')[0]);
    const toastEl     = $('#toast')[0];
    const bsToast     = new bootstrap.Toast(toastEl, { delay: 3500 });

    // ── Set current month as default ──
    $('#monthFilter').val(new Date().getMonth() + 1);

    // ════════════════════════════════════════════
    // INIT — departments + customers
    // ════════════════════════════════════════════
    $.ajax({
        url: '/CustomerDispatch/GetDepartments',
        method: 'GET', dataType: 'json',
        success: function (depts) {
            let opts = '<option value="0">-- Department --</option>';
            depts.forEach(d => {
                opts += `<option value="${d.DepartmentId}">
                            ${d.Department}</option>`;
            });
            $('#headerDeptFilter').html(opts);
            let formOpts =
    '<option value="0">-- Select Department --</option>';

depts.forEach(d => {
    formOpts += `<option value="${d.DepartmentId}">
                    ${d.Department}
                 </option>`;
});

$('#fDepartmentId').html(formOpts);
        }
    });

    $.ajax({
        url: '/CustomerDispatch/GetCustomers',
        method: 'GET', dataType: 'json',
        success: function (custs) {
            let opts =
                '<option value="0">-- Select Customer --</option>';
            custs.forEach(c => {
                opts += `<option value="${c.customerId}">
                            ${c.customer}</option>`;
            });
            $('#fCustomerId').html(opts);
        }
    });

    // Add Auto Load on Department/Month Change

    $('#headerDeptFilter, #monthFilter').on('change', function () {

    currentDeptId = parseInt($('#headerDeptFilter').val()) || 0;
    const monthId = parseInt($('#monthFilter').val()) || 0;

    if (!currentDeptId || !monthId) {
        return;
    }

    $('#btnAdd').prop('disabled', false);

    loadData(currentDeptId, monthId);
});

            // Add Department Change Event
window.onFormDepartmentChange = function () {

    $('#fCustomerId').val('0');

    if ($('#fItemId').hasClass("select2-hidden-accessible")) {
        $('#fItemId').select2('destroy');
    }

    $('#fItemId')
        .html('<option value="0">-- Select Customer first --</option>')
        .prop('disabled', true);

    $('#fItemDesc').val('');
};
    // ════════════════════════════════════════════
    // CUSTOMER CHANGE → cascade items
    // ════════════════════════════════════════════
    window.onCustomerChange = function () {
        const custId = parseInt($('#fCustomerId').val()) || 0;
        const deptId = parseInt($('#fDepartmentId').val()) || 0;

        $('#fItemId')
            .html('<option value="0">-- Loading... --</option>')
            .prop('disabled', true);
        $('#fItemDesc').val('');
        resetPanels();

        if (!custId || !deptId) {
            $('#fItemId')
                .html('<option value="0">-- Select Customer first --</option>');
            return;
        }

        $.ajax({
            url: `/CustomerDispatch/GetItemsByDeptCustomer?deptId=${deptId}&customerId=${custId}`,
            method: 'GET', dataType: 'json',
            success: function (items) {
                let opts =
                    '<option value="0">-- Select Item --</option>';
                items.forEach(i => {
                    opts += `<option value="${i.itemId}"
                                     data-desc="${i.item_Description}">
                                ${i.item_Code}</option>`;
                });
                $('#fItemId').html(opts).prop('disabled', false);

setTimeout(() => {
    applyItemSelect2();
}, 100);
            },
            error: function () {
                $('#fItemId')
                    .html('<option value="0">-- Load failed --</option>');
            }
        });
    };

    // ════════════════════════════════════════════
    // ITEM CHANGE → description + produce + dispatch qty
    // ════════════════════════════════════════════
    window.onItemChange = function () {
        const sel    = $('#fItemId')[0];
        const opt    = sel.options[sel.selectedIndex];
        const itemId = parseInt($('#fItemId').val()) || 0;
        const deptId = parseInt($('#fDepartmentId').val()) || 0;

        $('#fItemDesc').val(opt.getAttribute('data-desc') || '');

        if (!itemId) { resetPanels(); return; }

        // Load both qtys in parallel
        $.ajax({
            url: `/CustomerDispatch/GetProduceQty?deptId=${deptId}&itemId=${itemId}`,
            method: 'GET', dataType: 'json',
            success: function (d) {
                cachedProduceQty = d.produce_Qty || 0;
                $('#vProduceQty').text(cachedProduceQty);
                updateAvailablePanel();
                $('#valPanels').show();
            }
        });

        $.ajax({
            url: `/CustomerDispatch/GetDispatchQty?deptId=${deptId}&itemId=${itemId}`,
            method: 'GET', dataType: 'json',
            success: function (d) {
                cachedDispatchQty = d.dispatch_Qty || 0;
                $('#vDispatchQty').text(cachedDispatchQty);
                updateAvailablePanel();
                $('#valPanels').show();
            }
        });
    };

    function updateAvailablePanel() {
        const available = cachedProduceQty - cachedDispatchQty;
        $('#vAvailable').text(available);
        const pnl = $('#pnlAvail');
        pnl.removeClass('panel-avail-ok panel-avail-err');
        pnl.addClass(available > 0 ? 'panel-avail-ok' : 'panel-avail-err');
        pnl.find('.val').css('color', available > 0 ? '#198754' : '#dc3545');
    }

    // ── Live quantity check ──
    window.checkDispatchQty = function () {
        hideAlert();
        const qty      = parseInt($('#fQuantity').val()) || 0;
        const newTotal = cachedDispatchQty + qty;

        if (qty > 0 && newTotal > cachedProduceQty) {
            showAlert(
                `Dispatch Qty (${newTotal}) will exceed ` +
                `Production Qty (${cachedProduceQty}).`, 'warning');
        }
    };

    // ════════════════════════════════════════════
    // LOAD DATA
    // ════════════════════════════════════════════
    function loadData(deptId, monthId) {
        $('#loadingRow').show()
            .find('td').html(
                '<div class="spinner-border spinner-border-sm ' +
                'text-primary me-2"></div>Loading...');
        $('#tableBody tr:not(#loadingRow)').remove();

        $.ajax({
            url: `/CustomerDispatch/GetAll?deptId=${deptId}&monthId=${monthId}`,
            method: 'GET', dataType: 'json',
            success: function (data) {
                allData = data;
                applyFilter();
                $('#loadingRow').hide();
            },
            error: function () {
                $('#loadingRow td').html(
                    '<i class="bi bi-exclamation-triangle ' +
                    'text-danger me-1"></i>Failed to load data.');
            }
        });
    }

    // ════════════════════════════════════════════
    // RENDER TABLE
    // ════════════════════════════════════════════
    function renderTable() {
        totalPages = Math.max(1,
            Math.ceil(filteredData.length / rowsPerPage));
        if (currentPage > totalPages) currentPage = totalPages;

        const start = (currentPage - 1) * rowsPerPage;
        const end   = Math.min(start + rowsPerPage, filteredData.length);
        const slice = filteredData.slice(start, end);

        $('#tableBody tr:not(#loadingRow)').remove();

        if (slice.length === 0) {
            $('#tableBody').append(
                `<tr><td colspan="9"
                    class="text-center text-muted py-3">
                    No records found.
                 </td></tr>`);
        } else {
            slice.forEach((r, i) =>
                $('#tableBody').append(buildRow(r, start+i+1)));
        }

        updatePagination(start, end);
    }

    function buildRow(r, sr) {
        const fmt = v => v || '—';

        // GRN badge
        const grn = (r.GRN_Status || 'NO').toUpperCase();
        const grnClass = grn === 'YES' ? 'grn-yes'
                       : grn === 'PENDING' ? 'grn-pending'
                       : 'grn-no';
        const grnBadge =
            `<span class="badge ${grnClass}"
                   style="font-size:0.60rem">${grn}</span>`;

        return `
        <tr id="row-${r.SrNo}">
            <td class="text-center">${sr}</td>
            <td>
                <span class="badge bg-dark" style="font-size:0.60rem">
                    ${fmt(r.Department)}
                </span>
            </td>
            <td class="fw-bold text-primary">${fmt(r.Customer)}</td>
            <td class="text-center">${fmt(r.Add_Date)}</td>
            <td class="fw-bold" style="color:#0d6efd">
                ${fmt(r.Item_Code)}
            </td>
            <td title="${fmt(r.Item_Description)}">
                ${fmt(r.Item_Description)}
            </td>
            <td class="text-center fw-bold fs-6">${r.Quantity ?? '—'}</td>
            <td class="text-center">${grnBadge}</td>
           
            <td class="text-center">
                <button class="btn btn-outline-primary btn-sm btn-edit"
                        data-id="${r.SrNo}" title="Edit">
                    <i class="bi bi-pencil-square"></i>
                </button>
                <button class="btn btn-outline-danger btn-sm btn-del"
                        data-id="${r.SrNo}"
                        data-label="${fmt(r.Customer)} / ${fmt(r.Item_Code)}"
                        title="Delete">
                    <i class="bi bi-trash3"></i>
                </button>
            </td>
        </tr>`;
    }


    // ════════════════════════════════════════════
    // FILTER
    // ════════════════════════════════════════════
    window.applyFilter = function () {
        const q = $('#searchInput').val().toLowerCase().trim();
        filteredData = allData.filter(r =>
            !q ||
            (r.Customer        || '').toLowerCase().includes(q) ||
            (r.Item_Code       || '').toLowerCase().includes(q) ||
            (r.Item_Description|| '').toLowerCase().includes(q) ||
            (r.GRN_Status      || '').toLowerCase().includes(q)
        );
        currentPage = 1;
        renderTable();
    };

    // ════════════════════════════════════════════
    // PAGINATION
    // ════════════════════════════════════════════
    function updatePagination(start, end) {
        $('#pageInfo').text(
            filteredData.length === 0
                ? 'No records'
                : `${start+1}–${end} of ${filteredData.length}`);

        $('#btnFirst,#btnPrev').prop('disabled', currentPage === 1);
        $('#btnNext,#btnLast').prop('disabled',  currentPage === totalPages);

        const container = $('#pageNumbers').empty();
        const maxV = 5;
        let sp = Math.max(1, currentPage - Math.floor(maxV/2));
        let ep = Math.min(totalPages, sp + maxV - 1);
        if (ep - sp < maxV - 1) sp = Math.max(1, ep - maxV + 1);

        for (let p = sp; p <= ep; p++) {
            $('<button>').text(p)
                .addClass('btn btn-outline-secondary btn-sm'
                    + (p === currentPage ? ' active-pg' : ''))
                .on('click', () => goToPage(p))
                .appendTo(container);
        }
    }

    window.goToPage = function (p) {
        if (p < 1 || p > totalPages) return;
        currentPage = p; renderTable();
    };
    window.changeRPP = function () {
        rowsPerPage = parseInt($('#rppSelect').val());
        currentPage = 1; renderTable();
    };

    // ════════════════════════════════════════════
    // ADD MODAL
    // ════════════════════════════════════════════
    $('#btnAdd').on('click', function () {
        clearForm(false);
        $('#modalTitleText').text('Add Dispatch');
        $('#fDepartmentId').val(currentDeptId);
        $('#fDate').val(new Date().toISOString().split('T')[0]);
        dispModal.show();
    });

    // ════════════════════════════════════════════
    // EDIT — from allData
    // ════════════════════════════════════════════
    $(document).on('click', '.btn-edit', function () {
        const id = parseInt($(this).data('id'));
        const r  = allData.find(x => x.SrNo === id);
        if (!r) return;

        clearForm(true);
        $('#modalTitleText').text('Edit Dispatch');
        $('#fSrNo').val(r.SrNo);
        $('#fDepartmentId').val(r.DepartmentId);
        $('#fCustomerId').val(r.CustomerId).prop('disabled', true);
        $('#fItemDesc').val(r.Item_Description);

        // Populate item in disabled state
        $('#fItemId')
            .html(`<option value="${r.ItemId}">${r.Item_Code}</option>`)
            .val(r.ItemId)
            .prop('disabled', true);
            setTimeout(() => {
    applyItemSelect2();
}, 100);
        $('#fQuantity').val(r.Quantity);
        $('#fGRNStatus').val(r.GRN_Status || 'NO');
        $('#fDate').val(
            r.Add_Date ? r.Add_Date : '');

        dispModal.show();
    });

    // ════════════════════════════════════════════
    // SAVE — with dispatch vs production validation
    // ════════════════════════════════════════════
    $('#btnSave').on('click', function () {
        clearErrors();
        hideAlert();

        const deptId = parseInt($('#fDepartmentId').val()) || 0;
        const custId = parseInt($('#fCustomerId').val()) || 0;
        const itemId = parseInt($('#fItemId').val())     || 0;
        const qty    = parseInt($('#fQuantity').val())   || 0;
        const date   = $('#fDate').val();

        let valid = true;

        if (!deptId) {
    showError(
        'fDepartmentId',
        'err-department',
        'Department required.'
    );
    valid = false;
}
        if (!custId) {
            showError('fCustomerId','err-customer',
                'Customer required.'); valid = false;
        }
        if (!itemId) {
            showError('fItemId','err-item',
                'Item required.'); valid = false;
        }
        if (qty <= 0) {
            showError('fQuantity','err-qty',
                'Quantity must be > 0.'); valid = false;
        }
        if (!date) {
            showError('fDate','err-date',
                'Date required.'); valid = false;
        }
        if (!valid) return;

        // ── Business Rule: cannot dispatch more than production ──
        if (!isEditMode) {
            const newTotal = cachedDispatchQty + qty;
            if (cachedProduceQty > 0 && newTotal > cachedProduceQty) {
                showAlert(
                    `Dispatch Qty (${newTotal}) exceeds ` +
                    `Production Qty (${cachedProduceQty}). Cannot save.`,
                    'danger');
                return;
            }
        }

        const token =
            $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url:      '/CustomerDispatch/Save',
            method:   'POST',
            dataType: 'json',
            data: {
                SrNo:         $('#fSrNo').val(),
                CustomerId:   custId,
                ItemId:       itemId,
                Quantity:     qty,
                Date:         date,
                DepartmentId: deptId,
                GRN_Status:   $('#fGRNStatus').val(),
                __RequestVerificationToken: token
            },
            success: function (d) {
                if (!d.success) {
                    showToast(d.message || 'Save failed.', 'danger');
                    return;
                }
                dispModal.hide();
                showToast(d.message, 'success');
                // Reload with current filters
                const deptId  = parseInt($('#headerDeptFilter').val()) || 0;
                const monthId = parseInt($('#monthFilter').val())      || 0;
                loadData(deptId, monthId);
            },
            error: function () {
                showToast('Network error.', 'danger');
            }
        });
    });

    // ════════════════════════════════════════════
    // DELETE
    // ════════════════════════════════════════════
    $(document).on('click', '.btn-del', function () {
        pendingDeleteId = parseInt($(this).data('id'));
        $('#deleteLabel').text($(this).data('label'));
        deleteModal.show();
    });

    $('#btnConfirmDelete').on('click', function () {
        const token =
            $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url:      '/CustomerDispatch/Delete',
            method:   'POST',
            dataType: 'json',
            data: { srNo: pendingDeleteId,
                    __RequestVerificationToken: token },
            success: function (d) {
                deleteModal.hide();
                if (d.success) {
                    allData      = allData.filter(
                        r => r.SrNo !== pendingDeleteId);
                    filteredData = filteredData.filter(
                        r => r.SrNo !== pendingDeleteId);
                    renderTable();
                    showToast('Dispatch record deleted.', 'success');
                } else {
                    showToast('Delete failed.', 'danger');
                }
            },
            error: function () {
                showToast('Network error.', 'danger');
            }
        });
    });

    // ════════════════════════════════════════════
    // HELPERS
    // ════════════════════════════════════════════
    function clearForm(editMode) {
        isEditMode        = editMode;
        cachedProduceQty  = 0;
        cachedDispatchQty = 0;

        $('#fSrNo').val('0');
        $('#fCustomerId').val('0').prop('disabled', false);
       if ($('#fItemId').hasClass("select2-hidden-accessible")) {
    $('#fItemId').select2('destroy');
}

$('#fItemId')
    .html('<option value="0">-- Select Customer first --</option>')
    .prop('disabled', true);
        $('#fItemDesc,#fQuantity').val('');
        $('#fDate').val('');
        $('#fGRNStatus').val('NO');
        $('#valPanels').hide();
        resetPanels();
        clearErrors();
        hideAlert();
    }

    function resetPanels() {
        $('#vProduceQty,#vDispatchQty,#vAvailable').text('—');
        $('#pnlAvail')
            .removeClass('panel-avail-ok panel-avail-err')
            .addClass('panel-avail-ok');
    }

    function clearErrors() {
        $('.invalid-feedback.d-block').text('');
        $('#dispForm .form-control, #dispForm .form-select')
            .removeClass('is-invalid');
    }

    function showError(fieldId, errId, msg) {
        $('#' + fieldId).addClass('is-invalid');
        $('#' + errId).text(msg);
    }

    function showAlert(msg, type) {
        $('#alertMsg')
            .attr('class',
                `alert py-1 px-2 mb-0 small alert-${type}`)
            .html(`<i class="bi bi-exclamation-triangle me-1"></i>${msg}`)
            .show();
    }

    function hideAlert() {
        $('#alertMsg').hide().text('');
    }

    function showToast(msg, type) {
        toastEl.className =
            `toast align-items-center text-white border-0 bg-${type}`;
        $('#toastMsg').text(msg);
        bsToast.show();
    }
    function applyItemSelect2() {

    if ($('#fItemId').hasClass("select2-hidden-accessible")) {
        $('#fItemId').select2('destroy');
    }

    $('#fItemId').select2({
        dropdownParent: $('#dispModal'),
        width: '100%',
        placeholder: '-- Select Item --'

    });
}
});
</script>
}